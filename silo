def validate_name(name):
    if (not isinstance(name, str) or not name.strip() or name in (".", "..")
            or "/" in name or "\\" in name or any(ord(c) < 32 for c in name)):
        raise ValueError("Use a non-empty name without slashes or control characters")
    return name


def json_file(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}


def write_json(path, data, mode=0o600):
    tmp = Path(f"{path}.silo-tmp")
    tmp.touch(mode=mode)
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(path)


def jwt_claims(token):
    try:
        part = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)))
    except Exception:
        return {}


def _vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v)[:3])


def _epoch(iso):
    from datetime import datetime
    return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()


def get_json(url, headers):
    req = urllib.request.Request(url, headers={"User-Agent": f"silo/{VERSION}", **headers})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        if e.code == 429:
            wait = e.headers.get("Retry-After")
            raise RuntimeError(f"HTTP 429: rate limited, try again {f'in {wait}s' if wait else 'in a minute'}")
        raise RuntimeError("token expired; any run refreshes it" if e.code == 401 else f"HTTP {e.code}")
    except (OSError, ValueError) as e:
        raise RuntimeError(str(e))


def under(path, roots):
    path = Path(path)
    return any(path == r or r in path.parents for r in roots)


def alive(path):
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(0.3)
            s.connect(str(path))
            return True
    except OSError:
        return False



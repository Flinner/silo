def validate_name(name):
    if (not isinstance(name, str) or not name.strip() or name in (".", "..")
            or "/" in name or "\\" in name or any(ord(c) < 32 for c in name)):
        raise ValueError("Use a non-empty name without slashes or control characters")
    return name


class Configuration:
    """One schema for file loading, CLI edits, onboarding and the TUI."""
    @staticmethod
    def validate(raw):
        if not isinstance(raw, dict):
            raise ValueError("configuration must be a JSON object")
        for key, setting in SETTINGS.items():
            if key in raw:
                setting.validate(key, raw[key])
        return raw

    @staticmethod
    def parse(key, values):
        if key not in SETTINGS:
            raise ValueError(f"unknown setting: {key}")
        return SETTINGS[key].parse(key, values)

    @staticmethod
    def effective(raw, tool=None, name=None):
        cfg = {key: copy.deepcopy(raw.get(key, setting.default)) for key, setting in SETTINGS.items()}
        if tool is not None and name is not None:
            cfg.update(copy.deepcopy(raw.get("profile_settings", {}).get(f"{tool.bin}/{name}", {})))
        return cfg

    @staticmethod
    def validate_profile(overrides):
        if not isinstance(overrides, dict):
            raise ValueError("profile settings must be an object")
        for key, value in overrides.items():
            if key not in SETTINGS or SETTINGS[key].scope != "profile":
                raise ValueError(f"{key} is not a per-profile setting")
            SETTINGS[key].validate(key, value)

    @staticmethod
    def commit_profile(tool, name, base, draft):
        profile(tool, name)
        Configuration.validate_profile(draft)
        raw = read_cfg()
        profiles = copy.deepcopy(raw.get("profile_settings", {}))
        key = f"{tool.bin}/{name}"
        current = profiles.get(key, {})
        for field in (k for k in SETTINGS if SETTINGS[k].scope == "profile"):
            if base.get(field) != draft.get(field) or (field in base) != (field in draft):
                if current.get(field) != base.get(field) or (field in current) != (field in base):
                    raise ValueError(f"{field} changed elsewhere; reopen this profile's settings")
                if field in draft:
                    current[field] = draft[field]
                else:
                    current.pop(field, None)
        if current:
            profiles[key] = current
        else:
            profiles.pop(key, None)
        raw["profile_settings"] = profiles
        Configuration.save(raw)

    @staticmethod
    def save(raw):
        Configuration.validate(raw)
        # Preserve forward-compatible fields and never persist environment overrides.
        body = {**raw,
                "config_version": max((CONFIG_VERSION, raw.get("config_version", "0")), key=_vtuple),
                "silo_min_version": max((CONFIG_MIN_SILO, raw.get("silo_min_version", "0")), key=_vtuple)}
        ROOT.mkdir(parents=True, exist_ok=True)
        tmp = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", dir=ROOT, prefix=".config-", delete=False) as f:
                tmp = Path(f.name)
                json.dump(body, f, indent=2)
                f.write("\n")
            tmp.replace(CONFIG)
        finally:
            if tmp is not None:
                tmp.unlink(missing_ok=True)

    @staticmethod
    def selections(tool):
        cfg = Configuration.effective(read_cfg())
        return cfg["default_profiles"].get(tool.bin, "main"), cfg["default_logins"].get(tool.bin, "main")

    @staticmethod
    def launch(tool, profile_name=None, login=None):
        default_profile, default_login = Configuration.selections(tool)
        return validate_name(profile_name or default_profile), validate_name(login or default_login)

    @staticmethod
    def set_defaults(tool, profile_name, login):
        validate_name(profile_name)
        validate_name(login)
        raw = read_cfg()
        raw["default_tool"] = tool.bin
        raw["default_profiles"] = {**raw.get("default_profiles", {}), tool.bin: profile_name}
        raw["default_logins"] = {**raw.get("default_logins", {}), tool.bin: login}
        Configuration.save(raw)

    @staticmethod
    def commit(base, draft):
        current = read_cfg()
        changed = [key for key in SETTINGS if base.get(key) != draft.get(key) or (key in base) != (key in draft)]
        for key in changed:
            if current.get(key) != base.get(key) or (key in current) != (key in base):
                raise ValueError(f"{key} changed elsewhere; cancel and reopen Settings")
            if key in draft:
                current[key] = draft[key]
            else:
                current.pop(key, None)
        Configuration.save(current)


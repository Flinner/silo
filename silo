                       default="" if "main" in have else "main", words=have)
            if not name:
                out.print("    [dim]skipped[/]")
            elif not (ROOT / tool.bin / name).is_dir():
                create(tool, name, current=True)                  # a profile of the same name uses it
            elif name not in have or click.confirm(
                    f"    replace login '{name}' ({tool.email(LOGINS / tool.bin / name) or '?'}) with this one?",
                    default=False):
                import_login(tool, name)
                ok(f"{tool.bin} login [bold]{name}[/] is now the current login")

    out.rule("[bold]2. Filesystem[/]")
    out.print("  Your home is [bold]empty[/] in the sandbox (a scratch tmpfs).  The working directory and the\n"
              "  profile are always read-write; silo refuses to run from your home itself.")
    cfg["writable"] = path_list("  [bold]Extra read-write paths[/] (empty line ends):",
                                cfg["writable"], "keep writable", "add writable path:")
    cfg["readable"] = path_list("  [bold]Extra read-only paths[/] (empty line ends):",
                                cfg["readable"], "keep readable", "add read-only path:")
    cfg["path_dirs"] = click.confirm("  expose the PATH directories under your home (your installed tools), read-only?",
                                     default=cfg["path_dirs"])
    cfg["git_config"] = click.confirm("  expose ~/.gitconfig and ~/.config/git (name, email, aliases), read-only?",
                                      default=cfg["git_config"])

    out.rule("[bold]3. Brokered access[/]")
    out.print("  These run [bold]outside[/] the sandbox on the agent's behalf; keys and tokens never enter it.")
    sshdir = HOME / ".ssh"
    keys = sorted(f.name for f in sshdir.glob("*") if f.is_file() and f.suffix != ".pub"
                  and f.name not in ("config", "known_hosts", "known_hosts.old", "authorized_keys", "environment"))
    out.print("  [bold]ssh[/]: keys go into a private ssh-agent for this sandbox.  Keys found: "
              + (", ".join(f"[bold]{k}[/]" for k in keys) if keys else "[dim]none[/]"))
    while True:
        chosen = ask("  keys to load, separated by spaces (Tab completes; empty = no ssh):",
                     default=" ".join(cfg["ssh_keys"]), words=keys).split()
        missing = [k for k in chosen if not (sshdir / k).is_file()]
        if not missing:
            break
        err.print(f"    [yellow]not found in ~/.ssh: {', '.join(missing)}[/]")
    cfg["ssh_keys"] = key = list(dict.fromkeys(chosen))
    hosts_in_cfg = []
    if key and (sshdir / "config").exists():
        cfg["ssh_config"] = click.confirm("  use your ~/.ssh/config for those connections (aliases, ProxyJump)?",
                                          default=cfg["ssh_config"])
        if cfg["ssh_config"]:
            hosts_in_cfg = sorted({h for line in (sshdir / "config").read_text().splitlines()
                                   if line.strip().lower().startswith("host ")
                                   for h in line.split()[1:] if not any(c in h for c in "*?!")})
    else:
        cfg["ssh_config"] = False
    if key:
        out.print("  allowed destinations (Tab completes your config's hosts, globs ok; none = any host):")
        hosts = keep_list(cfg["ssh_hosts"], "keep")
        while h := ask("  allow host:", words=hosts_in_cfg):
            hosts.append(h)
        cfg["ssh_hosts"] = hosts
    else:
        cfg["ssh_hosts"] = []
    cfg["gpg"] = click.confirm("  [gpg] sign/decrypt through your gpg-agent (secret keys stay in the agent)?",
                               default=cfg["gpg"])
    if shutil.which("gh"):
        keep = click.confirm("  [gh] run allowlisted gh subcommands (pr, issue, run, ...) on the host?",
                             default=bool(cfg["brokered"].get("gh")))
        cfg["brokered"] = {**cfg["brokered"], "gh": cfg["brokered"].get("gh") or DEFAULTS["brokered"]["gh"]} \
            if keep else {k: v for k, v in cfg["brokered"].items() if k != "gh"}

    out.rule("[bold]4. Hidden paths[/]")
    cfg["hidden"] = path_list("  Masked even inside the paths above (every login and other profile always is).\n"
                              "  [bold]Hidden paths[/] (empty line ends):", cfg["hidden"], "keep hiding", "hide path:")

    out.rule("[bold]5. Resources[/]")
    out.print("  Applied to the sandbox and everything it starts, background agents included.")
    cfg["nice"] = number("  CPU nice, 0 (normal) to 19 (lowest):", cfg["nice"], 0, 19)
    cfg["ionice"] = choose("  IO priority", list(IONICE), cfg["ionice"])
    cfg["memory_max"] = ask("  memory limit, e.g. 8G or 50% (empty = none):", default=cfg["memory_max"])
    cfg["swap_max"] = ask("  swap limit, e.g. 0 or 2G (empty = none):", default=cfg["swap_max"]) \
        if cfg["memory_max"] else ""

    out.rule("[bold]6. Updates[/]")
    out.print("  silo can check GitHub for a new version, at most once a day, after commands like [cyan]ls[/].\n"
              "  [bold]ask[/] = print a hint   [bold]always[/] = install it   [bold]never[/] = stay offline")
    cfg["check_updates"] = choose("  automatic update checks", ["ask", "always", "never"], cfg["check_updates"])

    save_cfg(cfg)
    t = Table(box=None, show_header=False, padding=(0, 2))
    t.add_row("writable", ", ".join(cfg["writable"]) or "[dim]cwd + profile only[/]")
    t.add_row("readable", ", ".join(cfg["readable"] + (["PATH dirs"] if cfg["path_dirs"] else [])
                                    + (["git config"] if cfg["git_config"] else [])) or "[dim]-[/]")
    t.add_row("ssh", (f"{', '.join(cfg['ssh_keys'])} → " + (", ".join(cfg["ssh_hosts"]) or "[yellow]any host[/]"))
              if cfg["ssh_keys"] else "[dim]off[/]")
    t.add_row("gpg", "via agent" if cfg["gpg"] else "[dim]off[/]")
    t.add_row("gh", f"{len(cfg['brokered']['gh'])} subcommands" if cfg["brokered"].get("gh") else "[dim]off[/]")
    t.add_row("hidden", f"{len(cfg['hidden'])} paths + all logins")
    t.add_row("resources", f"nice {cfg['nice']}, io {cfg['ionice']}, memory {cfg['memory_max'] or 'unlimited'}"
                           + (f", swap {cfg['swap_max']}" if cfg["swap_max"] else ""))
    t.add_row("updates", cfg["check_updates"])
    out.print(Panel(t, title=f"saved  (config v{CONFIG_VERSION})", border_style="green"))
    ok(f"done - try [cyan]{Path(sys.argv[0]).name} ls -a[/]")


@cli.command(cls=Cmd, context_settings=dict(ignore_unknown_options=True, allow_extra_args=True), hidden=True)
@click.argument("name")
@click.argument("args", nargs=-1, type=click.UNPROCESSED)
@click.pass_obj
def run(tool, name, args):
    args, login = list(args), None
    if args[:1] == ["--login"] and len(args) > 1:
        login, args = args[1], args[2:]
    elif args[:1] and args[0].startswith("--login="):
        login, args = args[0].split("=", 1)[1], args[1:]
    if login and not (LOGINS / tool.bin / login).is_dir():
        die(f"no {tool.bin} login [bold]{login}[/]  (see [cyan]login ls[/] / [cyan]login add[/])")
    cmd = [os.environ.get("SHELL", "/bin/sh")] if args == ["--shell"] else [tool.bin, *args]
    argv = limits(load_cfg()) + sandbox(tool, name, login) + cmd
    os.execvp(argv[0], argv)


IONICE = {"idle": ["-c", "3"], "low": ["-c", "2", "-n", "7"], "normal": []}


def limits(cfg):
    """prefix argv: memory cap via a systemd user scope (covers every child, background agents
    included), then nice + ionice.  Missing pieces degrade with a warning, never block the run."""
    pre = []
    mem, swap = str(cfg["memory_max"]).strip(), str(cfg["swap_max"]).strip()
    if mem or swap:
        if shutil.which("systemd-run") and subprocess.run(
                ["systemd-run", "--user", "--scope", "--quiet", "true"], capture_output=True).returncode == 0:
            pre += ["systemd-run", "--user", "--scope", "--quiet", "--collect"]
            pre += ["-p", f"MemoryMax={mem}"] if mem else []
            pre += ["-p", f"MemorySwapMax={swap}"] if swap else []
        else:
            err.print("[yellow]![/] memory limit skipped: no systemd user session (systemd-run --user)")
    if int(cfg["nice"] or 0):
        pre += ["nice", "-n", str(int(cfg["nice"]))]
    if IONICE.get(cfg["ionice"]) and shutil.which("ionice"):
        pre += ["ionice", *IONICE[cfg["ionice"]]]
    return pre



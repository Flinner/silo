class LauncherSelection:
    """A profile (←/→) and a login (↑/↓); the selected login decides the agent."""
    def __init__(self, tool):
        self.h = HARNESSES[tool]
        self.profile, self.login = Config.defaults(self.h)
        self.shell, self.shells = None, available_shells()   # a selected shell runs in the sandbox instead of the agent
        self.bg, self.daemons = None, []      # a selected "tool/profile" row of the background section; Enter stops it
        self.reload()

    def reload(self):
        self.accounts = [(h.name, login.name) for h in HARNESSES.values() for login in Login.all(h)]
        if (self.h.name, self.login) not in self.accounts:
            preferred = (self.h.name, Config.defaults(self.h)[1])
            chosen = preferred if preferred in self.accounts else next(iter(self.accounts), None)
            if chosen:
                self.select_account(*chosen)
            else:
                self.login = None
        self.defaults = Config.defaults(self.h)
        self.profiles = Profile.names()
        if self.profile not in self.profiles:
            self.profile = self.defaults[0] if self.defaults[0] in self.profiles else next(iter(self.profiles), None)

    def select_account(self, tool, name):
        self.h, self.login = HARNESSES[tool], name      # the profile stays: names are shared by every tool

    def move_profile(self, direction):
        if self.profiles:
            self.profile = self.profiles[(self.profiles.index(self.profile) + direction) % len(self.profiles)]

    def move_login(self, direction):
        entries = self.accounts + [("shell", name) for name, _ in self.shells] + [("background", d) for d in self.daemons]
        current = ("background", self.bg) if self.bg else ("shell", self.shell) if self.shell else (self.h.name, self.login)
        if not entries:
            return
        index = entries.index(current) if current in entries else 0
        tool, name = entries[(index + direction) % len(entries)]
        self.bg = name if tool == "background" else None
        if tool == "shell":
            self.shell = name                 # keeps the agent's profile and login: the shell runs in that sandbox
        elif tool == "background":
            self.shell = None
        else:
            self.shell = None
            self.select_account(tool, name)
            self.reload()

    def shell_path(self):
        return dict(self.shells).get(self.shell)

    def save_defaults(self):
        if not self.profile or not self.login:
            raise ValueError("Select an existing profile and login first")
        Login(self.h, self.login).require()
        Config.set_defaults(self.h, self.profile, self.login)
        self.defaults = (self.profile, self.login)


def dir_size(path):
    total, stack = 0, [str(path)]
    while stack:
        try:
            with os.scandir(stack.pop()) as entries:
                for e in entries:
                    if e.is_dir(follow_symlinks=False):
                        stack.append(e.path)
                    elif e.is_file(follow_symlinks=False):
                        total += e.stat(follow_symlinks=False).st_size
        except OSError:
            pass
    return total


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024


class Survey:
    """Background look at the store: running sessions and daemons (every few seconds), profile sizes (slowly)."""
    def __init__(self):
        self.lock = threading.Lock()
        self.procs, self.sizes, self.rc = {}, {}, {}
        self.closed = threading.Event()
        threading.Thread(target=self.loop, name="silo-survey", daemon=True).start()

    def loop(self):
        sized = 0
        while not self.closed.is_set():
            procs = {h.name: h.processes() for h in HARNESSES.values()}
            remote = self.remote_sessions(procs)
            with self.lock:
                self.procs, self.rc = procs, remote
            if time.time() - sized > 120:
                sized = time.time()
                for h in HARNESSES.values():
                    for p in Profile.all(h):
                        if self.closed.is_set():
                            return
                        size = dir_size(p.path)
                        with self.lock:
                            self.sizes[(h.name, p.name)] = size
            self.closed.wait(3)

    @staticmethod
    def remote_sessions(procs):
        """{"tool/profile": [(pid, login or None, session status)]} of the live sessions under remote control (/rc),
        from the status file each session keeps in <config>/sessions/<pid>.json.  Read straight from the
        profiles, since a background worker's environment (and so its profile) is often unreadable."""
        found = {}
        for tool, ps in procs.items():
            h, logins = HARNESSES[tool], {pid: login for pid, _, login, _ in ps}
            for key, d in [(f"{tool}/{p.name}", p.path) for p in Profile.all(h)] + [(f"{tool}/", h.home)]:
                for f in (Path(d) / "sessions").glob("*.json"):
                    try:
                        info = json.loads(f.read_text())
                        alive = Path(f"/proc/{info['pid']}/stat").read_text().rsplit(")", 1)[1].split()[19] == info.get("procStart")
                    except (OSError, ValueError, KeyError, IndexError):
                        continue
                    if alive and info.get("bridgeSessionId"):
                        found.setdefault(key, []).append((info["pid"], logins.get(info["pid"]), info))
        return found

    def remote(self, key):
        with self.lock:
            return self.rc.get(key, [])

    def profile(self, h, name):
        """(sessions [(pid, login)], daemons [(pid, login)], size or None)."""
        path = str(ROOT / h.name / name)
        with self.lock:
            procs = [p for p in self.procs.get(h.name, ()) if p[1] == path]
            size = self.sizes.get((h.name, name))
        return ([(pid, login) for pid, _, login, kind in procs if kind == "session"],
                [(pid, login) for pid, _, login, kind in procs if kind == "daemon"], size)

    def daemons(self):
        """{"tool/profile": [(pid, login, kind)]} of every profile with background processes, across tools;
        "tool/" holds everything of that tool running outside silo, interactive sessions too."""
        found = {}
        with self.lock:
            for tool, procs in self.procs.items():
                for pid, path, login, kind in procs:
                    if path is None or kind != "session":
                        found.setdefault(f"{tool}/{Path(path).name if path else ''}", []).append((pid, login, kind))
        return dict(sorted(found.items()))

    def busy(self, h, name):
        return any(self.profile(h, name)[:2])

    def close(self):
        self.closed.set()


class TerminalUI:
    def __init__(self, screen, tool):
        self.screen, self.h = screen, HARNESSES[tool]
        self.message = ""
        self.survey = None
        self.show_keys = False

    def put(self, row, text, attr=0):
        height, width = self.screen.getmaxyx()
        if 0 <= row < height - 1 and width > 3:
            try:
                self.screen.addnstr(row, 2, str(text).replace("\n", " "), width - 4, attr)
            except curses.error:
                pass

    def at(self, row, column, text, width, attr=0):
        height, columns = self.screen.getmaxyx()
        if 0 <= row < height and 0 <= column < columns and width > 0:
            try:
                safe = "".join(c for c in str(text) if c.isprintable())
                self.screen.addnstr(row, column, safe, min(width, columns - column), attr)
            except curses.error:
                pass

    def frame(self, title=""):
        """the rounded border every screen shares."""
        self.screen.erase()
        height, width = self.screen.getmaxyx()
        accent = self.color(1)
        head = "╭─ silo " + (f"· {title} " if title else "")
        self.at(0, 0, head + "─" * max(0, width - len(head) - 1) + "╮", width, accent)
        for y in range(1, height - 1):
            self.at(y, 0, "│", 1, accent)
            self.at(y, width - 1, "│", 1, accent)
        self.at(height - 1, 0, "╰" + "─" * max(0, width - 2) + "╯", width, accent)

    def menu(self, title, items, detail="", actions=None, initial=0):
        actions = actions or {}
        selected = min(initial, max(0, len(items) - 1))
        while True:
            self.frame(title)
            height, width = self.screen.getmaxyx()
            self.put(2, detail, curses.A_DIM)
            visible = max(1, height - 9)
            start = max(0, min(selected - visible + 1, max(0, len(items) - visible)))
            if not items:
                self.put(4, "Nothing here yet. Press n to create one.", curses.A_DIM)
            for row, index in enumerate(range(start, min(start + visible, len(items))), 4):
                self.put(row, ("› " if index == selected else "  ") + items[index],
                         curses.A_BOLD | self.color(1) if index == selected else 0)
            self.put(height - 3, self.message, self.color(3))
            self.put(height - 2, "  ".join(["↑↓ select  ⏎ open", *(f"{key} {label}" for key, label in actions.items()), "esc back"]),
                     curses.A_DIM)
            self.screen.refresh()
            key = self.screen.get_wch()
            if key in ("\x1b", "\x03"):
                return None
            if isinstance(key, str) and key in actions:
                self.message = ""
                return key
            if key in (curses.KEY_DOWN, "j") and items:
                selected = (selected + 1) % len(items)
            elif key in (curses.KEY_UP, "k") and items:
                selected = (selected - 1) % len(items)
            elif key == curses.KEY_NPAGE and items:
                selected = min(len(items) - 1, selected + visible)
            elif key == curses.KEY_PPAGE and items:
                selected = max(0, selected - visible)
            elif key in ("\n", "\r", curses.KEY_ENTER) and items:
                self.message = ""
                return selected

    def prompt(self, title, value="", detail=""):
        """A small editable field; Esc cancels without changing the value."""
        text, cursor = str(value), len(str(value))
        try:
            curses.curs_set(1)
            while True:
                self.frame(title)
                height, width = self.screen.getmaxyx()
                self.put(2, detail, curses.A_DIM)
                span = max(1, width - 5)
                offset = max(0, cursor - span + 1)
                self.put(4, text[offset:offset + span], curses.A_REVERSE)
                self.put(height - 2, "⏎ accept  esc cancel  ctrl-u clear", curses.A_DIM)
                if height > 5 and width > 5:
                    self.screen.move(4, min(width - 2, 2 + cursor - offset))
                self.screen.refresh()
                key = self.screen.get_wch()
                if key in ("\x1b", "\x03"):
                    return None
                if key in ("\n", "\r", curses.KEY_ENTER):
                    return text
                if key in (curses.KEY_BACKSPACE, "\x7f", "\b") and cursor:
                    text, cursor = text[:cursor - 1] + text[cursor:], cursor - 1
                elif key == curses.KEY_DC:
                    text = text[:cursor] + text[cursor + 1:]
                elif key == curses.KEY_LEFT:
                    cursor = max(0, cursor - 1)
                elif key == curses.KEY_RIGHT:
                    cursor = min(len(text), cursor + 1)
                elif key in (curses.KEY_HOME, "\x01"):
                    cursor = 0
                elif key in (curses.KEY_END, "\x05"):
                    cursor = len(text)
                elif key == "\x15":
                    text, cursor = "", 0
                elif isinstance(key, str) and key.isprintable():
                    text, cursor = text[:cursor] + key + text[cursor:], cursor + len(key)
        finally:
            curses.curs_set(0)

    def confirm(self, title, detail=""):
        return self.menu(title, ["Cancel", "Confirm"], detail) == 1

    def attempt(self, fn, *args):
        """run an op; its message (or error) goes to the status line."""
        try:
            result = fn(*args)
            if isinstance(result, str):
                self.message = self.plain(result)
            return True, result
        except (ValueError, OSError, click.ClickException) as e:
            self.message = str(e)
            return False, None

    def terminal(self, fn, *args):
        """Hand off the terminal and return automatically when the command exits."""
        curses.def_prog_mode()
        curses.endwin()
        result = None
        self.message = ""
        try:
            try:
                result = fn(*args)
                if isinstance(result, int) and result:
                    self.message = f"Exited with status {result}"
            except (ValueError, OSError, click.ClickException) as e:
                self.message = str(e)
            except KeyboardInterrupt:
                self.message = "Interrupted"
            except SystemExit as e:
                if e.code:
                    self.message = f"Exited with status {e.code}"
        finally:
            curses.reset_prog_mode()
            self.screen.clear()
            self.screen.refresh()
        return result

    def new_login(self, h):
        name = self.prompt(f"{h.name} / New login name")
        if name is None or not self.attempt(validate_name, name)[0]:
            return None
        if Login(h, name).exists():
            self.message = f"Login {name} already exists; select it to authenticate"
            return None
        found = (h.native_login_home() / h.cred).is_file()
        choices = (["Copy this machine's existing account"] if found else []) + ["Authenticate a new account", "Create empty login"]
        selected = self.menu("Create login", choices,
                             f"Existing account found in {h.native_login_home()}" if found else "No native account found")
        if selected is None:
            return None
        choice = choices[selected]
        if not self.attempt(ops.login_add, h, name, choice.startswith("Copy"))[0]:
            return None
        if choice.startswith("Authenticate"):
            self.authenticate(h, name)
        return name

    def authenticate(self, h, name):
        rc = self.terminal(ops.authenticate, h, name)
        if rc == 0 and Login(h, name).logged_in():
            self.message = "Authenticated"
        elif not self.message:
            self.message = "Authentication did not finish; retry from Manage"

    def new_profile(self):
        h = self.h
        name = self.prompt(f"{h.name} / New profile name", detail="Conversation history; accounts are selected independently")
        if name is None or not self.attempt(ops.new, h, name)[0]:
            return None
        if h.history_entries(h.native_home()) and self.confirm(
                f"Copy existing conversations into {name}?", f"Found in {h.native_home()}. Originals are kept."):
            self.attempt(ops.import_history, h, name)
        if (h.native_login_home() / h.cred).is_file() and self.confirm(
                "Also copy your existing account?", "The account stays separate from this history profile"):
            self.new_login(h)
        if self.confirm("Configure this profile's sandbox?", "Writable/read-only paths, hidden paths, SSH, GPG and resource limits"):
            self.settings(h, name)
        self.message = f"Created profile {name}"
        return name

    def rename_profile(self, h, name):
        if Profile(h, name).daemon_logins() and not self.stop_daemon(h, name):
            self.message = self.message or "Renaming needs the background daemon stopped"
            return name
        new_name = self.prompt("Rename profile", name)
        if new_name is None or new_name == name:
            return name
        return new_name if self.attempt(ops.rename, h, name, new_name)[0] else name

    # ---- setup wizard: import what this machine has, set the sandbox defaults, apply ----
    SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def setup(self):
        """first run (and o): 1 import accounts + histories, 2 sandbox defaults, 3 review and apply."""
        items = self.setup_found()
        while True:
            step = self.setup_import(items)
            if step is None:
                Config.update(lambda raw: raw.update(onboarding_complete=True, seen_version=VERSION))
                self.message = "Setup skipped · o reopens it"
                return
            self.settings(wizard=True)
            step = self.setup_review(items)
            if step == "back":
                continue
            if step is None:
                return
            self.setup_apply([i for i in items if i["on"]])
            return

    def setup_found(self):
        """what each harness has on this machine, sized in the background."""
        items = []
        for h in HARNESSES.values():
            if (h.native_login_home() / h.cred).is_file():
                items.append(dict(h=h, kind="account", on=True, target="main", info=h.native_account() or "account"))
            if entries := h.history_entries(h.native_home()):
                items.append(dict(h=h, kind="history", on=True, target="main", size=None, entries=entries,
                                  info=", ".join(e.name for e in entries)))
            if not any(i["h"] is h for i in items):
                items.append(dict(h=h, kind="none", on=False, target="", info=""))

        def size(item):
            item["size"] = sum(dir_size(e) if e.is_dir() else e.stat().st_size for e in item["entries"])
        for item in items:
            if item["kind"] == "history":
                threading.Thread(target=size, args=(item,), daemon=True).start()
        return items

    def setup_note(self, item):
        """why an item may not do what it says, or ''."""
        h, target = item["h"], item["target"]
        if item["kind"] == "account" and Login(h, target).exists():
            return f"login {target} exists · its credentials are replaced"
        if item["kind"] == "history" and Profile(h, target).exists():
            if clash := [e.name for e in item["entries"] if (Profile(h, target).path / e.name).exists()]:
                return f"profile {target} already has {', '.join(clash)} · pick another name"
            return f"into the existing profile {target}"
        return ""

    def setup_import(self, items):
        selectable = [i for i, item in enumerate(items) if item["kind"] != "none"]
        selected = 0
        self.screen.timeout(300)       # history sizes arrive in the background
        try:
            while True:
                self.frame("setup 1/3 · import")
                height, width = self.screen.getmaxyx()
                accent, dim, bold = self.color(1), curses.A_DIM, curses.A_BOLD
                self.at(1, 2, "Found on this machine. Imports are copies: the originals stay untouched and keep working.", width - 4, dim)
                y, last = 3, None
                for i, item in enumerate(items):
                    h = item["h"]
                    if h is not last:
                        y += last is not None
                        self.at(y, 2, f"{h.name.upper():8} {h.native_home()}".replace(str(HOME), "~"), width - 4, bold | dim)
                        y, last = y + 1, h
                    if item["kind"] == "none":
                        self.at(y, 4, "nothing to import · a in the launcher adds a login", width - 6, dim)
                        y += 1
                        continue
                    chosen = selectable and i == selectable[selected]
                    box = "[x]" if item["on"] else "[ ]"
                    if item["kind"] == "account":
                        what, arrow = f"account  {item['info']}", "login"
                    else:
                        what = "history  " + (human(item["size"]) if item["size"] is not None else "sizing…") + f" · {item['info']}"
                        arrow = "profile"
                    self.at(y, 2, ("› " if chosen else "  ") + box, 6, bold | accent if chosen else (accent if item["on"] else dim))
                    self.at(y, 9, what, width - 40, 0 if item["on"] else dim)
                    self.at(y, width - 30, f"→ {arrow:7} {item['target']}", 27, bold if item["on"] else dim)
                    if note := self.setup_note(item):
                        y += 1
                        self.at(y, 9, note, width - 12, self.color(3) if "pick another" in note else dim)
                    y += 1
                self.put(height - 3, self.message, self.color(3))
                self.at(height - 2, 2, "↑↓ select  ␣ toggle  ⏎ rename target  → next  esc skip setup", width - 4, dim)
                self.screen.refresh()
                try:
                    key = self.screen.get_wch()
                except curses.error:
                    continue
                if key in ("\x1b", "\x03", "q"):
                    return None
                if not selectable:
                    if key in (curses.KEY_RIGHT, "\t", "n", "\n", "\r", curses.KEY_ENTER):
                        return "next"
                    continue
                item = items[selectable[selected]]
                if key in (curses.KEY_DOWN, "j"):
                    selected = (selected + 1) % len(selectable)
                elif key in (curses.KEY_UP, "k"):
                    selected = (selected - 1) % len(selectable)
                elif key == " ":
                    item["on"] = not item["on"]
                elif key in ("\n", "\r", curses.KEY_ENTER):
                    name = self.prompt(f"{'Login' if item['kind'] == 'account' else 'Profile'} name for {item['h'].name}",
                                       item["target"])
                    if name and self.attempt(validate_name, name)[0]:
                        item["target"] = name
                elif key in (curses.KEY_RIGHT, "\t", "n"):
                    blocked = [i for i in items if i["on"] and "pick another" in self.setup_note(i)]
                    if blocked:
                        self.message = f"{blocked[0]['h'].name} history: pick another profile name or untick it"
                    else:
                        return "next"
        finally:
            self.screen.timeout(-1)

    def setup_plan(self, items):
        """the steps applying ITEMS takes, in order: logins before histories."""
        steps = []
        for item in sorted((i for i in items if i["on"]), key=lambda i: i["kind"] != "account"):
            h, t = item["h"], item["target"]
            if item["kind"] == "account":
                steps.append((f"{h.name} login {t} ← your {h.name} account", ops.login_add, (h, t, True), None))
            else:
                if not Profile(h, t).exists():
                    steps.append((f"{h.name} profile {t}", ops.new, (h, t), None))
                steps.append((f"{h.name} history → profile {t} ({human(item['size']) if item['size'] else '…'})",
                              ops.import_history, (h, t), item.get("size")))
        return steps

    def setup_review(self, items):
        steps = self.setup_plan(items)
        lines = [label for label, *_ in steps] or ["Nothing to import · only the sandbox defaults were saved"]
        action = self.menu("setup 3/3 · review", lines, "This is what happens next. Copies run one after another.",
                           {"a": "apply", "b": "back"})
        return "back" if action in (None, "b") else "apply"

    def setup_apply(self, items):
        steps = self.setup_plan(items)
        state = [["pending", ""] for _ in steps]

        def work():
            for i, (_, fn, args, _) in enumerate(steps):
                state[i][0] = "running"
                try:
                    fn(*args)
                    state[i][0] = "done"
                except Exception as e:
                    state[i] = ["failed", str(e)]
        worker = threading.Thread(target=work, daemon=True)
        worker.start()
        staged, sized = 0, 0
        self.screen.timeout(150)
        try:
            tick = 0
            while True:
                tick += 1
                if time.time() - sized > 1:                # what the running copy has written so far
                    staged, sized = dir_size(ROOT / ".staging"), time.time()
                self.frame("setup · applying")
                height, width = self.screen.getmaxyx()
                for y, ((label, _, _, total), (status, why)) in enumerate(zip(steps, state), 3):
                    glyph, attr = {"pending": ("·", curses.A_DIM), "done": ("✓", self.color(2)),
                                   "failed": ("✗", self.color(4))}.get(status, (self.SPIN[tick % len(self.SPIN)], self.color(1)))
                    self.at(y, 3, glyph, 1, attr | curses.A_BOLD)
                    text = label + (f"  {min(99, staged * 100 // total)}%" if status == "running" and total else "")
                    self.at(y, 5, text + (f" · {why}" if why else ""), width - 8, self.color(4) if why else 0)
                done = not worker.is_alive()
                self.at(1, 2, "All done." if done else "Copying… you can leave this open; the originals are untouched.",
                        width - 4, curses.A_DIM)
                self.at(height - 2, 2, "⏎ open the launcher" if done else "working…", width - 4, curses.A_DIM)
                self.screen.refresh()
                try:
                    key = self.screen.get_wch()
                except curses.error:
                    continue
                if done and key in ("\n", "\r", curses.KEY_ENTER, "\x1b", "q"):
                    break
        finally:
            self.screen.timeout(-1)
        # each harness defaults to what was just imported
        for h in HARNESSES.values():
            mine = {i["kind"]: i["target"] for i in items if i["h"] is h}
            profile, login = mine.get("history"), mine.get("account")
            if profile or login:
                current = Config.defaults(h)
                if Profile(h, profile or current[0]).exists():
                    self.attempt(Config.set_defaults, h, profile or current[0], login or current[1])
        Config.update(lambda raw: raw.update(onboarding_complete=True, seen_version=VERSION))
        failed = sum(1 for status, _ in state if status == "failed")
        self.message = f"Setup finished with {failed} problem{'s' * (failed != 1)}" if failed else "Setup finished"

    def whats_new(self, news, new):
        """release notes and new settings since the user last looked; shown once."""
        lines = []
        for n in news:
            lines += [("head", f"{n['version']} · {n['date']}")] + [("note", note) for note in n["notes"]] + [("gap", "")]
        if new:
            lines.append(("head", "new settings · on their defaults until you change them"))
            for k in new:
                lines += [("setting", k), ("desc", SETTINGS[k].description), ("gap", "")]
        top = 0
        while True:
            self.frame(f"what's new in {VERSION}")
            height, width = self.screen.getmaxyx()
            room = height - 5
            for y, (kind, text) in enumerate(lines[top:top + room], 2):
                if kind == "head":
                    self.at(y, 2, text, width - 4, curses.A_BOLD | self.color(1))
                elif kind == "note":
                    self.at(y, 4, "· " + text, width - 7, 0)
                elif kind == "setting":
                    value = self.brief_value(DEFAULTS[text])
                    self.at(y, 4, text, 20, curses.A_BOLD)
                    self.at(y, 25, value, width - 28, curses.A_DIM)
                elif kind == "desc":
                    self.at(y, 6, text, width - 9, curses.A_DIM)
            more = "↑↓ scroll  " if len(lines) > room else ""
            self.at(height - 2, 2, more + ("s review settings  " if new else "") + "⏎ continue", width - 4, curses.A_DIM)
            self.screen.refresh()
            key = self.screen.get_wch()
            if key in (curses.KEY_DOWN, "j") and top + room < len(lines):
                top += 1
            elif key in (curses.KEY_UP, "k") and top:
                top -= 1
            elif key == "s" and new:
                self.settings()
                break
            elif key in ("\n", "\r", curses.KEY_ENTER, "\x1b", "q", " "):
                break
        self.attempt(Config.mark_seen)

    def checklist(self, title, options, chosen, detail=""):
        """pick any of OPTIONS (⏎ toggles, s accepts); returns the picked ones, or None on esc."""
        picked, selected = [o for o in chosen if o in options] + [c for c in chosen if c not in options], 0
        while True:
            items = [("[x] " if o in picked else "[ ] ") + o for o in options]
            action = self.menu(title, items or ["(none found)"], detail, {"a": "type a name", "s": "accept"}, selected)
            if action is None:
                return None
            if action == "s":
                return picked
            if action == "a":
                if (name := self.prompt("Key name")) and name not in picked:
                    picked.append(name)
                    options = options + [name] if name not in options else options
            elif isinstance(action, int) and options:
                selected, o = action, options[action]
                picked = [p for p in picked if p != o] if o in picked else picked + [o]

    def stop_daemon(self, h, name):
        """stop the profile's background daemon, after saying what is still running on it."""
        p = Profile(h, name)
        daemons = p.daemon_logins()
        sessions, procs, _ = self.survey.profile(h, name) if self.survey else ((), (), None)
        if not daemons and not procs:
            self.message = f"No daemon is running on {name}"
            return False
        pids = ", ".join(str(pid) for pid, _ in procs)
        detail = ((f"Daemon under {', '.join(daemons)}" if daemons else "Leftover background processes")
                  + (f" (pid {pids})" if pids else "") + ". Its background agents and their commands are killed too. "
                  + (f"{len(sessions)} session{'s' * (len(sessions) != 1)} still open on this profile "
                     f"({', '.join(sorted({l or '?' for _, l in sessions}))}); they lose their background agents."
                     if sessions else "No sessions are open on this profile."))
        if not self.confirm(f"Stop the background daemon of {name}?", detail):
            return False
        self.terminal(ops.stop_daemons, p)
        left = p.daemon_logins() or [pid for pid, prof, _, kind in h.processes() if kind == "daemon" and prof == str(p.path)]
        self.message = f"The daemon of {name} is still running" if left else f"Daemon of {name} stopped"
        return not left

    def stop_outside(self, h, procs):
        """stop the daemon of a tool running outside silo (not its interactive sessions)."""
        pids = [pid for pid, _, kind in procs if kind == "daemon"]
        if not pids:
            self.message = f"No {h.name} daemon is running outside silo"
            return
        if self.confirm(f"Stop the {h.name} daemon running outside silo?",
                        f"pid {', '.join(map(str, pids))}. Its background agents and their commands are killed; "
                        "interactive sessions keep running."):
            ops.kill_tree(pids)
            self.message = f"{h.name} daemon outside silo stopped"

    def profile_menu(self, h, name):
        while True:
            items = ["Rename profile", "Delete profile"]
            action = self.menu(f"{h.name} / Profile {name}", items + ["Back"],
                               "Conversation history; account selection is independent")
            if action is None or action == len(items):
                return name
            if items[action] == "Rename profile":
                name = self.rename_profile(h, name)
            elif self.confirm(f"Delete profile {name}?", f"Its history in {', '.join(p.h.name for p in ops.parts(name))} is deleted. "
                              "Logins are kept. Background daemons are stopped first."):
                self.terminal(ops.rm, h, name)
                if not Profile(h, name).exists():
                    return None

    def rename_login(self, h, name):
        new_name = self.prompt("Rename login", name, "Open sessions keep running; new launches use the new name")
        if new_name is None or new_name == name:
            return name
        return new_name if self.attempt(ops.login_rename, h, name, new_name)[0] else name

    def login_menu(self, h, name, usage):
        """returns the login's name afterwards (None when deleted)."""
        while True:
            selected = self.menu(f"{h.name} / Login {name}", ["Authenticate", "Usage details", "Rename login", "Delete login", "Back"])
            if selected in (None, 4):
                return name
            if selected == 2:
                name = self.rename_login(h, name)
            elif selected == 0:
                self.authenticate(h, name)
                usage.request(h, name, force=True)
            elif selected == 1:
                s = usage.snapshot(h, name)
                lines = [f"{r.label}: {r.percent:.0f}% · resets in {self.plain(_until(r.reset))}" for r in s.rows]
                self.menu("Usage · " + name, lines or ["Loading…" if s.loading else s.error or "No limits reported"],
                          self.plain(s.plan))
            elif selected == 3 and self.confirm(f"Delete login {name}?", "The account is removed. Conversation histories are kept."):
                if self.attempt(ops.login_rm, h, name)[0]:
                    return None

    def edit_list(self, title, value):
        draft = list(value)
        while True:
            action = self.menu(title, draft, "One item per entry; paths may contain spaces", {"a": "add", "d": "delete", "s": "accept"})
            if action is None:
                return None
            if action == "s":
                return draft
            if action == "a":
                if item := self.prompt("Add item"):
                    draft.append(item)
            elif action == "d" and draft:
                # Pick explicitly, avoiding deletion of an unseen cursor selection.
                index = self.menu("Delete which item?", draft)
                if index is not None:
                    draft.pop(index)
            elif isinstance(action, int):
                item = self.prompt("Edit item", draft[action])
                if item is not None:
                    draft[action] = item

    def edit_table(self, key, value):
        draft = copy.deepcopy(value)
        while True:
            keys = sorted(draft)
            entry = lambda v: f"{len(v)} allowed · {', '.join(v)}" if isinstance(v, list) else str(v)
            action = self.menu(key, [f"{name:14} {entry(draft[name])}" for name in keys], SETTINGS[key].description,
                               {"a": "add", "d": "delete", "s": "accept"})
            if action is None:
                return None
            if action == "s":
                return draft
            if action == "d" and keys:
                index = self.menu("Delete which entry?", keys)
                if index is not None:
                    del draft[keys[index]]
                continue
            if action == "a":
                name = self.prompt("New entry", detail="tool/profile" if key == "logins" else "Tool name: claude or codex"
                                   if key.startswith("default_") else "Command name, for example gh")
                if not name:
                    continue
                if name in draft:
                    self.message = "That entry already exists; select it to edit"
                    continue
                old = [] if key == "brokered" else ""
            elif isinstance(action, int):
                name, old = keys[action], draft[keys[action]]
            else:
                continue
            new = self.edit_list(name, old) if key == "brokered" else self.prompt("Value for " + name, old)
            if new is not None:
                candidate = {**draft, name: new}
                if self.attempt(Config.check, key, candidate)[0]:
                    draft = candidate

    @staticmethod
    def display(value):
        if isinstance(value, bool):
            return "yes" if value else "no"
        if isinstance(value, (dict, list)):
            return json.dumps(value, ensure_ascii=False)
        return str(value) or "(none)"

    def edit_setting(self, key, value):
        s = SETTINGS[key]
        if key == "ssh_keys":
            try:
                names = sorted(p.name for p in (HOME / ".ssh").iterdir()
                               if p.is_file() and not p.name.endswith(".pub") and p.with_name(p.name + ".pub").exists())
            except OSError:
                names = []
            picked = self.checklist("ssh_keys", names, value, "Keys in ~/.ssh that have a .pub beside them (only their names are read)")
            return None if picked is None else Config.parse(key, picked)
        if isinstance(s.default, bool) or s.choices:
            choices = list(s.choices) if s.choices else [False, True]
            action = self.menu(key, [self.display(v) for v in choices], s.description, initial=choices.index(value))
            return None if action is None else choices[action]
        if isinstance(s.default, list):
            new = self.edit_list(key, value)
            return None if new is None else Config.parse(key, new)
        if isinstance(s.default, dict):
            return self.edit_table(key, value)
        text = self.prompt(key, value, s.description)
        return None if text is None else Config.parse(key, [text])

    GROUPS = (("Files", ("writable", "readable", "hidden", "path_dirs", "git_config")),
              ("Brokered access", ("ssh_keys", "ssh_config", "ssh_hosts", "gpg", "brokered")),
              ("Resources", ("nice", "ionice", "memory_max", "swap_max")),
              ("silo", ("check_updates", "default_tool", "default_profiles", "default_logins", "logins", "onboarding_complete")))

    @staticmethod
    def brief_value(value):
        if isinstance(value, bool):
            return "yes" if value else "no"
        if isinstance(value, dict):
            return ", ".join(f"{k} ({len(v)})" if isinstance(v, list) else f"{k} → {v}" for k, v in value.items()) or "(none)"
        if isinstance(value, list):
            return ", ".join(value) or "(none)"
        return str(value) or "(none)"

    def settings(self, h=None, name=None, wizard=False):
        """grouped settings in the launcher's frame; edits stay a draft until s saves them."""
        global_raw = Config.read()
        scoped = h is not None and name is not None
        base = copy.deepcopy(global_raw.get("profile_settings", {}).get(name, {})) if scoped else global_raw
        draft = copy.deepcopy(base)
        groups = [(title, [k for k in keys if not scoped or SETTINGS[k].scope == "profile"]) for title, keys in self.GROUPS]
        groups = [(title, keys) for title, keys in groups if keys]
        keys = [k for _, ks in groups for k in ks]
        selected = 0
        while True:
            inherited = Config.effective(global_raw)
            effective = {**(inherited if scoped else Config.effective(draft)), **draft}   # the draft holds every override
            changed = [k for k in keys if draft.get(k) != base.get(k) or (k in draft) != (k in base)]
            key = self.draw_settings("setup 2/3 · sandbox defaults" if wizard else f"{name} · sandbox" if scoped
                                     else "global defaults", groups, keys[selected], effective, inherited, draft, changed, scoped, wizard)
            if wizard and key in (curses.KEY_RIGHT, "\t", "n"):
                key = "s"
            if key in ("\x1b", "\x03", "q"):
                if not changed or self.confirm("Discard unsaved settings?", f"{len(changed)} unsaved: {', '.join(changed)}"):
                    return
            elif key in (curses.KEY_DOWN, "j"):
                selected = (selected + 1) % len(keys)
            elif key in (curses.KEY_UP, "k"):
                selected = (selected - 1) % len(keys)
            elif key == "s":
                saved, _ = self.attempt(Config.commit_profile, h, name, base, draft) if scoped else self.attempt(Config.commit, base, draft)
                if saved:
                    self.message = "Settings saved"
                    return
            elif key == "g" and scoped:
                self.settings()
                global_raw = Config.read()
            elif key == "r":
                draft.pop(keys[selected], None)
            elif key == "R":
                if self.confirm("Reset all settings?", "Drops this profile's overrides. Save to apply." if scoped
                                else "Back to silo's defaults. Save to apply."):
                    for k in keys:
                        draft.pop(k, None)
            elif key in ("\n", "\r", curses.KEY_ENTER):
                success, new = self.attempt(self.edit_setting, keys[selected], effective[keys[selected]])
                if success and new is not None:
                    draft[keys[selected]] = new

    def draw_settings(self, title, groups, current, effective, inherited, draft, changed, scoped, wizard=False):
        self.frame(title)
        height, width = self.screen.getmaxyx()
        accent, dim, bold = self.color(1), curses.A_DIM, curses.A_BOLD
        inner = width - 4
        self.at(1, 2, "applies to this profile (every tool in it); the rest comes from the global defaults" if scoped
                else "every profile inherits these unless it overrides them · change them later with s", inner, dim)
        lines = []
        for title_, ks in groups:
            lines += [None, ("head", title_)] + [("key", k) for k in ks]
        lines = lines[1:]
        top, bottom = 3, height - 8
        visible = bottom - top
        index = lines.index(("key", current))
        start = max(0, min(index - visible + 2, len(lines) - visible))
        value_x = 24
        tag_width = 14
        for y, line in enumerate(lines[start:start + visible], top):
            if line is None:
                continue
            kind, text = line
            if kind == "head":
                self.at(y, 2, text.upper(), inner, bold | dim)
                continue
            chosen = text == current
            self.at(y, 2, ("› " if chosen else "  ") + text, value_x - 3, bold | accent if chosen else 0)
            if text in changed:
                self.at(y, value_x - 2, "●", 1, self.color(3))
            value, room = self.brief_value(effective[text]), inner - value_x - tag_width
            value = value if len(value) <= room else value[:room - 1] + "…"
            self.at(y, value_x, value, room, 0 if text in draft or not scoped else dim)
            tag = ("this profile" if text in draft else "global") if scoped else ("set" if text in draft else "default")
            self.at(y, width - 2 - tag_width, f"{tag:>{tag_width}}", tag_width, accent if text in draft else dim)

        # what the selected setting is, and where its value comes from
        y = height - 7
        self.at(y, 2, "─" * inner, inner, dim)
        self.at(y + 1, 2, current, inner, bold)
        self.at(y + 2, 2, SETTINGS[current].description, inner, 0)
        if scoped:
            origin = (f"overrides the global value: {self.brief_value(inherited[current])}" if current in draft
                      else "inherited from the global defaults · ⏎ overrides it here")
        else:
            origin = "" if current in draft else f"silo's default · ⏎ changes it"
        self.at(y + 3, 2, origin, inner, dim)
        self.put(height - 3, self.message or (f"● {len(changed)} unsaved · s saves" if changed else ""), self.color(3))
        keys = ("↑↓ select  ⏎ edit  r reset  → next (saves)  esc next without saving" if wizard else
                "↑↓ select  ⏎ edit  r reset  R reset all  s save" + ("  g global" if scoped else "") + "  esc back")
        self.at(height - 2, 2, keys, inner, dim)
        self.screen.refresh()
        return self.screen.get_wch()

    @staticmethod
    def plain(text):
        try:
            return Text.from_markup(text).plain
        except Exception:
            return str(text)

    @staticmethod
    def color(number):
        try:
            return curses.color_pair(number)
        except curses.error:
            return 0

    def init_colors(self):
        try:
            curses.start_color()
            curses.use_default_colors()
            for number, foreground in ((1, curses.COLOR_CYAN), (2, curses.COLOR_GREEN), (3, curses.COLOR_YELLOW),
                                       (4, curses.COLOR_RED)):
                curses.init_pair(number, foreground, -1)
        except curses.error:
            pass

    STALE = 2 * USAGE_TTL    # seconds before cached usage is shown dimmed

    def severity(self, percent):
        return self.color(4 if percent >= 90 else 3 if percent >= 70 else 2)

    def draw_usage_bar(self, row, column, r, width, dimmed=False):
        """a solid usage bar; ┃ marks how much of the window's time is gone (fill past it = ahead of pace)."""
        used = round(max(0, min(r.percent, 100)) / 100 * width)
        fill = curses.A_DIM if dimmed else self.severity(r.percent)
        self.at(row, column, "━" * used, used, fill)
        self.at(row, column + used, "─" * (width - used), width - used, curses.A_DIM)
        elapsed = _elapsed(r.reset, r.length)
        if elapsed is not None and r.reset > time.time():
            mark = min(width - 1, round(elapsed * width))
            self.at(row, column + mark, "┃", 1, curses.A_DIM if dimmed else curses.A_BOLD | (self.color(1) if mark >= used else 0))

    def pct_attr(self, percent, dimmed):
        return curses.A_DIM if dimmed else self.severity(percent) | curses.A_BOLD

    def draw_cells(self, y, x, rows, label_width, bar, dimmed):
        """every window of a login on one row, in slots that line up across rows: label, two-tone bar, percent."""
        for r in rows:
            if x + label_width + 6 >= self.screen.getmaxyx()[1] - 3:
                break
            self.at(y, x, r.label, label_width, curses.A_DIM)
            x += label_width + 1
            if bar >= 3:
                self.draw_usage_bar(y, x, r, bar, dimmed)
                x += bar
            self.at(y, x, f" {r.percent:3.0f}%", 5, self.pct_attr(r.percent, dimmed))
            x += 7

    def brief(self, h, name, survey):
        sessions, daemons, size = survey.profile(h, name)
        def who(items):
            counts = {}
            for _, login in items:
                counts[login or "?"] = counts.get(login or "?", 0) + 1
            return ", ".join(f"{k} ×{n}" if n > 1 else k for k, n in counts.items())
        have = [hh.name for hh in HARNESSES.values() if Profile(hh, name).exists()]
        bits = [" + ".join(have) if h.name in have else f"{' + '.join(have)} · {h.name} starts fresh on first launch",
                human(size) if size is not None else ("—" if h.name not in have else "sizing…")]
        bits.append(f"{len(sessions)} session{'s' * (len(sessions) != 1)} open" + (f" ({who(sessions)})" if sessions else ""))
        bits.append(f"daemon: {who(daemons)} (pid {', '.join(str(p) for p, _ in daemons)})" if daemons else "no daemon")
        if remote := survey.remote(f"{h.name}/{name}"):
            bits.append(f"⇄ {len(remote)} remote control")
        return " · ".join(bits)

    def draw_dashboard(self, selection, usage, survey):
        self.screen.erase()
        height, width = self.screen.getmaxyx()
        if height < 16 or width < 64:
            self.put(0, "silo", curses.A_BOLD)
            self.put(2, "Resize the terminal to at least 64 columns × 16 rows")
            self.put(height - 3, "q Quit")
            self.screen.refresh()
            return False
        accent, dim, bold = self.color(1), curses.A_DIM, curses.A_BOLD
        h = selection.h
        self.frame()
        inner = width - 4

        # profile line: ‹ selected ›, the others around it; ● marks one with sessions or a daemon
        logins = sum(1 for t, _ in selection.accounts if t == h.name)
        right = f"{h.name} · {logins} login{'s' * (logins != 1)}"
        self.at(1, width - 2 - len(right), right, len(right), dim)
        self.at(1, 2, "profile", 7, dim)
        x = 11
        if not selection.profiles:
            self.at(1, x, "none yet · n creates one", inner - 30, accent)
        else:
            i = selection.profiles.index(selection.profile)
            order = selection.profiles[i:] + selection.profiles[:i]
            for name in order:
                chosen = name == selection.profile
                text = (f"‹ {name} ›" if chosen else name) + (" ●" if survey.busy(h, name) else "")
                if x + len(text) > width - 4 - len(right):
                    self.at(1, x, "…", 1, dim)
                    break
                self.at(1, x, text, len(text), bold | accent if chosen else 0)
                x += len(text) + 3
        if selection.profile:
            self.at(2, 11, self.brief(h, selection.profile, survey), inner - 9, dim)

        # detail block for the selected login, sized first so the list gets the rest
        daemons_all = survey.daemons()
        selection.daemons = list(daemons_all)
        if selection.bg not in daemons_all:
            selection.bg = None
        s = UsageSnapshot() if selection.shell or selection.bg else usage.snapshot(h, selection.login) if selection.login \
            else UsageSnapshot(error="No logins yet · a adds one")
        logged_in = bool(selection.login) and Login(h, selection.login).logged_in() and s.error != "not logged in"
        detail_rows = 3 + max(1, 2 * len(s.rows) - 1)
        rows = []
        for hh in HARNESSES.values():
            members = [a for a in selection.accounts if a[0] == hh.name]
            if members or hh is h:
                rows.append((hh.name, None))
                rows.extend(members or [(hh.name, "")])
        if selection.shells:
            rows += [("shell", None)] + [("shell", name) for name, _ in selection.shells]
        if daemons_all:
            rows += [("background", None)] + [("background", key) for key in daemons_all]
        list_top = 4
        room = height - 4 - detail_rows - 1 - list_top
        visible = max(1, min(len(rows), room - sum(1 for _, n in rows if n is None) + 1))
        current = ("background", selection.bg) if selection.bg else ("shell", selection.shell) if selection.shell \
            else (h.name, selection.login)
        index = rows.index(current) if current in rows else 0
        start = max(0, min(index - visible + 1, len(rows) - visible))
        ys, y = [], list_top
        for i, (_, name) in enumerate(rows[start:start + visible]):
            if i and name is None:
                y += 1                                         # a blank line before each tool heading
            ys.append(y)
            y += 1
        list_end = y
        _, daemons, _ = survey.profile(h, selection.profile) if selection.profile else ((), (), None)
        sessions = survey.profile(h, selection.profile)[0] if selection.profile else ()
        # one grid for every row and every frame, so nothing moves while you browse
        name_width = min(28, max([8] + [len(n) for _, n in rows if n]))
        snaps = {(t, n): usage.snapshot(HARNESSES[t], n) for t, n in rows if n and t not in ("shell", "background")}
        windows = [r for snap in snaps.values() for r in snap.rows]
        label_width = min(10, max([2] + [len(r.label) for r in windows]))
        slots = max([2] + [len(snap.rows) for snap in snaps.values()])
        cells_x, marks_width = 5 + name_width, 20             # marks (default, ● bg, open) sit at the right edge
        bar = max(0, min(14, (width - 6 - marks_width - cells_x) // slots - label_width - 8))
        for (tool, name), y in zip(rows[start:start + visible], ys):
            if name is None:
                self.at(y, 2, tool.upper(), inner, bold | dim)
                continue
            if not name:
                self.at(y, 4, "no logins · a adds one", inner, dim)
                continue
            if tool == "shell":
                chosen = (tool, name) == current
                self.at(y, 2, ("› " if chosen else "  ") + name, name_width + 2, bold | accent if chosen else 0)
                self.at(y, cells_x, dict(selection.shells)[name], inner - cells_x, dim)
                if n := len(self.held_sessions(h, selection.profile, selection.login, dict(selection.shells)[name])):
                    self.at(y, width - 6 - 12, f"{n:>3} running", 12, dim)
                continue
            if tool == "background":
                chosen, procs = (tool, name) == current, daemons_all[name]
                label = name.rstrip("/") + " (outside)" if name.endswith("/") else name
                self.at(y, 2, ("› " if chosen else "  ") + label, name_width + 2, bold | accent if chosen else 0)
                logins = sorted({l for _, l, _ in procs if l})
                self.at(y, cells_x, " · ".join([", ".join(logins)] * bool(logins) + [self.kinds(procs)]), inner - cells_x, dim)
                continue
            hh, chosen = HARNESSES[tool], (tool, name) == current
            default = name == Config.defaults(hh)[1]
            label = name if len(name) <= name_width else name[:name_width - 1] + "…"
            self.at(y, 2, ("› " if chosen else "  ") + label, name_width + 2, bold | accent if chosen else 0)
            marks = ["default"] if default else []
            if tool == h.name:
                if any(l == name for _, l in daemons):
                    marks.append("● bg")
                if n := sum(1 for _, l in sessions if l == name):
                    marks.append(f"{n} open")
                if n := sum(1 for _, l, _ in survey.remote(f"{h.name}/{selection.profile}") if l == name):
                    marks.append(f"⇄ {n} rc")
            if detached := sum(1 for x in self.held_sessions(hh, selection.profile, name) if not x.meta.get("attached")):
                marks.append(f"{detached} detached")
            marks = " · ".join(marks)
            self.at(y, width - 6 - len(marks), marks, len(marks), dim)
            x = cells_x
            snap = snaps[(tool, name)]
            logged = Login(hh, name).logged_in() and snap.error != "not logged in"
            stale = not logged or (snap.at and time.time() - snap.at > self.STALE)
            if not logged and not snap.rows:
                self.at(y, x, "not logged in", inner - x, dim)
            elif snap.rows:
                self.draw_cells(y, x, snap.rows, label_width, bar, stale)
                if any(r.percent >= 90 for r in snap.rows) and not stale:
                    self.at(y, width - 4, "⚠", 1, self.color(4) | bold)
            else:
                self.at(y, x, "loading…" if snap.loading else snap.error or "no limits reported", inner - x, dim)

        # detail
        y = list_end + 1
        if selection.bg:
            procs, outside = daemons_all[selection.bg], selection.bg.endswith("/")
            title = f"── {'outside silo · ' + selection.bg.rstrip('/') if outside else 'background · ' + selection.bg} "
            self.at(y, 2, title + "─" * max(0, inner - len(title)), inner, dim)
            self.at(y + 1, 2, f"{self.kinds(procs)} · pid {', '.join(str(p) for p, _, _ in procs)}", inner, 0)
            self.at(y + 2, 2, "not sandboxed by silo: started from a plain terminal" if outside else
                    "keeps the sandbox paths it started with · stop it so new launches pick up changed settings", inner, dim)
            self.at(y + 3, 2, "⏎ opens its agents (claude agents) · x stops its daemon, killing its background agents"
                    + (" (interactive sessions keep running)" if outside else " and their commands"), inner, dim)
            self.draw_remote(y + 5, survey.remote(selection.bg), inner, height)
        elif selection.shell:
            title = f"── shell · {selection.shell} "
            self.at(y, 2, title + "─" * max(0, inner - len(title)), inner, dim)
            self.at(y + 1, 2, f"{selection.shell_path()} inside the {h.name} sandbox of profile {selection.profile or '(none)'}", inner, 0)
            tools = [f"{h.name} as {selection.login or '(none)'}"] + [
                f"{q.h.name} as {q.login.name}" for q in Profile(h, selection.profile).siblings() if q.login.exists()] \
                if selection.profile else []
            self.at(y + 2, 2, "with " + " · ".join(tools) + " · the profile's paths, brokers and limits" if tools else "", inner, dim)
            self.at(y + 3, 2, "run any of them inside · exit returns here", inner, dim)
        email = Login(h, selection.login).account() if selection.login else None
        email = email or s.email
        title = f"── {selection.login or 'no login'}" + (f" · {email}" if email and email not in (selection.login or "") else "") + " "
        if not (selection.shell or selection.bg):
            self.at(y, 2, title + "─" * max(0, inner - len(title)), inner, dim)
            self.at(y + 1, 2, self.plain(s.plan) or ("" if s.loading else "plan unknown"), inner, 0)
        age = int(max(0, time.time() - s.at)) if s.at else None
        state = []
        if selection.login and not logged_in and not selection.bg:
            state.append("not logged in — launching asks you to log in; m → Authenticate")
        if age is not None:
            state.append("updated just now" if age < 60 else f"from {self.plain(_until(time.time() + age))} ago")
        if s.loading:
            state.append("refreshing…")
        if s.error and (logged_in or s.error != "not logged in"):
            state.append(s.error)
        if not (selection.shell or selection.bg):
            self.at(y + 2, 2, " · ".join(state) or "Loading usage…", inner, self.color(3) if not logged_in or s.error else dim)
        dimmed = not logged_in or (age or 0) > self.STALE
        bar_width = min(24, max(8, width - 70))
        for i, r in enumerate(s.rows):
            row = y + 3 + 2 * i
            if row >= height - 4:
                break
            self.at(row, 2, f"{r.label:12.12}", 12, dim)
            self.draw_usage_bar(row, 15, r, bar_width, dimmed)
            pace = self.plain(_pace(r.percent, _elapsed(r.reset, r.length), r.reset, r.length))
            self.at(row, 15 + bar_width, f" {r.percent:3.0f}%", 5, self.pct_attr(r.percent, dimmed))
            when = f" · resets in {self.plain(_until(r.reset))}" if r.reset and r.reset > time.time() else ""
            self.at(row, 22 + bar_width, pace + when, width - bar_width - 25, dim)

        if not (selection.shell or selection.bg):
            self.draw_remote(y + 4 + 2 * len(s.rows), survey.remote(f"{h.name}/{selection.profile}"), inner, height)
        hot = [r for r in s.rows if r.percent >= 90] if not dimmed else []
        warning = "⚠ " + ", ".join(f"{r.label} at {r.percent:.0f}%" + (" (used up)" if r.percent >= 100 else
                                    f", resets in {self.plain(_until(r.reset))}") for r in hot) if hot else ""
        self.put(height - 3, self.message or warning, self.color(3))
        if self.show_keys:   # an overlay over the bottom of the dashboard, above the footer
            columns = 4 if width >= 100 else 2
            per_row = [self.KEYS[i:i + columns] for i in range(0, len(self.KEYS), columns)]
            body = sum(1 + max(len(keys) for _, keys in row) for row in per_row) + len(per_row) - 1
            top = max(4, height - 4 - body)
            self.at(top, 0, "├─ keys " + "─" * (width - 9) + "┤", width, accent)
            for y in range(top + 1, height - 2):
                self.at(y, 1, " " * (width - 2), width - 2)
            column_width, y = inner // columns, top + 1
            for row in per_row:
                for c, (title, keys) in enumerate(row):
                    x = 3 + c * column_width
                    self.at(y, x, title.upper(), column_width, bold | dim)
                    for i, (key, what) in enumerate(keys, y + 1):
                        self.at(i, x, f"{key:>2}", 2, bold | accent)
                        self.at(i, x + 4, what, column_width - 5, 0)
                y += 2 + max(len(keys) for _, keys in row)
        resume = "resume or new " if self.held_sessions(h, selection.profile, selection.login, selection.shell_path()) else ""
        launch = f"⏎ open background agents · x stop daemon · {selection.bg.rstrip('/') + ' outside silo' if selection.bg.endswith('/') else selection.bg}" if selection.bg else f"⏎ {resume}{'shell ' + selection.shell if selection.shell else 'launch ' + h.name} · {selection.profile or '(no profile)'} · " \
                 f"{selection.login or '(no login)'}"
        keys = "? or esc closes keys" if self.show_keys else "←→ profile  ↑↓ login  s settings  r refresh  ? keys  q quit"
        self.at(height - 2, 2, launch, inner - len(keys) - 2, bold | accent)
        self.at(height - 2, width - 2 - len(keys), keys, len(keys), dim)
        self.screen.refresh()
        return True

    def draw_remote(self, y, remote, inner, height):
        """the sessions under remote control (/rc): name, status, folder, start time."""
        if not remote or y >= height - 4:
            return
        self.at(y, 2, "⇄ remote control", inner, curses.A_BOLD)
        for i, (pid, _, info) in enumerate(remote[:height - 5 - y], y + 1):
            cwd = str(info.get("cwd", "")).replace(str(HOME), "~", 1)
            since = time.strftime("%H:%M", time.localtime(info.get("startedAt", 0) / 1000))
            self.at(i, 4, f"{str(info.get('name') or pid)[:12]:12} {info.get('status', ''):6} {cwd[:40]:40} since {since}", inner - 2, 0)

    def held_sessions(self, h, profile, login, shell=None):
        """this launch's running sessions (refreshed at most once a second)."""
        if time.time() - getattr(self, "_held_at", 0) > 1:
            self._held, self._held_at = Session.all(), time.time()
        return [x for x in self._held if (lambda m: m.get("tool") == h.name and m.get("profile") == profile
                and m.get("login") == login and m.get("shell") == shell)(x.meta)]

    @staticmethod
    def kinds(procs):
        counts = {}
        for _, _, kind in procs:
            counts[kind] = counts.get(kind, 0) + 1
        words = {"session": ("interactive",) * 2, "agent": ("background agent", "background agents"),
                 "daemon": ("daemon process", "daemon processes")}
        return " · ".join(f"{counts[k]} {words[k][counts[k] != 1]}" for k in words if k in counts)

    def open_agents(self, h, name, procs):
        """the tool's own background-agent manager (claude agents), in the sandbox of the daemon's login."""
        if h.name != "claude":
            self.message = f"{h.name} has no background-agent view"
            return
        if not name:                                     # outside silo: the host's own claude
            self.terminal(subprocess.run, [h.bin, "agents"])
            return
        logins = sorted({l for _, l, _ in procs if l})
        if not logins:
            self.message = "Cannot tell which login this daemon runs under"
            return
        login = logins[0]
        if len(logins) > 1:
            index = self.menu(f"Background agents of {h.name}/{name}", logins, "The daemon runs under several logins")
            if index is None:
                return
            login = logins[index]
        def go():
            session = Session.start(h, name, login, ("agents",))
            rc = session.attach()
            self._held_at = 0
            return ("detached", session.id) if rc is None else rc
        if isinstance(result := self.terminal(go), tuple):
            self.message = f"Session #{result[1]} keeps running · silo attach {result[1]}"

    def launch(self, selection):
        """Enter: resume a running session of this profile + login (+ shell), or start a new one."""
        h, shell = selection.h, selection.shell_path()
        running = self.held_sessions(h, selection.profile, selection.login, shell)
        chosen = None
        if running:
            items = [f"Attach {x.label()}" for x in running] + ["Start a new session"]
            index = self.menu("Resume or start", items, "Several terminals may attach to one session · ctrl-] detaches")
            if index is None:
                return
            chosen = running[index] if index < len(running) else None

        def go():
            session = chosen or Session.start(h, selection.profile, selection.login, (), shell)
            rc = session.attach()
            self._held_at = 0
            return ("detached", session.id) if rc is None else rc
        result = self.terminal(go)
        if isinstance(result, tuple):
            self.message = f"Session #{result[1]} keeps running · Enter here resumes it · silo attach {result[1]}"

    KEYS = (("go", (("⏎", "launch · resume"), ("←→", "profile"), ("↑↓", "login · shell · daemon"), ("x", "stop daemon"), ("^]", "detach (in a session)"), ("q", "quit"))),
            ("create", (("n", "new profile"), ("a", "add login"), ("o", "setup · import"))),
            ("change", (("e", "rename"), ("m", "manage"), ("s", "settings"), ("d", "save defaults"))),
            ("usage", (("r", "refresh now"), ("?", "close this"))))

    def action(self, key, selection, usage):
        if key == "n":
            if name := self.new_profile():
                selection.profile = name
        elif key == "a":
            tools = list(HARNESSES)
            index = self.menu("Add login · choose its agent", [name.title() for name in tools])
            if index is not None:
                h = HARNESSES[tools[index]]
                if name := self.new_login(h):
                    selection.select_account(h.name, name)
                    usage.request(h, name, force=True)
        elif key == "m":
            items = [f"Profile {selection.profile}…"] * bool(selection.profile) + [f"Login {selection.login}…"] * bool(selection.login)
            index = self.menu("Manage", items) if items else None
            if index is not None and items[index].startswith("Profile"):
                selection.profile = self.profile_menu(selection.h, selection.profile) or selection.profile
            elif index is not None:
                selection.login = self.login_menu(selection.h, selection.login, usage)
        elif key == "e":
            items = [f"Rename profile {selection.profile}"] * bool(selection.profile) + [f"Rename login {selection.login}"] * bool(selection.login)
            index = self.menu("Rename", items) if items else None
            if index is not None and items[index].startswith("Rename profile"):
                selection.profile = self.rename_profile(selection.h, selection.profile)
            elif index is not None:
                selection.login = self.rename_login(selection.h, selection.login)
        elif key == "o":
            self.setup()
        elif key == "s":
            items = [f"Sandbox settings for {selection.h.name}/{selection.profile}"] * bool(selection.profile) + \
                    ["Global defaults (every profile inherits these)"]
            index = self.menu("Settings", items, "Paths, SSH, GPG, brokered commands, resource limits, updates")
            if index is not None:
                self.settings(selection.h, selection.profile) if items[index].startswith("Sandbox") else self.settings()

    def run(self):
        curses.curs_set(0)
        self.screen.keypad(True)
        self.init_colors()
        if not Config.effective(Config.read())["onboarding_complete"] \
                and not any(Profile.all(h) or Login.all(h) for h in HARNESSES.values()):
            self.setup()
        if Config.effective(Config.read())["check_updates"] != "never":
            threading.Thread(target=fetch_news, daemon=True).start()   # shows next time if it brings news
        news, new = unseen(Config.read())
        if news or new:
            self.whats_new(news, new)
        selection, usage, survey = LauncherSelection(self.h.name), AsyncUsage(), Survey()
        self.survey = survey
        try:
            self.screen.timeout(150)  # poll completed workers without blocking input/launch
            while True:
                selection.reload()
                self.h = selection.h
                # Selected account gets first priority, followed by the remaining rows.
                accounts = [a for a in dict.fromkeys([(selection.h.name, selection.login), *selection.accounts]) if a[1]]
                for tool, name in accounts:
                    usage.request(HARNESSES[tool], name)
                ready = self.draw_dashboard(selection, usage, survey)
                try:
                    key = self.screen.get_wch()
                except curses.error:
                    continue
                if key in (curses.KEY_RESIZE, -1) or not ready:
                    continue
                if self.show_keys or key == "?":       # the overlay takes the next key, then closes
                    self.show_keys = key == "?" and not self.show_keys
                    if key in ("?", "\x1b"):
                        continue
                if key in ("q", "\x1b", "\x03"):
                    return
                if key in (curses.KEY_LEFT, "h", curses.KEY_RIGHT, "l"):
                    selection.move_profile(-1 if key in (curses.KEY_LEFT, "h") else 1)
                elif key in (curses.KEY_UP, "k", curses.KEY_DOWN, "j"):
                    selection.move_login(-1 if key in (curses.KEY_UP, "k") else 1)
                elif key == "r":
                    for tool, name in accounts:
                        usage.request(HARNESSES[tool], name, force=True)
                    self.message = "Refreshing usage in the background"
                elif key == "d":
                    if self.attempt(selection.save_defaults)[0]:
                        self.message = "Profile and login defaults saved"
                elif key in ("\n", "\r", curses.KEY_ENTER, "x") and selection.bg:
                    self.screen.timeout(-1)
                    try:
                        tool, name = selection.bg.split("/", 1)
                        if key == "x" and not name:
                            self.stop_outside(HARNESSES[tool], survey.daemons().get(selection.bg, ()))
                        elif key == "x":
                            self.stop_daemon(HARNESSES[tool], name)
                        else:
                            self.open_agents(HARNESSES[tool], name, survey.daemons().get(selection.bg, ()))
                    finally:
                        self.screen.timeout(150)
                elif key in ("\n", "\r", curses.KEY_ENTER):
                    if selection.profile and selection.login:
                        self.screen.timeout(-1)
                        try:
                            self.launch(selection)
                        finally:
                            self.screen.timeout(150)
                    else:
                        self.message = "n creates a profile" if not selection.profile else "a adds a login"
                elif key in ("n", "a", "m", "s", "e", "o"):
                    self.screen.timeout(-1)
                    try:
                        self.action(key, selection, usage)
                    finally:
                        self.screen.timeout(150)
        finally:
            self.screen.timeout(-1)
            usage.close()  # Never wait for outstanding network requests.
            survey.close()


def open_tui(tool="claude"):
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise click.ClickException("The TUI needs an interactive terminal. Use silo --help for direct commands.")
    try:
        curses.wrapper(lambda screen: TerminalUI(screen, tool).run())
    except KeyboardInterrupt:
        return
    except curses.error as e:
        raise click.ClickException(f"Cannot open terminal UI: {e}") from e
    except (ValueError, OSError) as e:
        raise click.ClickException(str(e)) from e


@cli.command()
@click.pass_obj
def tui(h):
    """Open profiles, login management and all settings in a terminal menu."""
    open_tui(h.name)



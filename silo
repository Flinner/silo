# ---- terminal UI: standard library only; all mutations use the shared operations ----
class TerminalUI:
    def __init__(self, screen, tool):
        self.screen, self.tool = screen, TOOLS[tool]
        self.message = ""
        self.bar_colors = {}

    def put(self, row, text, attr=0):
        height, width = self.screen.getmaxyx()
        if 0 <= row < height - 1 and width > 3:
            try:
                self.screen.addnstr(row, 2, str(text).replace("\n", " "), width - 4, attr)
            except curses.error:
                pass

    def menu(self, title, items, detail="", actions=None, initial=0):
        actions = actions or {}
        selected = min(initial, max(0, len(items) - 1))
        while True:
            self.screen.erase()
            height, width = self.screen.getmaxyx()
            self.put(0, "silo  /  " + title, curses.A_BOLD)
            self.put(2, detail)
            visible = max(1, height - 9)
            start = max(0, min(selected - visible + 1, max(0, len(items) - visible)))
            if not items:
                self.put(4, "Nothing here yet. Press n to create one.", curses.A_DIM)
            for row, index in enumerate(range(start, min(start + visible, len(items))), 4):
                self.put(row, ("> " if index == selected else "  ") + items[index],
                         curses.A_REVERSE if index == selected else 0)
            self.put(height - 4, self.message, curses.A_BOLD)
            self.put(height - 3, "↑/↓ select · Enter open · Esc back")
            self.put(height - 2, " · ".join(f"{key} {label}" for key, label in actions.items()))
            self.screen.refresh()
            key = self.screen.get_wch()
            if key in ("\x1b", "\x03"):
                return None
            if isinstance(key, str) and key in actions:
                self.message = ""
                return key
            if key in (curses.KEY_DOWN, "j") and items:
                selected = (selected + 1) % len(items)
            elif key in (curses.KEY_UP, "k") and items:
                selected = (selected - 1) % len(items)
            elif key == curses.KEY_NPAGE and items:
                selected = min(len(items) - 1, selected + visible)
            elif key == curses.KEY_PPAGE and items:
                selected = max(0, selected - visible)
            elif key in ("\n", "\r", curses.KEY_ENTER) and items:
                self.message = ""
                return selected

    def prompt(self, title, value="", detail=""):
        """A small editable field; Esc cancels without changing the value."""
        text, cursor = str(value), len(str(value))
        try:
            curses.curs_set(1)
            while True:
                self.screen.erase()
                height, width = self.screen.getmaxyx()
                self.put(0, title, curses.A_BOLD)
                self.put(2, detail)
                span = max(1, width - 5)
                offset = max(0, cursor - span + 1)
                self.put(4, text[offset:offset + span], curses.A_REVERSE)
                self.put(height - 3, "Enter accept · Esc cancel · Ctrl-U clear")
                if height > 5 and width > 5:
                    self.screen.move(4, min(width - 2, 2 + cursor - offset))
                self.screen.refresh()
                key = self.screen.get_wch()
                if key in ("\x1b", "\x03"):
                    return None
                if key in ("\n", "\r", curses.KEY_ENTER):
                    return text
                if key in (curses.KEY_BACKSPACE, "\x7f", "\b") and cursor:
                    text, cursor = text[:cursor - 1] + text[cursor:], cursor - 1
                elif key == curses.KEY_DC:
                    text = text[:cursor] + text[cursor + 1:]
                elif key == curses.KEY_LEFT:
                    cursor = max(0, cursor - 1)
                elif key == curses.KEY_RIGHT:
                    cursor = min(len(text), cursor + 1)
                elif key in (curses.KEY_HOME, "\x01"):
                    cursor = 0
                elif key in (curses.KEY_END, "\x05"):
                    cursor = len(text)
                elif key == "\x15":
                    text, cursor = "", 0
                elif isinstance(key, str) and key.isprintable():
                    text, cursor = text[:cursor] + key + text[cursor:], cursor + len(key)
        finally:
            curses.curs_set(0)

    def confirm(self, title, detail=""):
        return self.menu(title, ["Cancel", "Confirm"], detail) == 1

    def attempt(self, fn, *args):
        try:
            return True, fn(*args)
        except (ValueError, OSError, click.ClickException) as e:
            self.message = str(e)
            return False, None

    def terminal(self, fn, *args):
        """Hand off the terminal and return automatically when the command exits."""
        curses.def_prog_mode()
        curses.endwin()
        result = None
        self.message = ""
        try:
            try:
                result = fn(*args)
                if isinstance(result, int) and result:
                    self.message = f"Exited with status {result}"
            except (ValueError, OSError, click.ClickException) as e:
                self.message = str(e)
            except KeyboardInterrupt:
                self.message = "Interrupted"
            except SystemExit as e:
                if e.code:
                    self.message = f"Exited with status {e.code}"
        finally:
            curses.reset_prog_mode()
            self.screen.clear()
            self.screen.refresh()
        return result

    def new_login(self, tool):
        name = self.prompt(f"{tool.bin} / New login name")
        if name is None:
            return None
        success, _ = self.attempt(validate_name, name)
        if not success:
            return None
        if (LOGINS / tool.bin / name).exists():
            self.message = f"Login {name} already exists; select it to authenticate"
            return None
        found = (native_login_home(tool) / tool.cred).is_file()
        choices = ["Copy this machine's existing account", "Authenticate a new account", "Create empty login"] if found else ["Authenticate a new account", "Create empty login"]
        selected = self.menu("Create login", choices, f"Existing account found in {native_login_home(tool)}" if found else "No native account found")
        if selected is None:
            return None
        importing = found and selected == 0
        authenticating = selected == (1 if found else 0)
        success, _ = self.attempt(add_login, tool, name, importing)
        if not success:
            return None
        if authenticating:
            self.authenticate(tool, name)
        else:
            self.message = f"Created login {name}"
        return name

    def authenticate(self, tool, login):
        status = self.terminal(run_authentication, tool, login)
        if status == 0 and (LOGINS / tool.bin / login / tool.cred).is_file():
            self.message = "Authenticated"
        elif not self.message:
            self.message = "Authentication did not finish; retry from Manage"

    @staticmethod
    def run_agent(tool, name, login, args=()):
        return subprocess.run(launch_argv(tool, name, login, args)).returncode

    def new_profile(self):
        name = self.prompt(f"{self.tool.bin} / New profile name", detail="Conversation history; accounts are selected independently")
        if name is None:
            return None
        success, _ = self.attempt(create, self.tool, name, False)
        if not success:
            return None
        sources = history_sources(self.tool)
        if sources and self.confirm("Copy existing conversations into " + name + "?", f"Found in {native_home(self.tool)}. Originals are kept."):
            self.message = "Copying conversation history…"
            self.attempt(import_history, self.tool, name)
        if (native_login_home(self.tool) / self.tool.cred).is_file() and self.confirm("Also copy your existing account?", "The account stays separate from this history profile"):
            self.new_login(self.tool)
        if self.confirm("Configure this profile's sandbox?", "Writable/read-only paths, hidden paths, SSH, GPG and resource limits"):
            self.settings(self.tool, name)
        self.message = f"Created profile {name}"
        return name

    def rename_selected_profile(self, tool, name):
        new_name = self.prompt("Rename profile", name)
        if new_name is None or new_name == name:
            return name
        success, _ = self.attempt(rename_profile, tool, name, new_name)
        if success:
            self.message = f"Renamed profile to {new_name}"
            return new_name
        return name

    def onboarding(self):
        """First-run import/create flow, also available from the launcher with o."""
        tools = list(TOOLS)
        while True:
            descriptions = []
            for key in tools:
                tool = TOOLS[key]
                found = []
                if (native_login_home(tool) / tool.cred).is_file():
                    found.append("account")
                if history_sources(tool):
                    found.append("history")
                descriptions.append(f"{key.title()}: " + ("import " + " + ".join(found) if found else "create account + history"))
            selected = self.menu("Welcome · bring your accounts and histories into silo", [*descriptions, "Finish setup"],
                                 "Imports are copies. Sandbox settings are configured separately for each profile.")
            if selected is None:
                return
            if selected == len(tools):
                raw = read_cfg()
                raw["onboarding_complete"] = True
                Configuration.save(raw)
                return
            self.tool = TOOLS[tools[selected]]
            names = sorted(d.name for d in (LOGINS / self.tool.bin).glob("*/") if d.is_dir())
            login = self.new_login(self.tool) if not names else names[0]
            existing = profile_names(self.tool)
            name = self.new_profile() if not existing or self.confirm("Create another history profile?") else existing[0]
            if name and login:
                Configuration.set_defaults(self.tool, name, login)

    def profile_menu(self, tool, name):
        while True:
            action = self.menu(f"{tool.bin} / Profile {name}", ["Rename profile", "Delete profile", "Back"], "Conversation history; account selection is independent")
            if action in (None, 2):
                return name
            if action == 0:
                name = self.rename_selected_profile(tool, name)
            elif action == 1 and self.confirm(f"Delete profile {name}?", "Conversation history is deleted. Accounts are kept."):
                self.terminal(delete_profile, tool, name)
                if not (ROOT / tool.bin / name).exists():
                    return None

    def edit_list(self, title, value):
        draft = list(value)
        while True:
            action = self.menu(title, draft, "One item per entry; paths may contain spaces", {"a": "add", "d": "delete", "s": "accept"})
            if action is None:
                return None
            if action == "s":
                return draft
            if action == "a":
                item = self.prompt("Add item")
                if item:
                    draft.append(item)
            elif action == "d" and draft:
                # Pick explicitly, avoiding deletion of an unseen cursor selection.
                index = self.menu("Delete which item?", draft)
                if index is not None:
                    draft.pop(index)
            elif isinstance(action, int):
                item = self.prompt("Edit item", draft[action])
                if item is not None:
                    draft[action] = item

    def edit_table(self, key, value):
        draft = copy.deepcopy(value)
        while True:
            keys = sorted(draft)
            action = self.menu(key, [f"{name}: {self.display(draft[name])}" for name in keys], SETTINGS[key].description,
                               {"a": "add", "d": "delete", "s": "accept"})
            if action is None:
                return None
            if action == "s":
                return draft
            if action == "d" and keys:
                index = self.menu("Delete which entry?", keys)
                if index is not None:
                    del draft[keys[index]]
                continue
            if action == "a":
                name = self.prompt("New entry", detail="tool/profile" if key == "logins" else "Tool name: claude or codex" if key.startswith("default_") else "Command name, for example gh")
                if not name:
                    continue
                if name in draft:
                    self.message = "That entry already exists; select it to edit"
                    continue
                old = [] if key == "brokered" else ""
            elif isinstance(action, int):
                name, old = keys[action], draft[keys[action]]
            else:
                continue
            new = self.edit_list(name, old) if key == "brokered" else self.prompt("Login for " + name, old)
            if new is not None:
                candidate = {**draft, name: new}
                success, _ = self.attempt(SETTINGS[key].validate, key, candidate)
                if success:
                    draft = candidate

    @staticmethod
    def display(value):
        if isinstance(value, bool):
            return "yes" if value else "no"
        if isinstance(value, (dict, list)):
            return json.dumps(value, ensure_ascii=False)
        return str(value) or "(none)"

    def edit_setting(self, key, value):
        setting = SETTINGS[key]
        if isinstance(setting.default, bool) or setting.choices:
            choices = list(setting.choices) if setting.choices else [False, True]
            action = self.menu(key, [self.display(v) for v in choices], setting.description, initial=choices.index(value))
            return None if action is None else choices[action]
        if isinstance(setting.default, list):
            new = self.edit_list(key, value)
            return None if new is None else Configuration.parse(key, new)
        if isinstance(setting.default, dict):
            return self.edit_table(key, value)
        text = self.prompt(key, value, setting.description)
        return None if text is None else Configuration.parse(key, [text])

    def settings(self, tool=None, name=None):
        global_raw = read_cfg()
        scoped = tool is not None and name is not None
        base = copy.deepcopy(global_raw.get("profile_settings", {}).get(f"{tool.bin}/{name}", {})) if scoped else global_raw
        draft = copy.deepcopy(base)
        selected = 0
        while True:
            keys = [key for key in SETTINGS if SETTINGS[key].scope == "profile"] if scoped else [key for key in SETTINGS if key != "profile_settings"]
            effective = Configuration.effective(global_raw, tool, name) if scoped else Configuration.effective(draft)
            effective.update(draft)
            labels = [f"{'*' if draft.get(key) != base.get(key) or (key in draft) != (key in base) else ' '} {key:16} {self.display(effective[key])}" for key in keys]
            action = self.menu(f"{tool.bin}/{name} · Sandbox settings" if scoped else "Global defaults", labels,
                               "* unsaved · applies only to this profile" if scoped else "* unsaved · defaults inherited by profiles",
                               {"s": "save", "r": "reset one", "R": "reset all", **({"g": "global defaults"} if scoped else {})}, selected)
            if action is None:
                if draft == base or self.confirm("Discard unsaved settings?"):
                    return
                continue
            if action == "s":
                success, _ = self.attempt(Configuration.commit_profile, tool, name, base, draft) if scoped else self.attempt(Configuration.commit, base, draft)
                if success:
                    self.message = "Settings saved"
                    return
            elif action == "g" and scoped:
                self.settings()
                global_raw = read_cfg()
            elif action == "r":
                index = self.menu("Reset which setting?", keys)
                if index is not None:
                    draft.pop(keys[index], None)
            elif action == "R":
                if self.confirm("Reset all settings to defaults?", "Resets overrides for this profile. Save to apply." if scoped else "Resets global defaults. Save to apply."):
                    for key in keys:
                        draft.pop(key, None)
            elif isinstance(action, int):
                selected, key = action, keys[action]
                success, new = self.attempt(self.edit_setting, key, effective[key])
                if success and new is not None:
                    draft[key] = new

    def at(self, row, column, text, width, attr=0):
        height, columns = self.screen.getmaxyx()
        if 0 <= row < height and 0 <= column < columns and width > 0:
            try:
                safe = "".join(c for c in str(text) if c.isprintable())
                self.screen.addnstr(row, column, safe, min(width, columns - column), attr)
            except curses.error:
                pass

    @staticmethod
    def plain(text):
        try:
            return Text.from_markup(text).plain
        except Exception:
            return str(text)

    @staticmethod
    def color(number):
        try:
            return curses.color_pair(number)
        except curses.error:
            return 0

    @staticmethod
    def quota(snapshot, seconds):
        for _, percent, _, length in snapshot.rows:
            if length == seconds:
                return percent
        return None

    def draw_usage_bar(self, row, column, percent, reset, length, width):
        used = round(max(0, min(percent, 100)) / 100 * width)
        elapsed = _elapsed(reset, length)
        gone = round(elapsed * width) if elapsed is not None else 0
        severity = 3 if percent >= 90 else 2 if percent >= 70 else 1
        for cell in range(width):
            top, bottom = cell < used, cell < gone
            pair = self.bar_colors.get((severity if top else 0, bottom))
            if pair is not None:
                glyph, attr = "▀", self.color(pair)
            else:
                glyph, attr = ("█" if top and bottom else "▀" if top else "▄" if bottom else "░"), 0
            self.at(row, column + cell, glyph, 1, attr)

    def draw_dashboard(self, selection, usage):
        self.screen.erase()
        height, width = self.screen.getmaxyx()
        if height < 22 or width < 72:
            self.put(0, "silo", curses.A_BOLD)
            self.put(2, "Resize the terminal to at least 72 columns × 22 rows")
            self.put(height - 3, "q Quit · Esc Back")
            self.screen.refresh()
            return False
        accent = self.color(1)
        dim = curses.A_DIM
        self.at(0, 0, "╭─ silo " + "─" * (width - 9) + "╮", width, accent)
        for y in range(1, height - 1):
            self.at(y, 0, "│", 1, accent)
            self.at(y, width - 1, "│", 1, accent)
        self.at(height - 1, 0, "╰" + "─" * (width - 2) + "╯", width, accent)
        self.put(2, "Choose a history and account · Tab switches columns", dim)
        left, profile_width = 3, max(22, (width - 8) // 3)
        right = left + profile_width + 3
        login_width = width - right - 3
        self.at(4, left, "PROFILE · " + selection.tool.bin.title(), profile_width,
                curses.A_BOLD | (accent if selection.focus == "profile" else dim))
        self.at(4, right, "LOGIN · account", login_width - 14,
                curses.A_BOLD | (accent if selection.focus == "login" else dim))
        self.at(4, right + login_width - 13, "5h", 5, dim)
        self.at(4, right + login_width - 6, "Weekly", 6, dim)
        self.at(5, left, "─" * profile_width, profile_width, dim)
        self.at(5, right, "─" * login_width, login_width, dim)
        visible = height - 18
        if not selection.profiles:
            self.at(6, left, "No profiles yet", profile_width, dim)
            self.at(7, left, "n Create profile", profile_width, accent)
        else:
            index = selection.profiles.index(selection.profile)
            start = max(0, index - visible + 1)
            for row, name in enumerate(selection.profiles[start:start + visible], 6):
                tag = " · default" if name == selection.defaults[0] else ""
                available = max(1, profile_width - 2 - len(tag))
                label = name if len(name) <= available else name[:max(1, available - 1)] + "…"
                self.at(row, left, ("› " if name == selection.profile else "  ") + label + tag, profile_width,
                        curses.A_BOLD | accent if name == selection.profile else 0)
        account_rows = []
        for tool in TOOLS.values():
            account_rows.append((tool.bin, None))
            members = [account for account in selection.accounts if account[0] == tool.bin]
            account_rows.extend(members or [(tool.bin, "")])
        current = (selection.tool.bin, selection.login)
        index = account_rows.index(current) if current in account_rows else 0
        start = max(0, index - visible + 1)
        if start and account_rows[start][1] is not None:
            start = max(0, index - visible + 2)
            shown = [(account_rows[start][0], None), *account_rows[start:start + visible - 1]]
        else:
            shown = account_rows[start:start + visible]
        for row, (tool_name, name) in enumerate(shown, 6):
            if name is None:
                self.at(row, right, tool_name.upper(), login_width, curses.A_BOLD | dim)
                continue
            if not name:
                self.at(row, right, "  No accounts · a to add", login_width, dim)
                continue
            chosen = (tool_name, name) == current
            tag = " · default" if name == Configuration.selections(TOOLS[tool_name])[1] else ""
            name_width = login_width - 15
            available = max(1, name_width - len(tag))
            label = name if len(name) <= available else name[:max(1, available - 1)] + "…"
            self.at(row, right, ("› " if chosen else "  ") + label + tag, name_width + 2,
                    curses.A_BOLD | accent if chosen else 0)
            snapshot = usage.snapshot(TOOLS[tool_name], name)
            if not snapshot.rows:
                self.at(row, right + login_width - 13, "loading…" if snapshot.loading else snapshot.error or "no limits", 13, dim)
            else:
                for seconds, offset, cell_width in ((18000, 13, 5), (604800, 6, 6)):
                    percent = self.quota(snapshot, seconds)
                    color = self.color(3 if percent is not None and percent >= 90 else 2)
                    self.at(row, right + login_width - offset, f"{percent:3.0f}%" if percent is not None else "   —", cell_width, color)
        snapshot = usage.snapshot(selection.tool, selection.login) if selection.login else UsageSnapshot(error="No logins yet · a to add one")
        detail = height - 11
        self.put(detail, (selection.login or "No account selected") + (" · " + snapshot.email if snapshot.email else ""), curses.A_BOLD)
        self.put(detail + 1, self.plain(snapshot.plan) or "Usage status", dim)
        if snapshot.rows:
            for y, (label, percent, reset, length) in enumerate(snapshot.rows[:3], detail + 2):
                bar_width = min(18, max(8, width - 64))
                self.at(y, 2, f"{label:12.12}  ", 14)
                self.draw_usage_bar(y, 16, percent, reset, length, bar_width)
                pace = self.plain(_pace(percent, _elapsed(reset, length), reset, length))
                self.at(y, 16 + bar_width, f" {percent:3.0f}%  {pace}  resets in {self.plain(_until(reset))}", width - bar_width - 19,
                        self.color(3 if percent >= 90 else 2))
        else:
            self.put(detail + 2, "Loading usage…" if snapshot.loading else snapshot.error or "No limits reported", dim)
        notes = []
        if snapshot.at:
            age = int(max(0, time.time() - snapshot.at))
            notes.append("updated just now" if age < 60 else f"cached · {self.plain(_until(time.time() + age))} ago")
        if snapshot.loading:
            notes.append("refreshing…")
        if snapshot.error and snapshot.rows:
            notes.append(snapshot.error)
        if len(snapshot.rows) > 3:
            notes.append("more limits in Manage → Usage details")
        notes.append("bars: top usage / bottom time")
        self.put(height - 6, " · ".join(notes), dim)
        self.put(height - 5, f"[ Enter ↵ Launch ]  {selection.tool.bin.title()} · {selection.profile or '(none)'} history · {selection.login or '(none)'} account", curses.A_BOLD | accent)
        self.put(height - 4, self.message, self.color(3))
        self.put(height - 3, "p Profile   l Login   r Refresh usage   d Save defaults", dim)
        self.put(height - 2, "n New profile  a Add login  e Rename  b Daemons  s Settings  o Setup  q Quit", dim)
        self.screen.refresh()
        return True

    def login_menu(self, tool, name, usage):
        while True:
            selected = self.menu(f"{tool.bin} / Login {name}", ["Authenticate", "Usage details", "Delete login", "Back"])
            if selected in (None, 3):
                return
            if selected == 0:
                self.authenticate(tool, name)
                usage.request(tool, name, force=True)
            elif selected == 1:
                snapshot = usage.snapshot(tool, name)
                lines = [f"{label}: {percent:.0f}% · resets in {self.plain(_until(reset))}" for label, percent, reset, _ in snapshot.rows]
                self.menu("Usage · " + name, lines or ["Loading…" if snapshot.loading else snapshot.error or "No limits reported"],
                          self.plain(snapshot.plan))
            elif selected == 2 and self.confirm(f"Delete login {name}?", "The account is removed. Conversation histories are kept."):
                success, _ = self.attempt(delete_login, tool, name)
                if success:
                    self.message = f"Deleted login {name}"
                    return

    def run(self):
        curses.curs_set(0)
        self.screen.keypad(True)
        try:
            curses.start_color()
            curses.use_default_colors()
            for number, foreground in ((1, curses.COLOR_CYAN), (2, curses.COLOR_GREEN), (3, curses.COLOR_YELLOW)):
                curses.init_pair(number, foreground, -1)
            grey = 8 if curses.COLORS >= 16 else curses.COLOR_WHITE
            number = 4
            for severity, foreground in ((0, curses.COLOR_BLACK), (1, curses.COLOR_GREEN), (2, curses.COLOR_YELLOW), (3, curses.COLOR_RED)):
                for gone in (False, True):
                    curses.init_pair(number, foreground, grey if gone else curses.COLOR_BLACK)
                    self.bar_colors[(severity, gone)] = number
                    number += 1
        except curses.error:
            pass
        if not Configuration.effective(read_cfg())["onboarding_complete"] and not any(profile_names(t) for t in TOOLS.values()) :
            if not any(d.is_dir() for t in TOOLS.values() for d in (LOGINS / t.bin).glob("*/")):
                self.onboarding()
        selection, usage = LauncherSelection(self.tool.bin), AsyncUsage()
        try:
            self.screen.timeout(150)  # poll completed workers without blocking input/launch
            while True:
                selection.reload()
                self.tool = selection.tool
                # Selected account gets first priority, followed by the remaining rows.
                accounts = list(dict.fromkeys([(selection.tool.bin, selection.login), *selection.accounts]))
                for tool_name, name in accounts:
                    if name is not None:
                        usage.request(TOOLS[tool_name], name)
                ready = self.draw_dashboard(selection, usage)
                try:
                    key = self.screen.get_wch()
                except curses.error:
                    continue
                if key in ("q", "\x1b", "\x03"):
                    return
                if key in (curses.KEY_RESIZE, -1):
                    continue
                if not ready:
                    continue
                if key in ("p", "l"):
                    selection.focus = "profile" if key == "p" else "login"
                elif key == "\t":
                    selection.focus = "login" if selection.focus == "profile" else "profile"
                elif key in (curses.KEY_LEFT, "h"):
                    selection.focus = "profile"
                elif key == curses.KEY_RIGHT:
                    selection.focus = "login"
                elif key in (curses.KEY_UP, "k", curses.KEY_DOWN, "j"):
                    selection.move(-1 if key in (curses.KEY_UP, "k") else 1)
                elif key == "r":
                    for tool_name, name in accounts:
                        if name is not None:
                            usage.request(TOOLS[tool_name], name, force=True)
                    self.message = "Refreshing usage in the background"
                elif key == "d":
                    success, _ = self.attempt(selection.save_defaults)
                    if success:
                        self.message = "Profile and login defaults saved independently"
                elif key in ("\n", "\r", curses.KEY_ENTER):
                    if selection.profile and selection.login:
                        self.terminal(self.run_agent, selection.tool, selection.profile, selection.login)
                    else:
                        self.message = "n Create a profile" if not selection.profile else "a Add a login"
                elif key in ("n", "a", "m", "s", "e", "o", "b"):
                    self.screen.timeout(-1)
                    try:
                        if key == "n":
                            name = self.new_profile()
                            if name:
                                selection.profile = name
                        elif key == "a":
                            tools = list(TOOLS)
                            index = self.menu("Add login · choose its agent", [name.title() for name in tools])
                            if index is not None:
                                tool = TOOLS[tools[index]]
                                name = self.new_login(tool)
                                if name:
                                    selection.select_account(tool.bin, name)
                                    usage.request(tool, name, force=True)
                        elif key == "m":
                            if selection.focus == "profile" and selection.profile:
                                renamed = self.profile_menu(selection.tool, selection.profile)
                                if renamed:
                                    selection.profile = renamed
                            elif selection.focus == "login" and selection.login:
                                self.login_menu(selection.tool, selection.login, usage)
                        elif key == "e" and selection.profile:
                            selection.profile = self.rename_selected_profile(selection.tool, selection.profile)
                        elif key == "o":
                            self.onboarding()
                        elif key == "b":
                            self.daemons_view(daemons)
                        else:
                            self.settings(selection.tool, selection.profile) if selection.profile else self.settings()
                    finally:
                        self.screen.timeout(150)
        finally:
            self.screen.timeout(-1)
            usage.close()  # Never wait for outstanding network requests.


def open_tui(tool="claude"):
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise click.ClickException("The TUI needs an interactive terminal. Use silo --help for direct commands.")
    try:
        curses.wrapper(lambda screen: TerminalUI(screen, tool).run())
    except KeyboardInterrupt:
        return
    except curses.error as e:
        raise click.ClickException(f"Cannot open terminal UI: {e}") from e
    except (ValueError, OSError) as e:
        raise click.ClickException(str(e)) from e


@cli.command()
@click.pass_obj
def tui(tool):
    """Open profiles, login management and all settings in a terminal menu."""
    open_tui(tool.bin)

if __name__ == "__main__":
    cli()

CHOICES = {"ionice": ["idle", "low", "normal"], "check_updates": ["ask", "always", "never"]}


def raw_cfg():
    return read_cfg()


def coerce(key, values):
    d = DEFAULTS[key]
    if isinstance(d, dict):
        die(f"{key} is a table; change it with [cyan]silo config --edit[/]")
    if isinstance(d, list):
        return [v.replace(str(HOME), "~", 1) if v.startswith(str(HOME)) else v for v in values]
    if len(values) != 1:
        die(f"{key} takes one value")
    v = values[0]
    if isinstance(d, bool):
        if v.lower() not in ("true", "false", "yes", "no", "on", "off", "1", "0"):
            die(f"{key} is yes or no")
        return v.lower() in ("true", "yes", "on", "1")
    if isinstance(d, int):
        try:
            v = int(v)
        except ValueError:
            die(f"{key} must be a number")
        if key == "nice" and not 0 <= v <= 19:
            die("nice must be between 0 and 19")
        return v
    if key in CHOICES and v not in CHOICES[key]:
        die(f"{key} must be one of: {', '.join(CHOICES[key])}")
    return v


def show(v):
    if isinstance(v, dict):
        return "; ".join(f"{k}: {', '.join(x) if isinstance(x, list) else x}" for k, x in v.items()) or "[dim](none)[/]"
    if isinstance(v, list):
        return ", ".join(v) if v else "[dim](none)[/]"
    if isinstance(v, bool):
        return "yes" if v else "no"
    return str(v) if v != "" else "[dim](none)[/]"


@cli.command(context_settings=dict(ignore_unknown_options=True))
@click.argument("key", required=False)
@click.argument("values", nargs=-1)
@click.option("--add", "add", multiple=True, metavar="VALUE", help="append to a list setting")
@click.option("--drop", "drop", multiple=True, metavar="VALUE", help="take a value out of a list setting")
@click.option("--unset", is_flag=True, help="reset KEY to its default")
@click.option("-e", "--edit", is_flag=True, help="open config.json in $EDITOR")
def config(key, values, add, drop, unset, edit):
    """Show or change settings:  config [KEY [VALUE...]]."""
    raw = raw_cfg()
    if edit:
        if not CONFIG.exists():
            save_cfg(dict(DEFAULTS))
        click.edit(filename=str(CONFIG))
        raw_cfg()                                       # validate
        return ok(f"saved {CONFIG}")
    if key is None:
        t = Table(box=None, padding=(0, 2), header_style="bold")
        for c in ("Key", "Value", ""):
            t.add_column(c)
        for k, d in DEFAULTS.items():
            t.add_row(f"[bold green]{k}[/]", show(raw.get(k, d)), "" if k in raw else "[dim]default[/]")
        out.print(t)
        return out.print(f"[dim]{CONFIG}  (config v{raw.get('config_version', CONFIG_VERSION)})"
                         f"  -  silo config KEY VALUE  /  --add / --drop / --unset / --edit[/]")
    if key not in DEFAULTS:
        die(f"unknown setting [bold]{key}[/]; one of: {', '.join(DEFAULTS)}")
    if unset:
        raw.pop(key, None)
    elif add or drop:
        if not isinstance(DEFAULTS[key], list):
            die(f"--add/--drop work on list settings, not {key}")
        cur = list(raw.get(key, DEFAULTS[key]))
        cur += [v for v in coerce(key, list(add)) if v not in cur]
        gone = coerce(key, list(drop))
        raw[key] = [v for v in cur if v not in gone]
    elif values:
        raw[key] = coerce(key, list(values))
    else:
        return out.print(show(raw.get(key, DEFAULTS[key])))
    if key == "ssh_keys" and (missing := [k for k in raw.get(key, []) if not (HOME / ".ssh" / k).is_file()]):
        die(f"not found in ~/.ssh: {', '.join(missing)}")
    save_cfg(raw)
    ok(f"{key} = {show(raw.get(key, DEFAULTS[key]))}")


# ---- usage limits: the endpoints behind claude's /usage and codex's rate-limit display ----
def get_json(url, headers):
    req = urllib.request.Request(url, headers={"User-Agent": f"silo/{VERSION}", **headers})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        if e.code == 429:
            wait = e.headers.get("Retry-After")
            raise RuntimeError(f"HTTP 429: rate limited, try again {f'in {wait}s' if wait else 'in a minute'}")
        raise RuntimeError("token expired; any run refreshes it" if e.code == 401 else f"HTTP {e.code}")
    except (OSError, ValueError) as e:
        raise RuntimeError(str(e))


def claude_usage(d):
    """[(window, percent used, reset epoch)] for the login in dir D."""
    c = json_file(d / ".credentials.json").get("claudeAiOauth", {})
    if not (tok := c.get("accessToken")):
        raise RuntimeError("not logged in")
    if c.get("expiresAt", 0) / 1000 < time.time() + 60:
        tok = claude_refresh(d, c)
    data = get_json("https://api.anthropic.com/api/oauth/usage",
                    {"Authorization": f"Bearer {tok}", "anthropic-beta": "oauth-2025-04-20"})
    if data.get("limits"):        # newer shape: one entry per limit, model-scoped ones named
        rows = []
        for l in data["limits"]:
            model = ((l.get("scope") or {}).get("model") or {}).get("display_name")
            win = {"session": "5h", "weekly": "7d"}.get(l.get("group"), l.get("group") or l.get("kind") or "?")
            rows.append((f"{win} {model}" if model else win, float(l.get("percent") or 0),
                         _epoch(l["resets_at"]) if l.get("resets_at") else None, WINDOW_SECS.get(win)))
        return rows
    names = {"five_hour": "5h", "seven_day": "7d", "seven_day_opus": "7d Opus", "seven_day_sonnet": "7d Sonnet"}
    return [(label, float(v["utilization"]), _epoch(v["resets_at"]) if v.get("resets_at") else None,
             WINDOW_SECS[label[:2]])
            for k, label in names.items() if isinstance(v := data.get(k), dict) and v.get("utilization") is not None]


WINDOW_SECS = {"5h": 5 * 3600, "7d": 7 * 86400}
# list prices (USD/month) for plans the endpoints name; what you actually pay may differ
PRICES = {"default_claude_max_20x": ("Max 20x", 200), "default_claude_max_5x": ("Max 5x", 100),
          "claude_pro": ("Pro", 20), "pro": ("Pro", 20), "max": ("Max", None),
          "plus": ("Plus", 20), "chatgpt_pro": ("Pro", 200), "team": ("Team", 30), "business": ("Business", 30),
          "enterprise": ("Enterprise", None), "free": ("Free", 0)}


def _date(ts):
    return time.strftime("%b %-d %Y", time.localtime(ts))


def _plan_line(key, status, ends, label_end):
    name, price = PRICES.get(key, (key.replace("_", " ").title() if key else "?", None))
    bits = [name, f"~${price}/mo list" if price else None, status]
    if ends:
        bits.append(f"{label_end} {_date(ends)}" if ends > time.time()
                    else f"[yellow]{label_end} {_date(ends)} (stale; a run refreshes it)[/]")
    return " · ".join(b for b in bits if b)


def claude_plan(d):
    tok = json_file(d / ".credentials.json").get("claudeAiOauth", {}).get("accessToken")
    if not tok:
        return None
    o = get_json("https://api.anthropic.com/api/oauth/profile",
                 {"Authorization": f"Bearer {tok}", "anthropic-beta": "oauth-2025-04-20"}).get("organization") or {}
    key = o.get("rate_limit_tier") if o.get("rate_limit_tier") in PRICES else o.get("organization_type", "")
    status = o.get("subscription_status")
    trial = o.get("claude_code_trial_ends_at")
    line = _plan_line(key, None if status == "active" else status, None, "")
    if o.get("subscription_created_at"):    # the API has no billing period or renewal date
        line += f" · since {_date(_epoch(o['subscription_created_at']))}"
    return line + (f" · trial ends {_date(_epoch(trial))}" if trial else "")


def codex_plan(d):
    tok = (json_file(d / "auth.json").get("tokens") or {}).get("id_token", "")
    try:
        p = tok.split(".")[1]
        a = json.loads(base64.urlsafe_b64decode(p + "=" * (-len(p) % 4))).get("https://api.openai.com/auth", {})
    except Exception:
        return None
    plan = a.get("chatgpt_plan_type")
    until = a.get("chatgpt_subscription_active_until")
    return _plan_line("chatgpt_pro" if plan == "pro" else plan, None, _epoch(until) if until else None,
                      "paid until") if plan else None


CLAUDE_OAUTH = ("https://platform.claude.com/v1/oauth/token", "9d1c250a-e61b-44d9-88ed-5944d1962f5e")


def claude_refresh(d, c):
    """renew an expired access token the way claude does and save it to the login (claude reloads
    the file when it changes).  Only expired tokens: a running claude refreshes before expiry."""
    if not c.get("refreshToken"):
        raise RuntimeError("token expired, no refresh token; log in again")
    body = json.dumps({"grant_type": "refresh_token", "refresh_token": c["refreshToken"],
                       "client_id": CLAUDE_OAUTH[1], "scope": " ".join(c.get("scopes") or [])}).encode()
    req = urllib.request.Request(CLAUDE_OAUTH[0], data=body, headers={
        "Content-Type": "application/json", "User-Agent": f"silo/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            t = json.loads(r.read())
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"token refresh refused (HTTP {e.code}); log in again")
    except (OSError, ValueError) as e:
        raise RuntimeError(f"token refresh failed: {e}")
    f = d / ".credentials.json"
    full = json_file(f)
    full["claudeAiOauth"] = {**c, "accessToken": t["access_token"],
                             "refreshToken": t.get("refresh_token") or c["refreshToken"],
                             "expiresAt": int((time.time() + t["expires_in"]) * 1000)}
    tmp = Path(f"{f}.silo-tmp")
    tmp.touch(mode=0o600)
    tmp.write_text(json.dumps(full))
    tmp.replace(f)
    return t["access_token"]


def codex_usage(d):
    t = json_file(d / "auth.json").get("tokens") or {}
    if not t.get("access_token"):
        raise RuntimeError("not logged in")
    h = {"Authorization": f"Bearer {t['access_token']}"}
    if t.get("account_id"):
        h["ChatGPT-Account-Id"] = t["account_id"]
    data = get_json("https://chatgpt.com/backend-api/wham/usage", h)
    rows = []

    def walk(o, name):
        if isinstance(o, dict):
            if o.get("used_percent") is not None:
                secs = o.get("limit_window_seconds") or 0
                win = f"{secs // 86400}d" if secs and secs % 86400 == 0 else f"{secs // 3600}h" if secs else "?"
                rows.append(((name + " " if name else "") + win, float(o["used_percent"]),
                             o.get("reset_at") or (time.time() + o["reset_after_seconds"]
                                                   if o.get("reset_after_seconds") else None), secs or None))
                return
            name = o.get("limit_name") or o.get("metered_feature") or name
            for k, v in o.items():
                walk(v, name)
        elif isinstance(o, list):
            for v in o:
                walk(v, name)
    walk(data.get("rate_limit"), "")
    for extra in data.get("additional_rate_limits") or []:   # per-model limits
        walk(extra, "")
    return rows


def _epoch(iso):
    from datetime import datetime
    return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()


def _until(ts):
    if not ts:
        return "[dim]-[/]"
    s = max(0, int(ts - time.time()))
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return f"{d}d {h}h" if d else f"{h}h {m:02d}m" if h else f"{m}m"


def _elapsed(reset, length):
    """fraction of the window gone, or None when the window is unknown."""
    if not (reset and length):
        return None
    return min(1.0, max(0.0, 1 - (reset - time.time()) / length))


def _bar(p, el, w=14):
    """two bars in one row of half blocks: usage on top, time gone underneath."""
    n = round(min(p, 100) / 100 * w)
    t = round(el * w) if el is not None else 0
    c = "red" if p >= 90 else "yellow" if p >= 70 else "green"
    cells = []
    for i in range(w):
        top = c if i < n else "grey23"
        bot = "grey62" if i < t else "grey23"
        cells.append(f"[{top} on {bot}]▀[/]")
    return "".join(cells) + f" {p:3.0f}%"


def _pace(p, el, reset, length):
    """how usage compares with the time gone, and when it runs out at this rate."""
    if el is None:
        return "[dim]-[/]"
    if p >= 100:
        return "[red]used up[/]"
    if el < 0.02:
        return "[dim]new window[/]"
    d = p - el * 100
    tag = (f"[red]fast +{d:.0f}%[/]" if d > 10 else f"[green]slow {d:.0f}%[/]" if d < -10
           else "[cyan]on pace[/]")
    if p > 0:
        out_at = time.time() + (100 - p) * el * length / p     # at the average rate so far
        if out_at < reset:
            tag += f" [red]· out in {_until(out_at)}[/]"
    return tag


@cli.command()
@click.option("-a", "--all", "every", is_flag=True, help="all tools, not just the selected one")
@click.pass_obj
def status(tool, every):
    """Usage limits (5h / weekly / per model) of every login."""
    jobs = []   # (tool, login name, dir); profiles from before 0.6 still hold their own credentials
    for tl in (TOOLS.values() if every else [tool]):
        if not tl.usage:
            continue
        seen = set()
        for ld in sorted((LOGINS / tl.bin).glob("*/")):
            jobs.append((tl, ld.name, ld))
            seen.add(ld.name)
        for d in sorted((ROOT / tl.bin).glob("*/")):
            cred = d / tl.cred
            if d.name not in seen and cred.exists() and not cred.is_symlink():
                jobs.append((tl, d.name, d))
    if not jobs:
        return out.print("[dim]no logins yet - try[/] login add NAME --current")
    res = [None] * len(jobs)

    age = [None] * len(jobs)
    plans = [None] * len(jobs)

    def fetch(i, tl, d):   # cached a minute; when the endpoint refuses (e.g. 429), the last answer
        f = STATE / "usage" / f"{tl.bin}-{jobs[i][1]}.json"
        cache = json_file(f)
        if cache and time.time() - cache["at"] < 60:
            res[i] = [tuple(x) for x in cache["rows"]]
            plans[i] = cache.get("plan")
            return
        if tl.plan:
            try:
                plans[i] = tl.plan(d)
            except RuntimeError:
                plans[i] = cache.get("plan")
        try:
            res[i] = tl.usage(d)
            f.parent.mkdir(parents=True, exist_ok=True)
            write_json(f, {"at": time.time(), "rows": res[i], "plan": plans[i]})
        except RuntimeError as e:
            res[i] = [tuple(x) for x in cache["rows"]] if cache and "HTTP" in str(e) else str(e)
            age[i] = cache and time.time() - cache["at"]
    th = [threading.Thread(target=fetch, args=(i, j[0], j[2])) for i, j in enumerate(jobs)]
    with out.status("asking for usage ..."):
        for t in th:
            t.start()
        for t in th:
            t.join()
    # one heading per login, then a short row per window: fits narrow terminals (the bar shrinks)
    w = max(5, min(20, out.width - 54))
    for (tl, name, d), r, a, pl in zip(jobs, res, age, plans):
        email = (tl.email and tl.email(d)) or ""
        stale = f"  [yellow](from {_until(time.time() + a)} ago)[/]" if a and isinstance(r, list) else ""
        out.print(f"[bold]{name}[/] [dim]{tl.bin}  {email}[/]{stale}", overflow="ellipsis", no_wrap=True)
        if pl:
            out.print(f"  [cyan]{pl}[/]", overflow="ellipsis", no_wrap=True)
        if isinstance(r, str) or not r:
            out.print(f"  [yellow]{r or 'no limits reported'}[/]")
            continue
        t = Table(box=None, padding=(0, 1), show_header=False, pad_edge=False)
        t.add_column(no_wrap=True)
        t.add_column(no_wrap=True)
        t.add_column(no_wrap=True, overflow="ellipsis")
        t.add_column(no_wrap=True, justify="right", min_width=6)
        for win, p, reset, length in r:
            el = _elapsed(reset, length)
            t.add_row(f"  {win}", _bar(p, el, w), _pace(p, el, reset, length), _until(reset))
        out.print(t)
    out.print("[dim]bars: top = used, bottom = time gone[/]")



# config.json carries its schema version and the oldest silo that understands it.
# Bump CONFIG_VERSION minor for added keys (older silo warns, keeps going), major for
# incompatible changes (older silo refuses); CONFIG_MIN_SILO is the silo release that
# introduced the current schema.
CONFIG_VERSION = "1.4"
CONFIG_MIN_SILO = "0.8.0"
META = ("config_version", "silo_min_version")


def read_cfg():
    """the file as written (no defaults, no env), after version checks."""
    try:
        raw = json.loads(CONFIG.read_text())
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise click.ClickException(f"Cannot read {CONFIG}: {e}") from e
    except ValueError as e:
        die(f"{CONFIG} is not valid JSON: {e}")
    if not isinstance(raw, dict):
        die(f"{CONFIG} must contain a JSON object")
    need = raw.get("silo_min_version", "0")
    if _vtuple(need) > _vtuple(VERSION):
        die(f"{CONFIG} needs silo >= {need} (you have {VERSION}); run [cyan]silo update[/]")
    have = raw.get("config_version", "0.0")
    if _vtuple(have)[:1] > _vtuple(CONFIG_VERSION)[:1]:
        die(f"{CONFIG} is config v{have}; this silo reads v{CONFIG_VERSION}. Run [cyan]silo update[/]")
    if _vtuple(have) > _vtuple(CONFIG_VERSION):
        err.print(f"[yellow]![/] config v{have} is newer than this silo (v{CONFIG_VERSION}); unknown keys are ignored")
    if "ssh_key" in raw:                                   # config 1.0: a single key
        old = raw.pop("ssh_key")
        raw.setdefault("ssh_keys", [old] if old else [])
    try:
        return Configuration.validate(raw)
    except ValueError as e:
        die(str(e))


def save_cfg(raw):
    """Validate and atomically save user settings, preserving unknown fields."""
    try:
        Configuration.save(raw)
    except (ValueError, OSError) as e:
        raise click.ClickException(str(e)) from e


def load_cfg(tool=None, name=None):
    cfg = Configuration.effective(read_cfg(), tool, name)
    if env := os.environ.get("SILO_SSH_KEYS") or os.environ.get("SILO_SSH_KEY"):
        cfg["ssh_keys"] = env.replace(",", " ").split()
    return cfg


def jwt_email(path):
    """email claim of the id_token in an OpenAI-style auth.json, or None."""
    try:
        tok = json.loads(Path(path).read_text())["tokens"]["id_token"].split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(tok + "=" * (-len(tok) % 4)))
        return claims.get("email") or claims.get("https://api.openai.com/profile", {}).get("email")
    except Exception:
        return None


def claude_email(d):
    try:
        return json.loads((d / ".claude.json").read_text())["oauthAccount"]["emailAddress"]
    except Exception:
        return None


def claude_binds(d):  # shared session registry + messaging sockets: sessions across profiles see each other
    socks = RUNTIME / "cc-socks"
    for p in (HOME / ".claude/sessions", d / "sessions", socks):
        p.mkdir(parents=True, exist_ok=True)
    return ["--bind", HOME / ".claude/sessions", d / "sessions", "--bind", socks, socks]


@dataclass
class Tool:
    bin: str
    env: str                      # env var naming the config dir
    home: Path                    # the tool's default config dir, seeded from
    copy: list = field(default_factory=list)   # files copied into a new profile (tool edits them)
    link: list = field(default_factory=list)   # files symlinked into a new profile (shared)
    login: list = field(default_factory=list)  # this machine's login files (always hidden)
    cred: str = ""                # credential file: lives in the login store, symlinked into the profile
    cred_env: str = ""            # env var relocating just the credential dir: per-run, no link in the profile
    acct: tuple = ()              # (key, state file name, this machine's state file): account record kept with the login
    login_cmd: str = ""           # how to log in
    email: object = None          # fn(config_dir) -> email or None
    binds: object = None          # fn(profile_dir) -> extra bwrap args
    setenv: dict = field(default_factory=dict)
    stop: list = field(default_factory=list)   # args to stop its background daemon before rm
    usage: object = None          # fn(login_dir) -> [(window, percent used, reset epoch)]
    plan: object = None           # fn(login_dir) -> one line: plan, list price, renewal/expiry

    def current_email(self):
        return self.email(self.home) if self.email else None



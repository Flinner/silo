def _date(ts):
    return time.strftime("%b %-d %Y", time.localtime(ts))


def plan_line(key, status, ends, label_end):
    name, price = PRICES.get(key, (key.replace("_", " ").title() if key else "?", None))
    bits = [name, f"~${price}/mo list" if price else None, status]
    if ends:
        bits.append(f"{label_end} {_date(ends)}" if ends > time.time()
                    else f"[yellow]{label_end} {_date(ends)} (stale; a run refreshes it)[/]")
    return " · ".join(b for b in bits if b)


class Harness:
    """The contract every agent CLI implements.  Adding an agent is one more subclass."""
    name = bin = config_env = ""
    home = None                   # the tool's default config dir, seeded from
    copy = ()                     # files copied into a new profile (the tool edits them)
    link = ()                     # files symlinked into a new profile (shared with `home`)
    cred = ""                     # credential file, kept in the login dir
    secrets = ()                  # this machine's login files: always hidden in the sandbox
    history = ()                  # what import-history copies
    env = {}
    login_cmd = ()
    stop_daemon_cmd = ()

    def native_home(self):
        return Path(os.environ.get(self.config_env, str(self.home))).expanduser()

    def native_login_home(self):
        return self.native_home()

    def seed_profile(self, d, state=False):
        """files a new profile starts with; STATE also brings this machine's tool state."""
        for f in self.copy:
            if (self.home / f).is_file():
                shutil.copy2(self.home / f, d / f)
        for f in self.link:
            if (self.home / f).exists():
                (d / f).symlink_to(self.home / f)

    def history_entries(self, source):
        return [p for p in (source / n for n in self.history) if p.exists() and not p.is_symlink()]

    def copy_entry(self, entry, target, source, dest):
        if entry.is_dir():
            shutil.copytree(entry, target, ignore=lambda d, names: [n for n in names if (Path(d) / n).is_symlink()])
        else:
            shutil.copy2(entry, target)

    def import_history(self, source, dest):
        """Copy history only; the source stays intact.  Returns the names copied."""
        source = Path(source).expanduser() if source else self.native_home()
        entries = self.history_entries(source)
        if not entries:
            raise ValueError(f"No {self.name} history found in {source}")
        if under(dest.resolve(), [source.resolve()]) or under(source.resolve(), [dest.resolve()]):
            raise ValueError("History source overlaps this profile")
        if conflicts := [p.name for p in entries if (dest / p.name).exists()]:
            raise ValueError("History already exists: " + ", ".join(conflicts) + "; import into a fresh profile")
        staging = ROOT / ".staging"
        staging.mkdir(parents=True, exist_ok=True, mode=0o700)
        published = []
        with tempfile.TemporaryDirectory(prefix="history-", dir=staging) as stage:
            try:
                for entry in entries:
                    self.copy_entry(entry, Path(stage) / entry.name, source, dest)
                for entry in entries:
                    (Path(stage) / entry.name).rename(dest / entry.name)
                    published.append(dest / entry.name)
            except BaseException:
                for p in published:
                    shutil.rmtree(p) if p.is_dir() else p.unlink(missing_ok=True)
                raise
        return [p.name for p in entries]

    def import_login(self, ld):
        """this machine's login -> login dir LD."""
        source = self.native_login_home() / self.cred
        if not source.is_file():
            raise ValueError(f"{self.name} is not logged in on this machine")
        ld.mkdir(parents=True, exist_ok=True, mode=0o700)
        shutil.copy2(source, ld / self.cred)
        (ld / self.cred).chmod(0o600)

    def login_args(self, profile_dir, ld):
        """bwrap args that let a run see login LD's credentials: a link in the profile by default."""
        cred = profile_dir / self.cred
        record = profile_dir / ".silo-login"
        if cred.exists() and not cred.is_symlink():      # the tool replaced the link: hand it back
            last = LOGINS / self.name / (record.read_text().strip() if record.exists() else ld.name)
            last.mkdir(parents=True, exist_ok=True, mode=0o700)
            shutil.move(cred, last / self.cred)
        cred.unlink(missing_ok=True)
        cred.symlink_to(ld / self.cred)
        record.write_text(ld.name)
        return ["--bind", ld, ld]

    def after_login(self, profile_dir, ld):
        """keep what a login run wrote in the throwaway profile."""
        cred = profile_dir / self.cred
        if cred.is_file() and not cred.is_symlink():
            shutil.copy2(cred, ld / self.cred)

    def sandbox_args(self, profile_dir):
        return []

    def daemon_alive(self, run_dir):
        return False

    background = ()               # argv[1] of the tool's own helper processes: (daemon, others to ignore)

    def env_login(self, env):
        """the login a running process uses, from its environment."""
        return None

    def processes(self):
        """[(pid, profile dir, login or None, "session" | "daemon")] of this tool, from /proc."""
        found = []
        for d in Path("/proc").iterdir():
            try:
                argv = (d / "cmdline").read_bytes().split(b"\0")
                if not d.name.isdigit() or Path(argv[0].decode()).name != self.bin:
                    continue
                env = dict(v.split("=", 1) for v in (d / "environ").read_bytes().decode(errors="replace").split("\0") if "=" in v)
            except (OSError, IndexError):
                continue
            arg = argv[1].decode(errors="replace") if len(argv) > 1 else ""
            if self.background and arg in self.background[1:]:
                continue
            if profile := env.get(self.config_env):
                kind = "daemon" if self.background and arg == self.background[0] else "session"
                found.append((int(d.name), profile, self.env_login(env), kind))
        return found

    def account(self, ld):
        return None

    def native_account(self):
        return self.account(self.native_login_home())

    def usage(self, ld):
        raise RuntimeError("usage unsupported")

    def plan(self, ld):
        return None


class Claude(Harness):
    name = bin = "claude"
    config_env = "CLAUDE_CONFIG_DIR"
    cred_env = "CLAUDE_SECURESTORAGE_CONFIG_DIR"     # claude refuses a symlinked credential file
    home = HOME / ".claude"
    copy = ("settings.json",)
    link = ("CLAUDE.md", "AGENTS.md", "skills")
    cred = ".credentials.json"
    secrets = (HOME / ".claude/.credentials.json", HOME / ".claude.json")
    history = ("projects", "file-history", "todos", "plans", "history.jsonl")
    env = {"DISABLE_AUTOUPDATER": "1"}
    login_cmd = ("auth", "login")
    stop_daemon_cmd = ("daemon", "stop", "--any")
    ONBOARDING = ("hasCompletedOnboarding", "lastOnboardingVersion", "theme", "bypassPermissionsModeAccepted",
                  "hasSeenTasksHint", "lastReleaseNotesSeen")
    OAUTH = ("https://platform.claude.com/v1/oauth/token", "9d1c250a-e61b-44d9-88ed-5944d1962f5e")
    API = "https://api.anthropic.com/api/oauth/"

    def state_file(self):
        """the default config dir keeps its state in ~/.claude.json (a ~/.claude/.claude.json is stale)."""
        home = self.native_home()
        return HOME / ".claude.json" if home == self.home else home / ".claude.json"

    def native_login_home(self):
        return Path(os.environ.get(self.cred_env, str(self.native_home()))).expanduser()

    def seed_profile(self, d, state=False):
        super().seed_profile(d)
        native = json_file(self.state_file())   # project trust etc., or at least the finished first-run setup
        state = native if state else {k: v for k, v in native.items() if k in self.ONBOARDING}
        if state:
            write_json(d / ".claude.json", {k: v for k, v in state.items() if k != "oauthAccount"})

    def import_login(self, ld):
        super().import_login(ld)
        if account := json_file(self.state_file()).get("oauthAccount"):
            write_json(ld / ".claude.json", {"oauthAccount": account})

    def login_args(self, profile_dir, ld):
        # claude re-fetches the account from its token at startup, so one shared .claude.json is fine
        return ["--bind", ld, ld, "--setenv", self.cred_env, ld]

    def after_login(self, profile_dir, ld):
        if account := json_file(profile_dir / ".claude.json").get("oauthAccount"):
            write_json(ld / ".claude.json", {"oauthAccount": account})

    def sandbox_args(self, profile_dir):
        """shared session registry + messaging sockets: sessions across profiles see each other."""
        socks = RUNTIME / "cc-socks"
        for p in (HOME / ".claude/sessions", profile_dir / "sessions", socks):
            p.mkdir(parents=True, exist_ok=True)
        return ["--bind", HOME / ".claude/sessions", profile_dir / "sessions", "--bind", socks, socks]

    def daemon_alive(self, run_dir):
        return any(alive(s) for s in (run_dir / "tmp").glob("cc-daemon-*/*/control.sock"))

    background = ("daemon", "bg-spare")

    def env_login(self, env):
        return Path(env[self.cred_env]).name if self.cred_env in env else None

    def account(self, ld):
        return (json_file(ld / ".claude.json").get("oauthAccount") or {}).get("emailAddress")

    def native_account(self):
        return (json_file(self.state_file()).get("oauthAccount") or {}).get("emailAddress")

    def token(self, ld):
        c = json_file(ld / self.cred).get("claudeAiOauth", {})
        if not c.get("accessToken"):
            raise RuntimeError("not logged in")
        return self.refresh(ld, c) if c.get("expiresAt", 0) / 1000 < time.time() + 60 else c["accessToken"]

    def refresh(self, ld, c):
        """renew an expired access token the way claude does and save it to the login (claude reloads
        the file when it changes).  Only expired tokens: a running claude refreshes before expiry."""
        if not c.get("refreshToken"):
            raise RuntimeError("token expired, no refresh token; log in again")
        body = json.dumps({"grant_type": "refresh_token", "refresh_token": c["refreshToken"],
                           "client_id": self.OAUTH[1], "scope": " ".join(c.get("scopes") or [])}).encode()
        req = urllib.request.Request(self.OAUTH[0], data=body, headers={
            "Content-Type": "application/json", "User-Agent": f"silo/{VERSION}"})
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                t = json.loads(r.read())
        except urllib.error.HTTPError as e:
            raise RuntimeError(f"token refresh refused (HTTP {e.code}); log in again")
        except (OSError, ValueError) as e:
            raise RuntimeError(f"token refresh failed: {e}")
        full = json_file(ld / self.cred)
        full["claudeAiOauth"] = {**c, "accessToken": t["access_token"],
                                 "refreshToken": t.get("refresh_token") or c["refreshToken"],
                                 "expiresAt": int((time.time() + t["expires_in"]) * 1000)}
        write_json(ld / self.cred, full)
        return t["access_token"]

    def get(self, ld, path):
        return get_json(self.API + path, {"Authorization": f"Bearer {self.token(ld)}",
                                          "anthropic-beta": "oauth-2025-04-20"})

    def usage(self, ld):
        data = self.get(ld, "usage")
        if data.get("limits"):        # newer shape: one entry per limit, model-scoped ones named
            rows = []
            for l in data["limits"]:
                model = ((l.get("scope") or {}).get("model") or {}).get("display_name")
                win = {"session": "5h", "weekly": "7d"}.get(l.get("group"), l.get("group") or l.get("kind") or "?")
                rows.append(Window(f"{win} {model}" if model else win, float(l.get("percent") or 0),
                                   _epoch(l["resets_at"]) if l.get("resets_at") else None, WINDOW_SECS.get(win)))
            return rows
        names = {"five_hour": "5h", "seven_day": "7d", "seven_day_opus": "7d Opus", "seven_day_sonnet": "7d Sonnet"}
        return [Window(label, float(v["utilization"]), _epoch(v["resets_at"]) if v.get("resets_at") else None,
                       WINDOW_SECS[label[:2]])
                for k, label in names.items() if isinstance(v := data.get(k), dict) and v.get("utilization") is not None]

    def plan(self, ld):
        o = self.get(ld, "profile").get("organization") or {}
        key = o.get("rate_limit_tier") if o.get("rate_limit_tier") in PRICES else o.get("organization_type", "")
        status, trial = o.get("subscription_status"), o.get("claude_code_trial_ends_at")
        line = plan_line(key, None if status == "active" else status, None, "")
        if o.get("subscription_created_at"):    # the API has no billing period or renewal date
            line += f" · since {_date(_epoch(o['subscription_created_at']))}"
        return line + (f" · trial ends {_date(_epoch(trial))}" if trial else "")


class Codex(Harness):
    name = bin = "codex"
    config_env = "CODEX_HOME"
    home = HOME / ".codex"
    copy = ("config.toml",)
    link = ("AGENTS.md",)
    cred = "auth.json"
    secrets = (HOME / ".codex/auth.json",)
    history = ("sessions", "archived_sessions", "history.jsonl", "session_index.jsonl")
    login_cmd = ("login",)

    def history_entries(self, source):
        db_home = Path(os.environ.get("CODEX_SQLITE_HOME", str(source))).expanduser()
        return super().history_entries(source) + sorted(db_home.glob("state_*.sqlite"))

    def copy_entry(self, entry, target, source, dest):
        if entry.suffix != ".sqlite":
            return super().copy_entry(entry, target, source, dest)
        # a consistent backup, with thread paths moved to the new profile
        with contextlib.closing(sqlite3.connect(entry.resolve().as_uri() + "?mode=ro", uri=True)) as original:
            with contextlib.closing(sqlite3.connect(target)) as copied:
                original.backup(copied)
                if "rollout_path" in [r[1] for r in copied.execute("PRAGMA table_info(threads)")]:
                    for row_id, rollout in copied.execute("SELECT rowid, rollout_path FROM threads").fetchall():
                        try:
                            relative = Path(rollout).relative_to(source)
                        except (ValueError, TypeError):
                            continue
                        copied.execute("UPDATE threads SET rollout_path=? WHERE rowid=?", (str(dest / relative), row_id))
                copied.commit()
        target.chmod(0o600)

    def sandbox_args(self, profile_dir):
        return ["--setenv", "CODEX_SQLITE_HOME", profile_dir]

    def tokens(self, ld):
        return json_file(ld / self.cred).get("tokens") or {}

    def account(self, ld):
        claims = jwt_claims(self.tokens(ld).get("id_token", ""))
        return claims.get("email") or claims.get("https://api.openai.com/profile", {}).get("email")

    def usage(self, ld):
        t = self.tokens(ld)
        if not t.get("access_token"):
            raise RuntimeError("not logged in")
        h = {"Authorization": f"Bearer {t['access_token']}"}
        if t.get("account_id"):
            h["ChatGPT-Account-Id"] = t["account_id"]
        data = get_json("https://chatgpt.com/backend-api/wham/usage", h)
        rows = []

        def walk(o, name):
            if isinstance(o, dict):
                if o.get("used_percent") is not None:
                    secs = o.get("limit_window_seconds") or 0
                    win = f"{secs // 86400}d" if secs and secs % 86400 == 0 else f"{secs // 3600}h" if secs else "?"
                    rows.append(Window((name + " " if name else "") + win, float(o["used_percent"]),
                                       o.get("reset_at") or (time.time() + o["reset_after_seconds"]
                                                             if o.get("reset_after_seconds") else None), secs or None))
                    return
                name = o.get("limit_name") or o.get("metered_feature") or name
                for v in o.values():
                    walk(v, name)
            elif isinstance(o, list):
                for v in o:
                    walk(v, name)
        walk(data.get("rate_limit"), "")
        for extra in data.get("additional_rate_limits") or []:   # per-model limits
            walk(extra, "")
        return rows

    def plan(self, ld):
        a = jwt_claims(self.tokens(ld).get("id_token", "")).get("https://api.openai.com/auth", {})
        plan, until = a.get("chatgpt_plan_type"), a.get("chatgpt_subscription_active_until")
        return plan_line("chatgpt_pro" if plan == "pro" else plan, None, _epoch(until) if until else None,
                         "paid until") if plan else None



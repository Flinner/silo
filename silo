CHOICES = {key: list(setting.choices) for key, setting in SETTINGS.items() if setting.choices}


def raw_cfg():
    return read_cfg()


def coerce(key, values):
    try:
        return Configuration.parse(key, values)
    except ValueError as e:
        die(str(e))


def show(v):
    if isinstance(v, dict):
        return "; ".join(f"{k}: {', '.join(x) if isinstance(x, list) else x}" for k, x in v.items()) or "[dim](none)[/]"
    if isinstance(v, list):
        return ", ".join(v) if v else "[dim](none)[/]"
    if isinstance(v, bool):
        return "yes" if v else "no"
    return str(v) if v != "" else "[dim](none)[/]"


@cli.command(context_settings=dict(ignore_unknown_options=True))
@click.argument("key", required=False)
@click.argument("values", nargs=-1)
@click.option("--add", "add", multiple=True, metavar="VALUE", help="append to a list setting")
@click.option("--drop", "drop", multiple=True, metavar="VALUE", help="take a value out of a list setting")
@click.option("--unset", is_flag=True, help="reset KEY to its default")
@click.option("--profile", "profile_name", metavar="NAME", help="edit sandbox settings for this profile")
@click.pass_obj
@click.option("-e", "--edit", is_flag=True, help="open config.json in $EDITOR")
def config(tool, key, values, add, drop, unset, edit, profile_name):
    """Show or change settings:  config [KEY [VALUE...]]."""
    global_raw = raw_cfg()
    if profile_name:
        call_operation(profile, tool, profile_name)
        raw = copy.deepcopy(global_raw.get("profile_settings", {}).get(f"{tool.bin}/{profile_name}", {}))
    else:
        raw = global_raw
    base = copy.deepcopy(raw)
    def persist(changed):
        if profile_name:
            call_operation(Configuration.commit_profile, tool, profile_name, base, changed)
        else:
            Configuration.commit(base, changed)
    if edit:
        edited = click.edit(json.dumps(raw, indent=2) + "\n", extension=".json")
        if edited is None:
            return
        try:
            changed = json.loads(edited)
            Configuration.validate(changed)
            persist(changed)
        except (ValueError, OSError) as e:
            raise click.ClickException(str(e)) from e
        return ok(f"saved {CONFIG}")
    if key is None:
        t = Table(box=None, padding=(0, 2), header_style="bold")
        for c in ("Key", "Value", ""):
            t.add_column(c)
        for k, d in DEFAULTS.items():
            if profile_name and SETTINGS[k].scope != "profile":
                continue
            t.add_row(f"[bold green]{k}[/]", show(raw.get(k, d)), SETTINGS[k].description + (" (default)" if k not in raw else ""))
        out.print(t)
        return out.print(f"[dim]{CONFIG}  (config v{raw.get('config_version', CONFIG_VERSION)})"
                         f"  -  silo config KEY VALUE  /  --add / --drop / --unset / --edit[/]")
    if key not in DEFAULTS:
        die(f"unknown setting [bold]{key}[/]; one of: {', '.join(DEFAULTS)}")
    if profile_name and SETTINGS[key].scope != "profile":
        raise click.ClickException(f"{key} is not a per-profile setting")
    if unset:
        raw.pop(key, None)
    elif add or drop:
        if not isinstance(DEFAULTS[key], list):
            die(f"--add/--drop work on list settings, not {key}")
        cur = list(raw.get(key, DEFAULTS[key]))
        cur += [v for v in coerce(key, list(add)) if v not in cur]
        gone = coerce(key, list(drop))
        raw[key] = [v for v in cur if v not in gone]
    elif values:
        raw[key] = coerce(key, list(values))
    else:
        return out.print(show(raw.get(key, DEFAULTS[key])))
    persist(raw)
    ok(f"{key} = {show(raw.get(key, DEFAULTS[key]))}")


# ---- usage limits: the endpoints behind claude's /usage and codex's rate-limit display ----
def get_json(url, headers):
    req = urllib.request.Request(url, headers={"User-Agent": f"silo/{VERSION}", **headers})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        if e.code == 429:
            wait = e.headers.get("Retry-After")
            raise RuntimeError(f"HTTP 429: rate limited, try again {f'in {wait}s' if wait else 'in a minute'}")
        raise RuntimeError("token expired; any run refreshes it" if e.code == 401 else f"HTTP {e.code}")
    except (OSError, ValueError) as e:
        raise RuntimeError(str(e))


def claude_usage(d):
    """[(window, percent used, reset epoch)] for the login in dir D."""
    c = json_file(d / ".credentials.json").get("claudeAiOauth", {})
    if not (tok := c.get("accessToken")):
        raise RuntimeError("not logged in")
    if c.get("expiresAt", 0) / 1000 < time.time() + 60:
        tok = claude_refresh(d, c)
    data = get_json("https://api.anthropic.com/api/oauth/usage",
                    {"Authorization": f"Bearer {tok}", "anthropic-beta": "oauth-2025-04-20"})
    if data.get("limits"):        # newer shape: one entry per limit, model-scoped ones named
        rows = []
        for l in data["limits"]:
            model = ((l.get("scope") or {}).get("model") or {}).get("display_name")
            win = {"session": "5h", "weekly": "7d"}.get(l.get("group"), l.get("group") or l.get("kind") or "?")
            rows.append((f"{win} {model}" if model else win, float(l.get("percent") or 0),
                         _epoch(l["resets_at"]) if l.get("resets_at") else None, WINDOW_SECS.get(win)))
        return rows
    names = {"five_hour": "5h", "seven_day": "7d", "seven_day_opus": "7d Opus", "seven_day_sonnet": "7d Sonnet"}
    return [(label, float(v["utilization"]), _epoch(v["resets_at"]) if v.get("resets_at") else None,
             WINDOW_SECS[label[:2]])
            for k, label in names.items() if isinstance(v := data.get(k), dict) and v.get("utilization") is not None]


WINDOW_SECS = {"5h": 5 * 3600, "7d": 7 * 86400}
# list prices (USD/month) for plans the endpoints name; what you actually pay may differ
PRICES = {"default_claude_max_20x": ("Max 20x", 200), "default_claude_max_5x": ("Max 5x", 100),
          "claude_pro": ("Pro", 20), "pro": ("Pro", 20), "max": ("Max", None),
          "plus": ("Plus", 20), "chatgpt_pro": ("Pro", 200), "team": ("Team", 30), "business": ("Business", 30),
          "enterprise": ("Enterprise", None), "free": ("Free", 0)}


def _date(ts):
    return time.strftime("%b %-d %Y", time.localtime(ts))


def _plan_line(key, status, ends, label_end):
    name, price = PRICES.get(key, (key.replace("_", " ").title() if key else "?", None))
    bits = [name, f"~${price}/mo list" if price else None, status]
    if ends:
        bits.append(f"{label_end} {_date(ends)}" if ends > time.time()
                    else f"[yellow]{label_end} {_date(ends)} (stale; a run refreshes it)[/]")
    return " · ".join(b for b in bits if b)


def claude_plan(d):
    tok = json_file(d / ".credentials.json").get("claudeAiOauth", {}).get("accessToken")
    if not tok:
        return None
    o = get_json("https://api.anthropic.com/api/oauth/profile",
                 {"Authorization": f"Bearer {tok}", "anthropic-beta": "oauth-2025-04-20"}).get("organization") or {}
    key = o.get("rate_limit_tier") if o.get("rate_limit_tier") in PRICES else o.get("organization_type", "")
    status = o.get("subscription_status")
    trial = o.get("claude_code_trial_ends_at")
    line = _plan_line(key, None if status == "active" else status, None, "")
    if o.get("subscription_created_at"):    # the API has no billing period or renewal date
        line += f" · since {_date(_epoch(o['subscription_created_at']))}"
    return line + (f" · trial ends {_date(_epoch(trial))}" if trial else "")


def codex_plan(d):
    tok = (json_file(d / "auth.json").get("tokens") or {}).get("id_token", "")
    try:
        p = tok.split(".")[1]
        a = json.loads(base64.urlsafe_b64decode(p + "=" * (-len(p) % 4))).get("https://api.openai.com/auth", {})
    except Exception:
        return None
    plan = a.get("chatgpt_plan_type")
    until = a.get("chatgpt_subscription_active_until")
    return _plan_line("chatgpt_pro" if plan == "pro" else plan, None, _epoch(until) if until else None,
                      "paid until") if plan else None


CLAUDE_OAUTH = ("https://platform.claude.com/v1/oauth/token", "9d1c250a-e61b-44d9-88ed-5944d1962f5e")


def claude_refresh(d, c):
    """renew an expired access token the way claude does and save it to the login (claude reloads
    the file when it changes).  Only expired tokens: a running claude refreshes before expiry."""
    if not c.get("refreshToken"):
        raise RuntimeError("token expired, no refresh token; log in again")
    body = json.dumps({"grant_type": "refresh_token", "refresh_token": c["refreshToken"],
                       "client_id": CLAUDE_OAUTH[1], "scope": " ".join(c.get("scopes") or [])}).encode()
    req = urllib.request.Request(CLAUDE_OAUTH[0], data=body, headers={
        "Content-Type": "application/json", "User-Agent": f"silo/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            t = json.loads(r.read())
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"token refresh refused (HTTP {e.code}); log in again")
    except (OSError, ValueError) as e:
        raise RuntimeError(f"token refresh failed: {e}")
    f = d / ".credentials.json"
    full = json_file(f)
    full["claudeAiOauth"] = {**c, "accessToken": t["access_token"],
                             "refreshToken": t.get("refresh_token") or c["refreshToken"],
                             "expiresAt": int((time.time() + t["expires_in"]) * 1000)}
    tmp = Path(f"{f}.silo-tmp")
    tmp.touch(mode=0o600)
    tmp.write_text(json.dumps(full))
    tmp.replace(f)
    return t["access_token"]


def codex_usage(d):
    t = json_file(d / "auth.json").get("tokens") or {}
    if not t.get("access_token"):
        raise RuntimeError("not logged in")
    h = {"Authorization": f"Bearer {t['access_token']}"}
    if t.get("account_id"):
        h["ChatGPT-Account-Id"] = t["account_id"]
    data = get_json("https://chatgpt.com/backend-api/wham/usage", h)
    rows = []

    def walk(o, name):
        if isinstance(o, dict):
            if o.get("used_percent") is not None:
                secs = o.get("limit_window_seconds") or 0
                win = f"{secs // 86400}d" if secs and secs % 86400 == 0 else f"{secs // 3600}h" if secs else "?"
                rows.append(((name + " " if name else "") + win, float(o["used_percent"]),
                             o.get("reset_at") or (time.time() + o["reset_after_seconds"]
                                                   if o.get("reset_after_seconds") else None), secs or None))
                return
            name = o.get("limit_name") or o.get("metered_feature") or name
            for k, v in o.items():
                walk(v, name)
        elif isinstance(o, list):
            for v in o:
                walk(v, name)
    walk(data.get("rate_limit"), "")
    for extra in data.get("additional_rate_limits") or []:   # per-model limits
        walk(extra, "")
    return rows


def _epoch(iso):
    from datetime import datetime
    return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()


def _until(ts):
    if not ts:
        return "[dim]-[/]"
    s = max(0, int(ts - time.time()))
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return f"{d}d {h}h" if d else f"{h}h {m:02d}m" if h else f"{m}m"


def _elapsed(reset, length):
    """fraction of the window gone, or None when the window is unknown."""
    if not (reset and length):
        return None
    return min(1.0, max(0.0, 1 - (reset - time.time()) / length))


def _bar(p, el, w=14):
    """two bars in one row of half blocks: usage on top, time gone underneath."""
    n = round(min(p, 100) / 100 * w)
    t = round(el * w) if el is not None else 0
    c = "red" if p >= 90 else "yellow" if p >= 70 else "green"
    cells = []
    for i in range(w):
        top = c if i < n else "grey23"
        bot = "grey62" if i < t else "grey23"
        cells.append(f"[{top} on {bot}]▀[/]")
    return "".join(cells) + f" {p:3.0f}%"


def _pace(p, el, reset, length):
    """how usage compares with the time gone, and when it runs out at this rate."""
    if el is None:
        return "[dim]-[/]"
    if p >= 100:
        return "[red]used up[/]"
    if el < 0.02:
        return "[dim]new window[/]"
    d = p - el * 100
    tag = (f"[red]fast +{d:.0f}%[/]" if d > 10 else f"[green]slow {d:.0f}%[/]" if d < -10
           else "[cyan]on pace[/]")
    if p > 0:
        out_at = time.time() + (100 - p) * el * length / p     # at the average rate so far
        if out_at < reset:
            tag += f" [red]· out in {_until(out_at)}[/]"
    return tag


@dataclass(frozen=True)
class UsageSnapshot:
    rows: tuple = ()
    plan: str = ""
    email: str = ""
    at: float = 0
    error: str = ""
    loading: bool = False


def usage_cache(tool, name):
    """Only usage metadata is cached, never authentication material."""
    raw = json_file(STATE / "usage" / f"{tool.bin}-{name}.json")
    try:
        rows = tuple((str(label), float(percent), float(reset) if reset else None,
                      float(length) if length else None) for label, percent, reset, length in raw["rows"])
        import math
        if any(not math.isfinite(number) for row in rows for number in row[1:] if number is not None):
            return UsageSnapshot()
        at = float(raw["at"])
        if not math.isfinite(at):
            return UsageSnapshot()
        return UsageSnapshot(rows, str(raw.get("plan") or ""), str(raw.get("email") or ""), at)
    except (KeyError, TypeError, ValueError):
        return UsageSnapshot()


def usage_error(error):
    """Do not display arbitrary exception text, which may contain request data."""
    text = str(error)
    if text == "not logged in":
        return text
    if "token expired" in text:
        return "token expired; authenticate again"
    if match := re.search(r"HTTP (\d{3})", text):
        return "HTTP " + match[1] + (" · rate limited" if match[1] == "429" else "")
    return "usage unavailable"


def fetch_usage(tool, name, directory=None, force=False):
    """The synchronous source used by status and the TUI's background workers."""
    validate_name(name)
    d = directory or LOGINS / tool.bin / name
    cached = usage_cache(tool, name)
    if not (d / tool.cred).is_file():
        return UsageSnapshot(error="not logged in")
    if not tool.usage:
        return UsageSnapshot(error="usage unsupported")
    if not force and cached.at and time.time() - cached.at < 60:
        return cached
    plan, email = cached.plan, cached.email
    try:
        rows = tuple(tuple(row) for row in tool.usage(d))
    except Exception as error:
        return UsageSnapshot(cached.rows, plan, email, cached.at, usage_error(error))
    # Plan/account lookup runs in the same worker and never touches curses.
    try:
        plan = (tool.plan(d) if tool.plan else None) or plan
        email = (tool.email(d) if tool.email else None) or email
    except Exception:
        pass
    snapshot = UsageSnapshot(rows, plan, email, time.time())
    parent = STATE / "usage"
    temporary = None
    try:
        parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", dir=parent, prefix=".usage-", delete=False) as f:
            temporary = Path(f.name)
            json.dump({"at": snapshot.at, "rows": rows, "plan": plan, "email": email}, f)
        temporary.replace(parent / f"{tool.bin}-{name}.json")
    except OSError:
        pass  # Cache failures must not hide successfully loaded usage.
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)
    return snapshot


class AsyncUsage:
    """Daemon workers publish immutable snapshots; launch/exit never join them."""
    def __init__(self):
        self.lock = threading.Lock()
        self.snapshots, self.pending, self.requested = {}, set(), {}
        self.closed = threading.Event()
        self.slots = threading.Semaphore(4)

    def snapshot(self, tool, name):
        with self.lock:
            return self.snapshots.get((tool.bin, name), UsageSnapshot(loading=True))

    def request(self, tool, name, force=False):
        key = (tool.bin, name)
        with self.lock:
            if self.closed.is_set() or key in self.pending:
                return
            if not force and key in self.requested and time.time() - self.requested[key] < 60:
                return
            cached = self.snapshots.get(key) or usage_cache(tool, name)
            self.requested[key] = time.time()
            if not (LOGINS / tool.bin / name / tool.cred).is_file():
                self.snapshots[key] = UsageSnapshot(error="not logged in")
                return
            if not force and cached.at and time.time() - cached.at < 60:
                self.snapshots[key] = cached
                self.requested[key] = cached.at
                return
            self.snapshots[key] = UsageSnapshot(cached.rows, cached.plan, cached.email, cached.at, cached.error, True)
            self.pending.add(key)
        def worker():
            try:
                with self.slots:
                    if self.closed.is_set():
                        return
                    result = fetch_usage(tool, name, force=force)
                with self.lock:
                    if not self.closed.is_set():
                        self.snapshots[key] = result
            except Exception:
                with self.lock:
                    if not self.closed.is_set():
                        self.snapshots[key] = UsageSnapshot(cached.rows, cached.plan, cached.email, cached.at, "usage unavailable")
            finally:
                with self.lock:
                    self.pending.discard(key)
        threading.Thread(target=worker, name=f"silo-usage-{tool.bin}-{name}", daemon=True).start()

    def close(self):
        self.closed.set()


class LauncherSelection:
    """The selected account determines the agent; history/account selections are independent."""
    def __init__(self, tool):
        self.tool = TOOLS[tool]
        self.focus = "profile"
        self.remembered_profiles = {}
        self.profile, self.login = Configuration.selections(self.tool)
        self.reload()

    def reload(self):
        self.accounts = [(tool.bin, d.name) for tool in TOOLS.values()
                         for d in sorted((LOGINS / tool.bin).glob("*/")) if d.is_dir()]
        if (self.tool.bin, self.login) not in self.accounts:
            preferred = (self.tool.bin, Configuration.selections(self.tool)[1])
            chosen = preferred if preferred in self.accounts else next(iter(self.accounts), None)
            if chosen:
                self.select_account(*chosen)
            else:
                self.login = None
        self.defaults = Configuration.selections(self.tool)
        self.profiles = profile_names(self.tool)
        if self.profile not in self.profiles:
            self.profile = self.defaults[0] if self.defaults[0] in self.profiles else next(iter(self.profiles), None)

    def select_account(self, tool_name, name):
        if tool_name != self.tool.bin:
            self.remembered_profiles[self.tool.bin] = self.profile
            preferred = self.remembered_profiles.get(tool_name, self.profile)
            self.tool = TOOLS[tool_name]
            profiles = profile_names(self.tool)
            default_profile = Configuration.selections(self.tool)[0]
            self.profile = preferred if preferred in profiles else default_profile if default_profile in profiles else next(iter(profiles), None)
        self.login = name

    def move(self, direction):
        if self.focus == "profile":
            if self.profiles:
                self.profile = self.profiles[(self.profiles.index(self.profile) + direction) % len(self.profiles)]
        elif self.accounts:
            index = self.accounts.index((self.tool.bin, self.login))
            self.select_account(*self.accounts[(index + direction) % len(self.accounts)])
            self.reload()

    def save_defaults(self):
        if not self.profile or not self.login:
            raise ValueError("Select an existing profile and login first")
        profile(self.tool, self.profile)
        if not (LOGINS / self.tool.bin / self.login).is_dir():
            raise ValueError("Add the selected login before saving it as the default")
        Configuration.set_defaults(self.tool, self.profile, self.login)
        self.defaults = (self.profile, self.login)


def profile_names(tool):
    return sorted(d.name for d in (ROOT / tool.bin).glob("*/") if d.is_dir() and not d.name.startswith(".auth-"))



@cli.command()
@click.option("-a", "--all", "every", is_flag=True, help="all tools, not just the selected one")
@click.pass_obj
def status(tool, every):
    """Usage limits (5h / weekly / per model) of every login."""
    jobs = []   # (tool, login name, dir); profiles from before 0.6 still hold their own credentials
    for tl in (TOOLS.values() if every else [tool]):
        if not tl.usage:
            continue
        seen = set()
        for ld in sorted((LOGINS / tl.bin).glob("*/")):
            jobs.append((tl, ld.name, ld))
            seen.add(ld.name)
        for d in sorted((ROOT / tl.bin).glob("*/")):
            cred = d / tl.cred
            if d.name not in seen and cred.exists() and not cred.is_symlink():
                jobs.append((tl, d.name, d))
    if not jobs:
        return out.print("[dim]no logins yet - try[/] login add NAME --current")
    snapshots = [None] * len(jobs)
    def fetch(i, tl, name, directory):
        snapshots[i] = fetch_usage(tl, name, directory)
    threads = [threading.Thread(target=fetch, args=(i, *job)) for i, job in enumerate(jobs)]
    with out.status("asking for usage ..."):
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join()
    # one heading per login, then a short row per window: fits narrow terminals (the bar shrinks)
    w = max(5, min(20, out.width - 54))
    for (tl, name, d), snapshot in zip(jobs, snapshots):
        if snapshot is None:
            snapshot = UsageSnapshot(error="usage unavailable")
        r, pl = snapshot.rows, snapshot.plan
        age = time.time() - snapshot.at if snapshot.at else 0
        stale = f"  [yellow](from {_until(time.time() + age)} ago)[/]" if snapshot.at and age >= 60 else ""
        out.print(f"[bold]{name}[/] [dim]{tl.bin}  {snapshot.email}[/]{stale}", overflow="ellipsis", no_wrap=True)
        if pl:
            out.print(f"  [cyan]{pl}[/]", overflow="ellipsis", no_wrap=True)
        if snapshot.error:
            out.print(f"  [yellow]{snapshot.error}[/]")
        if not r:
            if not snapshot.error:
                out.print("  [yellow]no limits reported[/]")
            continue
        t = Table(box=None, padding=(0, 1), show_header=False, pad_edge=False)
        t.add_column(no_wrap=True)
        t.add_column(no_wrap=True)
        t.add_column(no_wrap=True, overflow="ellipsis")
        t.add_column(no_wrap=True, justify="right", min_width=6)
        for win, p, reset, length in r:
            el = _elapsed(reset, length)
            t.add_row(f"  {win}", _bar(p, el, w), _pace(p, el, reset, length), _until(reset))
        out.print(t)
    out.print("[dim]bars: top = used, bottom = time gone[/]")


@cli.command("check-update")

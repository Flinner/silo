class RichHelp:
    def format_help(self, ctx, formatter):
        out.print(f"[bold cyan]{ctx.command_path}[/] [dim]{' '.join(self.collect_usage_pieces(ctx))}[/]")
        if isinstance(self, Cli):
            out.print("silo [claude|codex] [--profile NAME] [--login NAME] [TOOL ARGS]...", markup=False)
        if self.help:
            out.print(f"\n{self.help}\n")
        if isinstance(self, click.Group):
            t = Table(box=None, padding=(0, 2), show_header=False)
            for name, cmd in self.commands.items():
                if not cmd.hidden:
                    t.add_row(f"[bold green]{name}[/] [dim]{' '.join(cmd.collect_usage_pieces(ctx))}[/]", cmd.help or "")
            t.add_row("[bold green]TOOL[/] [dim][--profile NAME] [--login NAME] [TOOL ARGS]...[/]", "run an agent with the selected history and account")
            out.print(Panel(t, title="Commands", title_align="left", border_style="dim"))
            out.print(Panel(EXAMPLES, title="Examples", title_align="left", border_style="dim"))
            about = ABOUT.format(tools=", ".join(HARNESSES), envs=", ".join(h.config_env for h in HARNESSES.values()),
                                 aliases=", ".join(f"[bold]{a}[/]→{t}" for a, t in ALIASES.items()))
            out.print(Panel(about, title="How it works", title_align="left", border_style="dim"))
        opts = [p for p in self.params if isinstance(p, click.Option) and not p.hidden]
        if opts:
            t = Table(box=None, padding=(0, 2), show_header=False)
            if isinstance(self, Cli):
                t.add_row("[bold green](no arguments)[/]", "open the terminal menu")
                t.add_row("[bold green]--profile NAME[/]", "history to use (independent saved default, otherwise main)")
                t.add_row("[bold green]--login NAME[/]", "account to use (the profile's own, else the saved default)")
                t.add_row("[bold green]-h, --help[/]", "show this help")
            for p in opts:
                t.add_row("[bold green]" + ", ".join(p.opts) + "[/]", p.help or "")
            out.print(Panel(t, title="Options", title_align="left", border_style="dim"))


class Cmd(RichHelp, click.Command):
    pass


class Cli(RichHelp, click.Group):
    command_class = Cmd

    def parse_args(self, ctx, args):
        """`silo TOOL [--profile P] [--login L] [ARGS]` (or `silo TOOL LOGIN PROFILE ...`) -> `run`."""
        args = list(args)
        if args and args[0].split("=", 1)[0] in ("--profile", "--login"):
            args.insert(0, default_tool())
        if args and args[0] in HARNESSES:
            tool, rest = args[0], args[1:]
            if rest[:1] and (rest[0] in self.commands and rest[0] != "run" or rest[0] in ("-h", "--help", "-V", "--version")):
                args = ["--tool", tool, *rest]
            else:
                selectors, forwarded = {}, []
                while rest:
                    arg = rest.pop(0)
                    if arg == "--":
                        forwarded.extend([arg, *rest])
                        break
                    key = arg.split("=", 1)[0]
                    if key in ("--profile", "--login"):
                        if "=" in arg:
                            value = arg.split("=", 1)[1]
                        elif rest and not rest[0].startswith("-"):
                            value = rest.pop(0)
                        else:
                            raise click.UsageError(f"{key} requires a name", ctx)
                        if not value:
                            raise click.UsageError(f"{key} requires a non-empty name", ctx)
                        selectors[key] = value
                    else:
                        forwarded.append(arg)
                rest, names = forwarded, []
                while not selectors and rest and not rest[0].startswith("-") and len(names) < 2:
                    names.append(rest.pop(0))
                login = selectors.get("--login", names[0] if names else None)
                history = selectors.get("--profile", names[1] if len(names) > 1 else None)
                if rest[:1] == ["--"]:
                    rest = rest[1:]
                args = ["--tool", tool, "run", history or call(Config.defaults, HARNESSES[tool])[0],
                        *(["--login", login] if login else []), *rest]
        return super().parse_args(ctx, args)

    def resolve_command(self, ctx, args):  # unknown subcommand == profile name
        if args and args[0] not in self.commands and not args[0].startswith("-"):
            return "run", run, args
        return super().resolve_command(ctx, args)


@click.group(cls=Cli, context_settings=dict(help_option_names=["-h", "--help"]), invoke_without_command=True)
@click.option("-t", "--tool", type=click.Choice(list(HARNESSES)), default=default_tool,
              show_default=True, help="which agent CLI")
@click.version_option(VERSION, "-V", "--version", prog_name="silo")
@click.pass_context
def cli(ctx, tool):
    """Open the terminal menu, or run an agent directly under a sandboxed account."""
    ctx.obj = HARNESSES[tool]
    if ctx.invoked_subcommand not in (None, "run", "update", "check-update", "_broker", "config", "tui"):
        ctx.call_on_close(auto_check)
    if ctx.invoked_subcommand is None:
        open_tui(tool)


@cli.command(cls=Cmd, context_settings=dict(ignore_unknown_options=True, allow_extra_args=True), hidden=True)
@click.argument("name")
@click.argument("args", nargs=-1, type=click.UNPROCESSED)
@click.pass_obj
def run(h, name, args):
    args, login = list(args), None
    if args[:1] == ["--login"] and len(args) > 1:
        login, args = args[1], args[2:]
    elif args[:1] and args[0].startswith("--login="):
        login, args = args[0].split("=", 1)[1], args[1:]
    argv = call(ops.argv, h, name, login, args)
    os.execvp(argv[0], argv)



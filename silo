def launch_argv(tool, name, login=None, args=()):
    name, login = Configuration.launch(tool, name, login)
    profile(tool, name)
    if not (LOGINS / tool.bin / login).is_dir():
        raise ValueError(f"no {tool.bin} login {login}; add it first")
    cmd = [os.environ.get("SHELL", "/bin/sh")] if list(args) == ["--shell"] else [tool.bin, *args]
    return limits(load_cfg(tool, name)) + sandbox(tool, name, login) + cmd


def run_authentication(tool, login):
    """Authenticate an account without creating or using persistent conversation history."""
    validate_name(login)
    ld = LOGINS / tool.bin / login
    if not ld.is_dir():
        raise ValueError(f"no {tool.bin} login {login}; add it first")
    parent = ROOT / tool.bin
    parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".auth-", dir=parent) as temporary:
        d = Path(temporary)
        try:
            for f in tool.copy:
                if (tool.home / f).is_file():
                    shutil.copy2(tool.home / f, d / f)
            for f in tool.link:
                if (tool.home / f).exists():
                    (d / f).symlink_to(tool.home / f)
            result = subprocess.run(launch_argv(tool, d.name, login, tool.login_cmd.split())).returncode
            # Some agents replace credential symlinks by renaming new files over them.
            runtime = runtime_dir_from_key(tool, runtime_key(d.name, login))
            cred = runtime / tool.cred
            if cred.is_file() and not cred.is_symlink():
                shutil.copy2(cred, ld / tool.cred)
            if tool.acct:
                key, filename, _ = tool.acct
                if account := json_file(runtime / filename).get(key):
                    write_json(ld / filename, {key: account})
            return result
        finally:
            key = runtime_key(d.name, login)
            stop_ssh(tool, key)
            (STATE / "logins" / f"{tool.bin}-{key}").unlink(missing_ok=True)
            shutil.rmtree(ROOT / ".runs" / tool.bin / d.name, ignore_errors=True)


def delete_profile(tool, name):
    d = profile(tool, name)
    if tool.stop and daemon_alive(d):
        subprocess.run(sandbox(tool, name) + [tool.bin, *tool.stop], stdin=subprocess.DEVNULL)
    stop_ssh(tool, name)
    shutil.rmtree(d)
    ln = login_of(tool, name)
    (STATE / "logins" / f"{tool.bin}-{name}").unlink(missing_ok=True)
    if f"{tool.bin}/{name}" in read_cfg().get("logins", {}):
        set_login(tool, name, name)
    return f"removed {tool.bin} profile [bold]{name}[/]  (login [bold]{ln}[/] kept; see [cyan]login ls[/])"


def rename_profile(tool, name, new_name):
    d = profile(tool, name)
    validate_name(new_name)
    target = ROOT / tool.bin / new_name
    if target.exists():
        raise ValueError(f"profile {new_name} already exists")
    if daemon_alive(d):
        raise ValueError("Stop this profile's background daemon before renaming it")
    old_login = read_cfg().get("logins", {}).get(f"{tool.bin}/{name}")
    stop_ssh(tool, name)
    d.rename(target)
    try:
        raw = read_cfg()
        mapping = dict(raw.get("logins", {}))
        mapping.pop(f"{tool.bin}/{name}", None)
        if old_login is not None and old_login != new_name:
            mapping[f"{tool.bin}/{new_name}"] = old_login
        raw["logins"] = mapping
        overrides = dict(raw.get("profile_settings", {}))
        if f"{tool.bin}/{name}" in overrides:
            overrides[f"{tool.bin}/{new_name}"] = overrides.pop(f"{tool.bin}/{name}")
        raw["profile_settings"] = overrides
        if raw.get("default_profiles", {}).get(tool.bin) == name:
            raw["default_profiles"] = {**raw["default_profiles"], tool.bin: new_name}
        Configuration.save(raw)
    except BaseException:
        target.rename(d)
        raise
    (STATE / "logins" / f"{tool.bin}-{name}").unlink(missing_ok=True)


# ---- interactive prompts (prompt_toolkit when on a tty, plain input otherwise) ----
def ask(label, default="", paths=False, words=()):
    if sys.stdin.isatty():
        from prompt_toolkit import prompt
        from prompt_toolkit.completion import PathCompleter, WordCompleter
        from prompt_toolkit.key_binding import KeyBindings
        from prompt_toolkit.key_binding.bindings.completion import generate_completions
        comp = PathCompleter(expanduser=True) if paths else WordCompleter(list(words)) if words else None
        kb = KeyBindings()

        @kb.add("tab")
        def _(event):  # complete / cycle like readline; never insert a literal tab
            if comp:
                generate_completions(event)

        return prompt(f"{label} ", default=default, completer=comp, key_bindings=kb,
                      complete_while_typing=bool(words)).strip()
    out.print(f"{label} [dim]{default}[/]", end=" ")
    return (input() or default).strip()


# ---- updates (never silent: `ask` prints a hint, `always` installs, `never` skips) ----
def _vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v)[:3])


def fetch_remote(quiet=False):
    try:
        with urllib.request.urlopen(RAW_SELF_URL, timeout=5) as r:
            text = r.read().decode()
    except OSError as e:
        if quiet:
            raise
        die(f"could not fetch {RAW_SELF_URL}: {e}")
    m = re.search(r'^VERSION = "([^"]+)"', text, re.M)
    if not m or not text.startswith("#!/usr/bin/env python3"):
        die("fetched script has no VERSION marker; refusing to trust it")
    return m[1], text


def install_update(text, remote):
    me = Path(os.path.realpath(sys.argv[0]))
    if (me.parent / ".git").exists():
        die(f"{me} is a git checkout; update it with [cyan]git -C {me.parent} pull[/]")
    try:
        compile(text, "silo", "exec")
    except SyntaxError:
        die("downloaded script does not compile; not installed")
    tmp = me.with_name(me.name + ".new")
    tmp.write_text(text)
    tmp.chmod(me.stat().st_mode)
    tmp.replace(me)                    # atomic rename over the old version
    ok(f"updated v{VERSION} → v{remote}  ({me})")


def auto_check():
    """at most daily, after a command; network failures are silent."""
    mode = load_cfg()["check_updates"]
    stamp = STATE / "last-update-check"
    if mode == "never" or not sys.stderr.isatty():
        return
    try:
        if time.time() - stamp.stat().st_mtime < 86400:
            return
    except OSError:
        pass
    STATE.mkdir(parents=True, exist_ok=True)
    stamp.touch()
    try:
        remote, text = fetch_remote(quiet=True)
    except BaseException:
        return
    if _vtuple(remote) > _vtuple(VERSION):
        if mode == "always":
            install_update(text, remote)
        else:
            err.print(f"[yellow]↑[/] silo v{remote} is available (you have v{VERSION}) - run [cyan]silo update[/]")


def choose(label, choices, default):
    """ask until the answer is one of choices (Tab completes)."""
    while (v := ask(f"{label} ({' / '.join(choices)}):", default=default, words=choices)) not in choices:
        err.print(f"    [yellow]pick one of: {', '.join(choices)}[/]")
    return v


def number(label, default, lo, hi):
    while True:
        v = ask(label, default=str(default))
        if v.isdigit() and lo <= int(v) <= hi:
            return int(v)
        err.print(f"    [yellow]a number from {lo} to {hi}[/]")


def keep_list(current, keep_label):
    """show the list; one question keeps it all, 'n' goes item by item."""
    if not current:
        return []
    out.print("    " + ", ".join(f"[cyan]{c}[/]" for c in current))
    if click.confirm(f"  keep {'this' if len(current) == 1 else f'these {len(current)}'}?", default=True):
        return list(current)
    return [c for c in current if click.confirm(f"    {keep_label} {c}?", default=True)]


def path_list(intro, current, keep_label, add_label):
    out.print(intro)
    vals = keep_list(current, keep_label)
    while p := ask(f"  {add_label}", paths=True):
        if not Path(p).expanduser().exists():
            out.print(f"    [yellow]note:[/] {p} does not exist (skipped while it doesn't)")
        vals.append(p.replace(str(HOME), "~", 1) if p.startswith(str(HOME)) else p)
    return vals



@click.argument("args", nargs=-1, type=click.UNPROCESSED)
@click.pass_obj
def run(tool, name, args):
    args, login = list(args), None
    if args[:1] == ["--login"] and len(args) > 1:
        login, args = args[1], args[2:]
    elif args[:1] and args[0].startswith("--login="):
        login, args = args[0].split("=", 1)[1], args[1:]
    if login is None:
        login = read_cfg().get("logins", {}).get(f"{tool.bin}/{name}")
    argv = call_operation(launch_argv, tool, name, login, args)
    os.execvp(argv[0], argv)


IONICE = {"idle": ["-c", "3"], "low": ["-c", "2", "-n", "7"], "normal": []}


def limits(cfg):
    """prefix argv: memory cap via a systemd user scope (covers every child, background agents
    included), then nice + ionice.  Missing pieces degrade with a warning, never block the run."""
    pre = []
    mem, swap = str(cfg["memory_max"]).strip(), str(cfg["swap_max"]).strip()
    if mem or swap:
        if shutil.which("systemd-run") and subprocess.run(
                ["systemd-run", "--user", "--scope", "--quiet", "true"], capture_output=True).returncode == 0:
            pre += ["systemd-run", "--user", "--scope", "--quiet", "--collect"]
            pre += ["-p", f"MemoryMax={mem}"] if mem else []
            pre += ["-p", f"MemorySwapMax={swap}"] if swap else []
        else:
            err.print("[yellow]![/] memory limit skipped: no systemd user session (systemd-run --user)")
    if int(cfg["nice"] or 0):
        pre += ["nice", "-n", str(int(cfg["nice"]))]
    if IONICE.get(cfg["ionice"]) and shutil.which("ionice"):
        pre += ["ionice", *IONICE[cfg["ionice"]]]
    return pre



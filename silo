        raise ValueError(f"{tool.bin} login {name} already exists")
    if current:
        if not (native_login_home(tool) / tool.cred).is_file():
            raise ValueError(f"{tool.bin} is not logged in on this machine")
        import_login(tool, name)
    else:
        ld.mkdir(parents=True, mode=0o700)

class RichHelp:
    def format_help(self, ctx, formatter):
        out.print(f"[bold cyan]{ctx.command_path}[/] [dim]{' '.join(self.collect_usage_pieces(ctx))}[/]")
        if self.help:
            out.print(f"\n{self.help}\n")
        if isinstance(self, click.Group):
            t = Table(box=None, padding=(0, 2), show_header=False)
            for name, cmd in self.commands.items():
                if not cmd.hidden:
                    t.add_row(f"[bold green]{name}[/] [dim]{' '.join(cmd.collect_usage_pieces(ctx))}[/]", cmd.help or "")
            t.add_row("[bold green]NAME[/] [dim][TOOL ARGS]...[/]", "run the tool as profile NAME (any of its flags work)")
            t.add_row("[bold green]NAME[/] [dim]--shell[/]", "a shell inside NAME's sandbox, for debugging")
            out.print(Panel(t, title="Commands", title_align="left", border_style="dim"))
            out.print(Panel(EXAMPLES, title="Examples", title_align="left", border_style="dim"))
            about = ABOUT.format(tools=", ".join(TOOLS), envs=", ".join(t.env for t in TOOLS.values()),
                                 aliases=", ".join(f"[bold]{a}[/]→{t}" for a, t in ALIASES.items()))
            out.print(Panel(about, title="How it works", title_align="left", border_style="dim"))
        opts = [p for p in self.params if isinstance(p, click.Option) and not p.hidden]
        if opts:
            t = Table(box=None, padding=(0, 2), show_header=False)
            for p in opts:
                t.add_row("[bold green]" + ", ".join(p.opts) + "[/]", p.help or "")
            out.print(Panel(t, title="Options", title_align="left", border_style="dim"))


class Cmd(RichHelp, click.Command):
    pass


class Cli(RichHelp, click.Group):
    command_class = Cmd

    def resolve_command(self, ctx, args):  # unknown subcommand == profile name
        if args and args[0] not in self.commands and not args[0].startswith("-"):
            return "run", run, args
        return super().resolve_command(ctx, args)


def profile(tool, name):
    d = ROOT / tool.bin / name
    if not d.is_dir():
        die(f"no {tool.bin} profile [bold]{name}[/]  (see [cyan]ls[/] / [cyan]new[/])")
    return d


# ---- logins: credentials live in LOGINS/<tool>/<login>, apart from a profile's history ----
def login_of(tool, name):
    """the login profile NAME runs with by default (its own name unless `login use` changed it)."""
    return load_cfg()["logins"].get(f"{tool.bin}/{name}", name)


def set_login(tool, name, login):
    raw = read_cfg()
    m = {k: v for k, v in raw.get("logins", {}).items() if k != f"{tool.bin}/{name}"}
    raw["logins"] = {**m, f"{tool.bin}/{name}": login} if login != name else m
    save_cfg(raw)


def login_users(tool, login):
    return [p.name for p in sorted((ROOT / tool.bin).glob("*/")) if login_of(tool, p.name) == login]


def json_file(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}


def write_json(path, data):
    tmp = Path(f"{path}.silo-tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(path)


def import_login(tool, login):
    """copy this machine's current login into the store as LOGIN."""
    ld = LOGINS / tool.bin / login
    ld.mkdir(parents=True, exist_ok=True, mode=0o700)
    shutil.copy2(tool.home / tool.cred, ld)
    if tool.acct and (a := json_file(tool.acct[2]).get(tool.acct[0])):
        write_json(ld / tool.acct[1], {tool.acct[0]: a})


def attach(tool, name, d, login):
    """point profile NAME at LOGIN for one run: the tool reads its credentials from the login's dir
    (via cred_env, else a symlink in the profile) and the account record is swapped in.  What the previous run left behind goes back to the login it used."""
    last_f = STATE / "logins" / f"{tool.bin}-{name}"
    try:
        last = last_f.read_text().strip()
    except OSError:
        last = login_of(tool, name)
    old = LOGINS / tool.bin / last
    cred = d / tool.cred
    if cred.exists() and not cred.is_symlink():          # pre-0.6 profile, or the tool replaced the link
        old.mkdir(parents=True, exist_ok=True, mode=0o700)
        shutil.move(cred, old / tool.cred)
    ld = LOGINS / tool.bin / login
    ld.mkdir(parents=True, exist_ok=True, mode=0o700)
    if tool.acct:
        key, fn, _ = tool.acct
        state = json_file(d / fn)
        if state.get(key) and old.is_dir() and not json_file(old / fn).get(key):   # a fresh login's record
            write_json(old / fn, {key: state[key]})
        if (d / fn).exists() or json_file(ld / fn):
            acct = json_file(ld / fn).get(key)
            write_json(d / fn, {**state, key: acct} if acct else {k: v for k, v in state.items() if k != key})
    if cred.is_symlink():
        cred.unlink()
    if not tool.cred_env:
        cred.symlink_to(ld / tool.cred)
    last_f.parent.mkdir(parents=True, exist_ok=True)
    last_f.write_text(login)
    return ["--bind", ld, ld] + (["--setenv", tool.cred_env, ld] if tool.cred_env else [])


def daemon_alive(d):
    return any(alive(s) for s in (d / "tmp").glob("cc-daemon-*/*/control.sock"))


def ro_data(args, data: bytes, dest: Path, perms="0600"):
    """Bind a generated file read-only at dest (via an inherited pipe fd)."""
    r, w = os.pipe()
    os.write(w, data)
    os.close(w)
    os.set_inheritable(r, True)
    args += ["--perms", perms, "--ro-bind-data", str(r), str(dest)]


# ---- ssh broker -------------------------------------------------------------
# Inside the sandbox ~/.ssh is empty and /usr/bin/ssh is SHIM: it passes its argv and
# stdin/stdout/stderr (fds, so ttys work) to a host-side broker, which vets the args and
# runs the real ssh with a per-profile ssh-agent holding only the chosen key and (optionally)
# your ~/.ssh/config stripped of identity lines.  The agent can use ssh but read neither.
SSH_ARG_OPTS = set("BbcDEeFIiJLlmOoPpQRSWw")       # ssh options taking a value
SSH_BLOCKED = set("FiIESGJOwv")                      # host-file access, config dump, jumps, debug
SAFE_O = {"batchmode", "connecttimeout", "serveraliveinterval", "serveralivecountmax",
          "stricthostkeychecking", "requesttty", "forwardagent", "forwardx11", "permitlocalcommand",
          "clearallforwardings", "remotecommand", "controlmaster", "sendenv", "compression",
          "loglevel", "port", "user", "exitonforwardfailure", "setenv"}
SAFE_O_VALUES = {"forwardagent": {"no"}, "forwardx11": {"no"}, "permitlocalcommand": {"no"},
                 "remotecommand": {"none"}, "controlmaster": {"no"}, "sendenv": {"git_protocol"}}
SHIM = """#!/usr/bin/python3 -I
import json, os, socket, sys
s = socket.socket(socket.AF_UNIX)
try:
    s.connect({sock!r})
except OSError as e:
    sys.exit(f"{cmd} (sandbox): broker unavailable: {{e}}")
req = {{"cmd": {cmd!r}, "argv": sys.argv[1:], "term": os.environ.get("TERM", ""), "cwd": os.getcwd()}}
socket.send_fds(s, [json.dumps(req).encode()], [0, 1, 2])
data = b""
while chunk := s.recv(4096):
    data += chunk
sys.exit(json.loads(data or b'{{"rc": 255}}')["rc"])
"""


def ssh_vet(argv, cfg):
    """None if ok, else the reason argv is refused."""
    dest, i = None, 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            dest = dest or (argv[i + 1] if i + 1 < len(argv) else None)
            break
        if a.startswith("-") and len(a) > 1:
            j = 1
            while j < len(a):
                c = a[j]
                if c in SSH_BLOCKED:
                    return f"option -{c} is not allowed in the sandbox"
                if c in SSH_ARG_OPTS:
                    val = a[j + 1:] or (argv[i + 1] if i + 1 < len(argv) else "")
                    if not a[j + 1:]:
                        i += 1
                    if c == "o":
                        k, _, v = val.replace(" ", "=", 1).partition("=")
                        k, v = k.strip().lower(), v.strip().lower()
                        if k not in SAFE_O or (k in SAFE_O_VALUES and v not in SAFE_O_VALUES[k]):
                            return f"-o {val} is not allowed in the sandbox"
                    if c in "LRD" and "/" in val:
                        return "unix-socket forwarding is not allowed in the sandbox"
                    break
                j += 1
        elif dest is None:
            dest = a
        else:
            break                               # rest is the remote command
        i += 1
    if not dest:
        return None                             # e.g. `ssh -V`; ssh prints usage itself
    host = re.sub(r"^ssh://", "", dest).rsplit("@", 1)[-1]
    host = re.sub(r":\d+$", "", host).strip("[]")
    allowed = cfg["ssh_hosts"]
    if allowed and not any(fnmatch.fnmatch(host, pat) for pat in allowed):
        return f"host '{host}' is not in the allowed list ({', '.join(allowed)}); see `init`"
    return None


def alive(path):
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(0.3)
            s.connect(str(path))
            return True
    except OSError:
        return False


def rtdir(tool, name):  # host-only state; $XDG_RUNTIME_DIR is hidden from the sandbox
    d = RUNTIME / "silo" / f"{tool.bin}-{name}"
    d.mkdir(parents=True, exist_ok=True, mode=0o700)
    return d


def ensure_broker(tool, name, cfg):
    """start the profile's ssh-agent (if a key is set) + broker if needed; return the broker socket."""
    rt, d = rtdir(tool, name), profile(tool, name)
    agent = rt / "agent.sock"
    keys, state = cfg["ssh_keys"], rt / "agent.keys"
    try:
        loaded = json.loads(state.read_text()) if alive(agent) else []
    except (OSError, ValueError):
        loaded = []
    if set(loaded) - set(keys):                            # a key was dropped: start a clean agent
        try:
            os.kill(int((rt / "agent.pid").read_text()), signal.SIGTERM)
        except (OSError, ValueError):
            pass
        loaded = []
        for _ in range(20):
            if not alive(agent):
                break
            time.sleep(0.05)
    if keys and not alive(agent):
        agent.unlink(missing_ok=True)
        r = subprocess.run(["ssh-agent", "-s", "-a", agent], capture_output=True, text=True, check=True)
        (rt / "agent.pid").write_text(re.search(r"SSH_AGENT_PID=(\d+)", r.stdout)[1])
        loaded = []
    env = {**os.environ, "SSH_AUTH_SOCK": str(agent)}
    for k in keys:
        if k not in loaded:
            subprocess.run(["ssh-add", "-q", HOME / ".ssh" / k], env=env, check=True)
            loaded.append(k)
    state.write_text(json.dumps(loaded))
    sock = d / "ssh.sock"
    if not alive(sock):
        sock.unlink(missing_ok=True)
        subprocess.Popen([sys.executable, os.path.realpath(sys.argv[0]), "-t", tool.bin, "_broker", name],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=open(rt / "broker.log", "a"))
        for _ in range(50):
            if alive(sock):
                break
            time.sleep(0.05)
        else:
            die(f"broker did not start; see {rt / 'broker.log'}")
    return sock


def broker_serve(tool, name):
    rt, d = rtdir(tool, name), profile(tool, name)
    sock = d / "ssh.sock"
    sock.unlink(missing_ok=True)
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(str(sock))
    os.chmod(sock, 0o600)
    srv.listen()
    (rt / "broker.pid").write_text(str(os.getpid()))

    def handle(conn):
        fds = []
        try:
            msg, fds, _, _ = socket.recv_fds(conn, 1 << 20, 3)
            req = json.loads(msg)
            cfg = load_cfg()
            cmd = req.get("cmd", "ssh")
            if cmd != "ssh":
                why = cmd_vet(cmd, req["argv"], req.get("cwd", ""), cfg, rt)
                if why:
                    os.write(fds[2], f"{cmd} (sandbox): {why}\n".encode())
                    rc = 126
                else:
                    env = {**os.environ, "TERM": req.get("term") or "dumb"}
                    p = subprocess.Popen([shutil.which(cmd), *req["argv"]], cwd=req["cwd"], env=env,
                                         stdin=fds[0], stdout=fds[1], stderr=fds[2], start_new_session=True)
                    for f in fds:
                        os.close(f)
                    fds = []
                    rc = attached(p, conn)
                conn.sendall(json.dumps({"rc": rc}).encode())
                return
            why = "no ssh key configured; see `init`" if not cfg["ssh_keys"] else ssh_vet(req["argv"], cfg)
            if why:
                os.write(fds[2], f"ssh (sandbox): {why}\n".encode())
                rc = 255
            else:
                conf = rt / "ssh_config"
                text = (HOME / ".ssh/config").read_text() if cfg["ssh_config"] and (HOME / ".ssh/config").exists() else ""
                conf.write_text(re.sub(r"(?im)^\s*(IdentityFile|IdentityAgent|CertificateFile|PKCS11Provider|"
                                       r"SecurityKeyProvider|ControlPath|LocalCommand)\b.*$", "", text))
                ids = []
                for k in cfg["ssh_keys"]:                # -i KEY.pub selects that key in the agent
                    key = HOME / ".ssh" / k
                    pub = key.with_name(key.name + ".pub")
                    ids += ["-i", pub if pub.exists() else key]
                env = {**os.environ, "SSH_AUTH_SOCK": str(rt / "agent.sock"), "TERM": req.get("term") or "dumb"}
                p = subprocess.Popen(["/usr/bin/ssh", "-F", conf, "-o", f"IdentityAgent={rt / 'agent.sock'}",
                                      "-o", "IdentitiesOnly=yes", *ids, *req["argv"]],
                                     stdin=fds[0], stdout=fds[1], stderr=fds[2], env=env, cwd=HOME,
                                     start_new_session=True)  # own group: kill ProxyCommand children too
                for f in fds:
                    os.close(f)
                fds = []
                rc = attached(p, conn)
            conn.sendall(json.dumps({"rc": rc}).encode())
        except Exception as e:  # never take the broker down
            print(f"broker: {e!r}", file=sys.stderr, flush=True)
        finally:
            for f in fds:
                os.close(f)
            conn.close()

    while True:
        conn, _ = srv.accept()
        threading.Thread(target=handle, args=(conn,), daemon=True).start()


def attached(p, conn):
    """wait for p; if the shim goes away (killed), kill p's whole process group."""
    while p.poll() is None:
        if select.select([conn], [], [], 0.2)[0] and conn.recv(1) == b"":
            os.killpg(p.pid, signal.SIGTERM)
            p.wait()
    return p.returncode


def cmd_vet(cmd, argv, cwd, cfg, rt):
    """None if a brokered (non-ssh) command may run on the host, else why not."""
    allow = cfg["brokered"].get(cmd)
    if allow is None or not shutil.which(cmd):
        return "not brokered; see `silo config brokered`"
    try:
        roots = [Path(r) for r in json.loads((rt / "roots.json").read_text())]
    except (OSError, ValueError):
        roots = []
    c = Path(cwd).resolve()
    if not any(c == r or r in c.parents for r in roots):
        return f"working directory {cwd} is outside the sandbox's writable paths"
    if argv in ([], ["--help"], ["--version"]):
        return None
    words = [a for a in argv if not a.startswith("-")][:3]
    if any(words[:len(a.split())] == a.split() for a in allow):
        return None
    return f"'{cmd} {' '.join(words)}' is not in the allowlist ({', '.join(allow)})"


def gpg_binds(d):
    """private GNUPGHOME in the profile: public keys + ownertrust copied in, agent = host's
    restricted 'extra' socket (sign/decrypt only, pinentry on the host; secret keys never leave it)."""
    gh = d / "gnupg"
    gh.mkdir(mode=0o700, exist_ok=True)
    (gh / "common.conf").write_text("")                    # no keyboxd: plain pubring.kbx
    (gh / "gpg.conf").write_text("no-autostart\n")
    pub = subprocess.run(["gpg", "--export"], capture_output=True).stdout
    trust = subprocess.run(["gpg", "--export-ownertrust"], capture_output=True).stdout
    q = ["gpg", "--homedir", gh, "--batch", "--quiet"]
    subprocess.run(q + ["--import"], input=pub, capture_output=True)
    subprocess.run(q + ["--import-ownertrust"], input=trust, capture_output=True)
    extra = subprocess.run(["gpgconf", "--list-dirs", "agent-extra-socket"], capture_output=True, text=True).stdout.strip()
    inner = subprocess.run(["gpgconf", "--homedir", gh, "--list-dirs", "agent-socket"],
                           capture_output=True, text=True).stdout.strip()
    if not (extra and inner and Path(extra).exists()):
        err.print("[yellow]![/] gpg skipped: no running gpg-agent extra socket (gpgconf --launch gpg-agent)")
        return []
    return ["--bind", extra, inner, "--setenv", "GNUPGHOME", gh]


def stop_ssh(tool, name):
    rt = RUNTIME / "silo" / f"{tool.bin}-{name}"
    for f in ("broker.pid", "agent.pid"):
        try:
            os.kill(int((rt / f).read_text()), signal.SIGTERM)
        except (OSError, ValueError):
            pass
    shutil.rmtree(rt, ignore_errors=True)


def under(path, roots):
    path = Path(path)
    return any(path == r or r in path.parents for r in roots)


def sandbox(tool, name, login=None):
    """bwrap argv (without the command) for profile NAME of TOOL, logged in as LOGIN.  Home is an empty
    tmpfs: only the cwd, the profile, its login, `writable` (rw) and `readable`, PATH dirs, git config (ro) exist."""
    cfg = load_cfg()
    d = profile(tool, name)
    wd = Path.cwd().resolve()
    if wd == HOME or wd in HOME.parents:                  # home itself, /home, /
        die(f"run silo from a project directory: the working directory ({wd}) is mounted read-write")
    (d / "tmp").mkdir(exist_ok=True)
    rw = [wd, d, *(Path(p).expanduser().resolve() for p in cfg["writable"])]
    ro = [Path(p).expanduser() for p in cfg["readable"]]
    if cfg["path_dirs"]:
        ro += [Path(p) for p in os.environ.get("PATH", "").split(":")
               if p and Path(p).is_dir() and HOME in Path(p).parents]
    if cfg["git_config"]:
        ro += [HOME / ".gitconfig", HOME / ".config/git"]
    ro += [tool.home / f for f in tool.link]               # shared CLAUDE.md, AGENTS.md, skills
    exe = shutil.which(tool.bin)
    if exe and HOME in Path(exe).parents:                  # tool installed under home
        real = Path(os.path.realpath(exe))
        ro.append(real)
        if not under(exe, ro):
            ro.append((real, Path(exe)))

    b = ["bwrap", "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc",
         "--bind", d / "tmp", "/tmp",   # persistent per-profile /tmp: daemon sockets survive runs
         "--tmpfs", RUNTIME,            # hide host sockets: keyring ssh-agent, dbus, emacs, terminals
         "--unsetenv", "SSH_AUTH_SOCK", "--unsetenv", "DBUS_SESSION_BUS_ADDRESS",
         "--tmpfs", HOME]               # empty, scratch: everything below is mapped back explicitly
    for r in ro:
        src, dst = r if isinstance(r, tuple) else (r, r)
        if Path(src).exists() and not under(dst, rw):
            b += ["--ro-bind", src, dst]
    for r in rw:
        b += ["--bind-try", r, r]
    if tool.binds:
        b += tool.binds(d)

    # secrets inside anything mapped back: every tool's login files (all accounts) + `hidden`
    seen = rw + [r[1] if isinstance(r, tuple) else r for r in ro]
    for f in [*(x for t in TOOLS.values() for x in t.login), *(Path(h).expanduser() for h in cfg["hidden"]),
              HOME / ".ssh", ROOT / "config.json", LOGINS]:
        f = Path(f)
        if under(f, seen) and f.exists() and not under(d, [f]):
            b += ["--tmpfs", f] if f.is_dir() else ["--ro-bind", "/dev/null", f]
    b += attach(tool, name, d, login or login_of(tool, name))   # after the masks: only this login is visible

    rt = rtdir(tool, name)                                 # roots the broker accepts as cwd
    try:
        roots = set(json.loads((rt / "roots.json").read_text()))
    except (OSError, ValueError):
        roots = set()
    (rt / "roots.json").write_text(json.dumps(sorted(roots | {str(r) for r in rw})))
    shims = {c: shutil.which(c) for c in cfg["brokered"]}
    shims = {c: x for c, x in shims.items() if x}
    if cfg["ssh_keys"] and Path("/usr/bin/ssh").exists():
        shims["ssh"] = "/usr/bin/ssh"
    if shims:
        sock = str(ensure_broker(tool, name, cfg))
        for c, x in shims.items():
            ro_data(b, SHIM.format(sock=sock, cmd=c).encode(), Path(x), "0755")
    if cfg["gpg"] and shutil.which("gpgconf"):
        b += gpg_binds(d)

    b += ["--setenv", tool.env, d]
    for k, v in tool.setenv.items():
        b += ["--setenv", k, v]
    # keep pid + net namespaces: claude sessions check pid-namespace identity for peers
    b += ["--unshare-user", "--unshare-ipc", "--unshare-uts", "--unshare-cgroup-try",
          "--die-with-parent", "--chdir", wd]
    return [str(x) for x in b]


def create(tool, name, current, login=None):
    d = ROOT / tool.bin / name
    login = login or name
    if d.exists():
        die(f"{tool.bin} profile [bold]{name}[/] already exists")
    d.mkdir(parents=True, mode=0o700)
    for f in tool.copy:   # per-profile copies: the tool edits them
        if (tool.home / f).exists():
            shutil.copy(tool.home / f, d)
    for f in tool.link:   # shared with the tool's main config
        if (tool.home / f).exists():
            (d / f).symlink_to(tool.home / f)
    if login != name:
        set_login(tool, name, login)
    if current:
        for f in tool.login:   # the tool's state (project trust etc.) seeds the profile; credentials go to the login
            if f.name != tool.cred:
                shutil.copy2(f, d)
        import_login(tool, login)
        ok(f"created {tool.bin} profile [bold]{name}[/] with the current login as login [bold]{login}[/]")
    elif (LOGINS / tool.bin / login / tool.cred).exists():
        ok(f"created {tool.bin} profile [bold]{name}[/] using login [bold]{login}[/]")
    else:
        ok(f"created {tool.bin} profile [bold]{name}[/]  -  now run:  [cyan]{Path(sys.argv[0]).name} {name} {tool.login_cmd}[/]")


# ---- interactive prompts (prompt_toolkit when on a tty, plain input otherwise) ----
def ask(label, default="", paths=False, words=()):
    if sys.stdin.isatty():
        from prompt_toolkit import prompt
        from prompt_toolkit.completion import PathCompleter, WordCompleter
        from prompt_toolkit.key_binding import KeyBindings
        from prompt_toolkit.key_binding.bindings.completion import generate_completions
        comp = PathCompleter(expanduser=True) if paths else WordCompleter(list(words)) if words else None
        kb = KeyBindings()

        @kb.add("tab")
        def _(event):  # complete / cycle like readline; never insert a literal tab
            if comp:
                generate_completions(event)

        return prompt(f"{label} ", default=default, completer=comp, key_bindings=kb,
                      complete_while_typing=bool(words)).strip()
    out.print(f"{label} [dim]{default}[/]", end=" ")
    return (input() or default).strip()


# ---- updates (never silent: `ask` prints a hint, `always` installs, `never` skips) ----
def _vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v)[:3])


def fetch_remote(quiet=False):
    try:
        with urllib.request.urlopen(RAW_SELF_URL, timeout=5) as r:
            text = r.read().decode()
    except OSError as e:
        if quiet:
            raise
        die(f"could not fetch {RAW_SELF_URL}: {e}")
    m = re.search(r'^VERSION = "([^"]+)"', text, re.M)
    if not m or not text.startswith("#!/usr/bin/env python3"):
        die("fetched script has no VERSION marker; refusing to trust it")
    return m[1], text


def install_update(text, remote):
    me = Path(os.path.realpath(sys.argv[0]))
    if (me.parent / ".git").exists():
        die(f"{me} is a git checkout; update it with [cyan]git -C {me.parent} pull[/]")
    try:
        compile(text, "silo", "exec")
    except SyntaxError:
        die("downloaded script does not compile; not installed")
    tmp = me.with_name(me.name + ".new")
    tmp.write_text(text)
    tmp.chmod(me.stat().st_mode)
    tmp.replace(me)                    # atomic rename over the old version
    ok(f"updated v{VERSION} → v{remote}  ({me})")


def auto_check():
    """at most daily, after a command; network failures are silent."""
    mode = load_cfg()["check_updates"]
    stamp = STATE / "last-update-check"
    if mode == "never" or not sys.stderr.isatty():
        return
    try:
        if time.time() - stamp.stat().st_mtime < 86400:
            return
    except OSError:
        pass
    STATE.mkdir(parents=True, exist_ok=True)
    stamp.touch()
    try:
        remote, text = fetch_remote(quiet=True)
    except BaseException:
        return
    if _vtuple(remote) > _vtuple(VERSION):
        if mode == "always":
            install_update(text, remote)
        else:
            err.print(f"[yellow]↑[/] silo v{remote} is available (you have v{VERSION}) - run [cyan]silo update[/]")


def choose(label, choices, default):
    """ask until the answer is one of choices (Tab completes)."""
    while (v := ask(f"{label} ({' / '.join(choices)}):", default=default, words=choices)) not in choices:
        err.print(f"    [yellow]pick one of: {', '.join(choices)}[/]")
    return v


def number(label, default, lo, hi):
    while True:
        v = ask(label, default=str(default))
        if v.isdigit() and lo <= int(v) <= hi:
            return int(v)
        err.print(f"    [yellow]a number from {lo} to {hi}[/]")


def keep_list(current, keep_label):
    """show the list; one question keeps it all, 'n' goes item by item."""
    if not current:
        return []
    out.print("    " + ", ".join(f"[cyan]{c}[/]" for c in current))
    if click.confirm(f"  keep {'this' if len(current) == 1 else f'these {len(current)}'}?", default=True):
        return list(current)
    return [c for c in current if click.confirm(f"    {keep_label} {c}?", default=True)]


def path_list(intro, current, keep_label, add_label):
    out.print(intro)
    vals = keep_list(current, keep_label)
    while p := ask(f"  {add_label}", paths=True):
        if not Path(p).expanduser().exists():
            out.print(f"    [yellow]note:[/] {p} does not exist (skipped while it doesn't)")
        vals.append(p.replace(str(HOME), "~", 1) if p.startswith(str(HOME)) else p)
    return vals


@click.group(cls=Cli, context_settings=dict(help_option_names=["-h", "--help"]), invoke_without_command=True)
@click.option("-t", "--tool", type=click.Choice(list(TOOLS)), default=ALIASES.get(Path(sys.argv[0]).name, "claude"),
              show_default=True, help="which agent CLI")
@click.version_option(VERSION, "-V", "--version", prog_name="silo")
@click.pass_context
def cli(ctx, tool):

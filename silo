CHOICES = {key: list(s.choices) for key, s in SETTINGS.items() if s.choices}


class Config:
    """One schema for the file, CLI edits, onboarding and the launcher."""
    @staticmethod
    def check(key, value):
        s = SETTINGS[key]
        if type(value) is not type(s.default):
            raise ValueError(f"{key} must be {type(s.default).__name__}")
        if isinstance(value, list) and any(not isinstance(v, str) for v in value):
            raise ValueError(f"{key} must contain only text")
        if s.choices and value not in s.choices:
            raise ValueError(f"{key}: choose {', '.join(s.choices)}")
        if key == "nice" and not 0 <= value <= 19:
            raise ValueError("nice must be between 0 and 19")
        if key in ("memory_max", "swap_max") and value and not re.fullmatch(
                r"(?:[0-9]+(?:\.[0-9]+)?[KMGTPE]?|[0-9]+%|infinity)", value):
            raise ValueError(f"{key}: use a size like 4G, a percentage, infinity, or blank")
        if key == "profile_settings":
            for name, overrides in value.items():
                _tool_profile(name)
                Config.check_profile(overrides)
        if key in ("default_profiles", "default_logins"):
            for tool, name in value.items():
                if tool not in HARNESSES:
                    raise ValueError(f"unknown tool: {tool}")
                validate_name(name)
        if key == "logins":
            for name, login in value.items():
                _tool_profile(name)
                validate_name(login)
        if key == "brokered":
            for command, allow in value.items():
                if not isinstance(command, str) or not re.fullmatch(r"[a-zA-Z0-9_.-]+", command):
                    raise ValueError("brokered keys must be command names")
                if not isinstance(allow, list) or any(not isinstance(v, str) or not v.strip() for v in allow):
                    raise ValueError("each broker command needs a list of allowed subcommands")
        return copy.deepcopy(value)

    @staticmethod
    def check_profile(overrides):
        if not isinstance(overrides, dict):
            raise ValueError("profile settings must be an object")
        for key, value in overrides.items():
            if key not in SETTINGS or SETTINGS[key].scope != "profile":
                raise ValueError(f"{key} is not a per-profile setting")
            Config.check(key, value)

    @staticmethod
    def validate(raw):
        if not isinstance(raw, dict):
            raise ValueError("configuration must be a JSON object")
        for key in SETTINGS:
            if key in raw:
                Config.check(key, raw[key])
        return raw

    @staticmethod
    def parse(key, values):
        """CLI/launcher text -> a validated value."""
        if key not in SETTINGS:
            raise ValueError(f"unknown setting: {key}")
        default = SETTINGS[key].default
        if isinstance(default, dict):
            if len(values) != 1:
                raise ValueError(f"{key} takes one JSON object")
            try:
                value = json.loads(values[0])
            except ValueError:
                raise ValueError(f"{key} requires a valid JSON object") from None
        elif isinstance(default, list):
            value = [v.replace(str(HOME), "~", 1) if v.startswith(str(HOME)) else v for v in values]
        else:
            if len(values) != 1:
                raise ValueError(f"{key} takes one value")
            value = values[0]
            if isinstance(default, bool):
                if value.lower() not in ("true", "false", "yes", "no", "on", "off", "1", "0"):
                    raise ValueError(f"{key} is yes or no")
                value = value.lower() in ("true", "yes", "on", "1")
            elif isinstance(default, int):
                try:
                    value = int(value)
                except ValueError:
                    raise ValueError(f"{key} must be a number") from None
        return Config.check(key, value)

    @staticmethod
    def read():
        """the file as written (no defaults, no env), after version checks."""
        try:
            raw = json.loads(CONFIG.read_text())
        except FileNotFoundError:
            return {}
        except OSError as e:
            raise ValueError(f"Cannot read {CONFIG}: {e}") from e
        except ValueError as e:
            raise ValueError(f"{CONFIG} is not valid JSON: {e}") from e
        if not isinstance(raw, dict):
            raise ValueError(f"{CONFIG} must contain a JSON object")
        if _vtuple(need := raw.get("silo_min_version", "0")) > _vtuple(VERSION):
            raise ValueError(f"{CONFIG} needs silo >= {need} (you have {VERSION}); run silo update")
        have = raw.get("config_version", "0.0")
        if _vtuple(have)[:1] > _vtuple(CONFIG_VERSION)[:1]:
            raise ValueError(f"{CONFIG} is config v{have}; this silo reads v{CONFIG_VERSION}. Run silo update")
        if _vtuple(have) > _vtuple(CONFIG_VERSION):
            err.print(f"[yellow]![/] config v{have} is newer than this silo (v{CONFIG_VERSION}); unknown keys are ignored")
        if "ssh_key" in raw:                                   # config 1.0: a single key
            old = raw.pop("ssh_key")
            raw.setdefault("ssh_keys", [old] if old else [])
        return Config.validate(raw)

    @staticmethod
    def save(raw):
        """Validate and atomically save, preserving unknown fields; never persists env overrides."""
        Config.validate(raw)
        body = {**raw,
                "config_version": max((CONFIG_VERSION, raw.get("config_version", "0")), key=_vtuple),
                "silo_min_version": max((CONFIG_MIN_SILO, raw.get("silo_min_version", "0")), key=_vtuple)}
        ROOT.mkdir(parents=True, exist_ok=True)
        tmp = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", dir=ROOT, prefix=".config-", delete=False) as f:
                tmp = Path(f.name)
                json.dump(body, f, indent=2)
                f.write("\n")
            tmp.replace(CONFIG)
        finally:
            if tmp is not None:
                tmp.unlink(missing_ok=True)

    @staticmethod
    def update(fn):
        raw = Config.read()
        fn(raw)
        Config.save(raw)

    @staticmethod
    def effective(raw, h=None, name=None):
        cfg = {key: copy.deepcopy(raw.get(key, s.default)) for key, s in SETTINGS.items()}
        if h is not None and name is not None:
            cfg.update(copy.deepcopy(raw.get("profile_settings", {}).get(f"{h.name}/{name}", {})))
        return cfg

    @staticmethod
    def load(h=None, name=None):
        """effective settings for a run, with env overrides."""
        cfg = Config.effective(Config.read(), h, name)
        if env := os.environ.get("SILO_SSH_KEYS") or os.environ.get("SILO_SSH_KEY"):
            cfg["ssh_keys"] = env.replace(",", " ").split()
        return cfg

    @staticmethod
    def merge(current, base, draft, keys, where):
        """apply the keys changed between BASE and DRAFT onto CURRENT, refusing ones changed meanwhile."""
        for key in keys:
            if base.get(key) != draft.get(key) or (key in base) != (key in draft):
                if current.get(key) != base.get(key) or (key in current) != (key in base):
                    raise ValueError(f"{key} changed elsewhere; {where}")
                if key in draft:
                    current[key] = draft[key]
                else:
                    current.pop(key, None)
        return current

    @staticmethod
    def commit(base, draft):
        Config.save(Config.merge(Config.read(), base, draft, SETTINGS, "cancel and reopen Settings"))

    @staticmethod
    def commit_profile(h, name, base, draft):
        Profile(h, name).require()
        Config.check_profile(draft)
        key = f"{h.name}/{name}"

        def apply(raw):
            profiles = copy.deepcopy(raw.get("profile_settings", {}))
            current = Config.merge(profiles.get(key, {}), base, draft,
                                   [k for k in SETTINGS if SETTINGS[k].scope == "profile"],
                                   "reopen this profile's settings")
            profiles[key] = current
            raw["profile_settings"] = {k: v for k, v in profiles.items() if v}
        Config.update(apply)

    @staticmethod
    def defaults(h):
        cfg = Config.effective(Config.read())
        return cfg["default_profiles"].get(h.name, "main"), cfg["default_logins"].get(h.name, "main")

    @staticmethod
    def set_defaults(h, profile_name, login):
        validate_name(profile_name)
        validate_name(login)

        def apply(raw):
            raw["default_tool"] = h.name
            raw["default_profiles"] = {**raw.get("default_profiles", {}), h.name: profile_name}
            raw["default_logins"] = {**raw.get("default_logins", {}), h.name: login}
        Config.update(apply)


# ---- the store: profiles (histories) and logins (accounts) -------------------------------
class Login:
    def __init__(self, h, name):
        self.h, self.name = h, validate_name(name)
        self.path = LOGINS / h.name / name

    def __repr__(self):
        return f"Login({self.h.name}/{self.name})"

    def exists(self):
        return self.path.is_dir()

    def require(self):
        if not self.exists():
            raise ValueError(f"no {self.h.name} login {self.name}; add it first")
        return self

    def logged_in(self):
        return (self.path / self.h.cred).is_file()

    def account(self):
        return self.h.account(self.path)

    def users(self):
        """profiles that default to this login."""
        return sorted(k.split("/")[1] for k, v in Config.read().get("logins", {}).items()
                      if v == self.name and k.startswith(self.h.name + "/"))

    @staticmethod
    def all(h):
        return [Login(h, d.name) for d in sorted((LOGINS / h.name).glob("*/"))]


class Profile:
    def __init__(self, h, name):
        self.h, self.name = h, validate_name(name)
        self.path = ROOT / h.name / name
        self.key = f"{h.name}/{name}"

    def __repr__(self):
        return f"Profile({self.key})"

    def exists(self):
        return self.path.is_dir()

    def require(self):
        if not self.exists():
            raise ValueError(f"no {self.h.name} profile {self.name} (create it with new)")
        return self

    @property
    def login(self):
        """the login this profile runs with: its own choice (`login use`), else the tool's default."""
        return Login(self.h, Config.read().get("logins", {}).get(self.key) or Config.defaults(self.h)[1])

    def set_login(self, login):
        def apply(raw):
            raw["logins"] = {**raw.get("logins", {}), self.key: login.name}
        Config.update(apply)

    def runs(self):
        return [Run(self, Login(self.h, d.name)) for d in sorted((RUNS / self.h.name / self.name).glob("*/"))]

    def daemon_logins(self):
        return [r.login.name for r in self.runs() if self.h.daemon_alive(r.dir)]

    @staticmethod
    def all(h):
        return [Profile(h, d.name) for d in sorted((ROOT / h.name).glob("*/")) if not d.name.startswith(".")]


class Run:
    """what one profile+login keeps per run: /tmp (the background daemon), gpg home, broker sockets."""
    def __init__(self, profile, login):
        self.profile, self.login = profile, login
        self.dir = RUNS / profile.h.name / profile.name / login.name
        self.rt = RUNTIME / "silo" / f"{profile.h.name}-{quote(profile.name, safe='')}@{quote(login.name, safe='')}"

    def prepare(self):
        (self.dir / "tmp").mkdir(parents=True, exist_ok=True, mode=0o700)
        self.rt.mkdir(parents=True, exist_ok=True, mode=0o700)  # host-only; $XDG_RUNTIME_DIR is hidden from the sandbox
        return self

    def stop_brokers(self):
        for f in ("broker.pid", "agent.pid"):
            try:
                os.kill(int((self.rt / f).read_text()), signal.SIGTERM)
            except (OSError, ValueError):
                pass
        shutil.rmtree(self.rt, ignore_errors=True)


# ---- brokers: ssh, gh (and other allowlisted host commands), gpg ------------------------
# Inside the sandbox ~/.ssh is empty and /usr/bin/ssh is SHIM: it passes its argv and
# stdin/stdout/stderr (fds, so ttys work) to a host-side broker, which vets the args and
# runs the real ssh with a per-run ssh-agent holding only the chosen keys and (optionally)
# your ~/.ssh/config stripped of identity lines.  The agent can use ssh but read neither.
# Other brokered commands (gh, ...) go through the same socket against an allowlist.
SSH_ARG_OPTS = set("BbcDEeFIiJLlmOoPpQRSWw")       # ssh options taking a value
SSH_BLOCKED = set("FiIESGJOwv")                      # host-file access, config dump, jumps, debug
SAFE_O = {"batchmode", "connecttimeout", "serveraliveinterval", "serveralivecountmax",
          "stricthostkeychecking", "requesttty", "forwardagent", "forwardx11", "permitlocalcommand",
          "clearallforwardings", "remotecommand", "controlmaster", "sendenv", "compression",
          "loglevel", "port", "user", "exitonforwardfailure", "setenv"}
SAFE_O_VALUES = {"forwardagent": {"no"}, "forwardx11": {"no"}, "permitlocalcommand": {"no"},
                 "remotecommand": {"none"}, "controlmaster": {"no"}, "sendenv": {"git_protocol"}}
SHIM = """#!/usr/bin/python3 -I
import json, os, socket, sys
s = socket.socket(socket.AF_UNIX)
try:
    s.connect({sock!r})
except OSError as e:
    sys.exit(f"{cmd} (sandbox): broker unavailable: {{e}}")
req = {{"cmd": {cmd!r}, "argv": sys.argv[1:], "term": os.environ.get("TERM", ""), "cwd": os.getcwd()}}
socket.send_fds(s, [json.dumps(req).encode()], [0, 1, 2])
data = b""
while chunk := s.recv(4096):
    data += chunk
sys.exit(json.loads(data or b'{{"rc": 255}}')["rc"])
"""


def ssh_vet(argv, cfg):
    """None if ok, else the reason argv is refused."""
    dest, i = None, 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            dest = dest or (argv[i + 1] if i + 1 < len(argv) else None)
            break
        if a.startswith("-") and len(a) > 1:
            j = 1
            while j < len(a):
                c = a[j]
                if c in SSH_BLOCKED:
                    return f"option -{c} is not allowed in the sandbox"
                if c in SSH_ARG_OPTS:
                    val = a[j + 1:] or (argv[i + 1] if i + 1 < len(argv) else "")
                    if not a[j + 1:]:
                        i += 1
                    if c == "o":
                        k, _, v = val.replace(" ", "=", 1).partition("=")
                        k, v = k.strip().lower(), v.strip().lower()
                        if k not in SAFE_O or (k in SAFE_O_VALUES and v not in SAFE_O_VALUES[k]):
                            return f"-o {val} is not allowed in the sandbox"
                    if c in "LRD" and "/" in val:
                        return "unix-socket forwarding is not allowed in the sandbox"
                    break
                j += 1
        elif dest is None:
            dest = a
        else:
            break                               # rest is the remote command
        i += 1
    if not dest:
        return None                             # e.g. `ssh -V`; ssh prints usage itself
    host = re.sub(r"^ssh://", "", dest).rsplit("@", 1)[-1]
    host = re.sub(r":\d+$", "", host).strip("[]")
    allowed = cfg["ssh_hosts"]
    if allowed and not any(fnmatch.fnmatch(host, pat) for pat in allowed):
        return f"host '{host}' is not in the allowed list ({', '.join(allowed)}); see `init`"
    return None


def cmd_vet(cmd, argv, cwd, cfg, rt):
    """None if a brokered (non-ssh) command may run on the host, else why not."""
    allow = cfg["brokered"].get(cmd)
    if allow is None or not shutil.which(cmd):
        return "not brokered; see `silo config brokered`"
    roots = [Path(r) for r in json_file(rt / "roots.json") or []]
    if not under(Path(cwd).resolve(), roots):
        return f"working directory {cwd} is outside the sandbox's writable paths"
    if argv in ([], ["--help"], ["--version"]):
        return None
    words = [a for a in argv if not a.startswith("-")][:3]
    if any(words[:len(a.split())] == a.split() for a in allow):
        return None
    return f"'{cmd} {' '.join(words)}' is not in the allowlist ({', '.join(allow)})"


def attached(p, conn):
    """wait for p; if the shim goes away (killed), kill p's whole process group."""
    while p.poll() is None:
        if select.select([conn], [], [], 0.2)[0] and conn.recv(1) == b"":
            os.killpg(p.pid, signal.SIGTERM)
            p.wait()
    return p.returncode


class Broker:
    def __init__(self, run):
        self.run, self.rt = run, run.rt
        self.sock = run.dir / "ssh.sock"

    def ensure(self, cfg):
        """start the run's ssh-agent (if keys are set) + broker if needed; return the broker socket."""
        agent, state = self.rt / "agent.sock", self.rt / "agent.keys"
        keys = cfg["ssh_keys"]
        loaded = (json_file(state) or []) if alive(agent) else []
        if set(loaded) - set(keys):                            # a key was dropped: start a clean agent
            try:
                os.kill(int((self.rt / "agent.pid").read_text()), signal.SIGTERM)
            except (OSError, ValueError):
                pass
            loaded = []
            for _ in range(20):
                if not alive(agent):
                    break
                time.sleep(0.05)
        if keys and not alive(agent):
            agent.unlink(missing_ok=True)
            r = subprocess.run(["ssh-agent", "-s", "-a", agent], capture_output=True, text=True, check=True)
            (self.rt / "agent.pid").write_text(re.search(r"SSH_AGENT_PID=(\d+)", r.stdout)[1])
            loaded = []
        env = {**os.environ, "SSH_AUTH_SOCK": str(agent)}
        for k in keys:
            if k not in loaded:
                subprocess.run(["ssh-add", "-q", HOME / ".ssh" / k], env=env, check=True)
                loaded.append(k)
        state.write_text(json.dumps(loaded))
        if not alive(self.sock):
            self.sock.unlink(missing_ok=True)
            p = self.run.profile
            subprocess.Popen([sys.executable, os.path.realpath(sys.argv[0]), "-t", p.h.name, "_broker",
                              p.name, self.run.login.name],
                             start_new_session=True, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=open(self.rt / "broker.log", "a"))
            for _ in range(50):
                if alive(self.sock):
                    break
                time.sleep(0.05)
            else:
                raise ValueError(f"broker did not start; see {self.rt / 'broker.log'}")
        return self.sock

    def serve(self):
        self.sock.unlink(missing_ok=True)
        srv = socket.socket(socket.AF_UNIX)
        srv.bind(str(self.sock))
        os.chmod(self.sock, 0o600)
        srv.listen()
        (self.rt / "broker.pid").write_text(str(os.getpid()))
        while True:
            conn, _ = srv.accept()
            threading.Thread(target=self.handle, args=(conn,), daemon=True).start()

    def spawn(self, argv, req, fds, conn, **kw):
        p = subprocess.Popen(argv, stdin=fds[0], stdout=fds[1], stderr=fds[2],
                             start_new_session=True, **kw)   # own group: kill ProxyCommand children too
        for f in fds:
            os.close(f)
        fds.clear()
        return attached(p, conn)

    def handle(self, conn):
        fds = []
        try:
            msg, fds, _, _ = socket.recv_fds(conn, 1 << 20, 3)
            req = json.loads(msg)
            cfg = Config.load(self.run.profile.h, self.run.profile.name)
            cmd = req.get("cmd", "ssh")
            term = {"TERM": req.get("term") or "dumb"}
            if cmd != "ssh":
                why = cmd_vet(cmd, req["argv"], req.get("cwd", ""), cfg, self.rt)
                rc = 126 if why else self.spawn([shutil.which(cmd), *req["argv"]], req, fds, conn,
                                                cwd=req["cwd"], env={**os.environ, **term})
            else:
                why = "no ssh key configured; see `init`" if not cfg["ssh_keys"] else ssh_vet(req["argv"], cfg)
                rc = 255 if why else self.ssh(req, fds, conn, cfg, term)
            if why:
                os.write(fds[2], f"{cmd} (sandbox): {why}\n".encode())
            conn.sendall(json.dumps({"rc": rc}).encode())
        except Exception as e:  # never take the broker down
            print(f"broker: {e!r}", file=sys.stderr, flush=True)
        finally:
            for f in fds:
                os.close(f)
            conn.close()

    def ssh(self, req, fds, conn, cfg, term):
        conf = self.rt / "ssh_config"
        text = (HOME / ".ssh/config").read_text() if cfg["ssh_config"] and (HOME / ".ssh/config").exists() else ""
        conf.write_text(re.sub(r"(?im)^\s*(IdentityFile|IdentityAgent|CertificateFile|PKCS11Provider|"
                               r"SecurityKeyProvider|ControlPath|LocalCommand)\b.*$", "", text))
        ids = []
        for k in cfg["ssh_keys"]:                # -i KEY.pub selects that key in the agent
            key = HOME / ".ssh" / k
            pub = key.with_name(key.name + ".pub")
            ids += ["-i", pub if pub.exists() else key]
        agent = self.rt / "agent.sock"
        return self.spawn(["/usr/bin/ssh", "-F", conf, "-o", f"IdentityAgent={agent}", "-o", "IdentitiesOnly=yes",
                           *ids, *req["argv"]], req, fds, conn, cwd=HOME,
                          env={**os.environ, "SSH_AUTH_SOCK": str(agent), **term})


def gpg_binds(d):
    """private GNUPGHOME in the run dir: public keys + ownertrust copied in, agent = host's
    restricted 'extra' socket (sign/decrypt only, pinentry on the host; secret keys never leave it)."""
    gh = d / "gnupg"
    gh.mkdir(mode=0o700, exist_ok=True)
    (gh / "common.conf").write_text("")                    # no keyboxd: plain pubring.kbx
    (gh / "gpg.conf").write_text("no-autostart\n")
    pub = subprocess.run(["gpg", "--export"], capture_output=True).stdout
    trust = subprocess.run(["gpg", "--export-ownertrust"], capture_output=True).stdout
    q = ["gpg", "--homedir", gh, "--batch", "--quiet"]
    subprocess.run(q + ["--import"], input=pub, capture_output=True)
    subprocess.run(q + ["--import-ownertrust"], input=trust, capture_output=True)
    extra = subprocess.run(["gpgconf", "--list-dirs", "agent-extra-socket"], capture_output=True, text=True).stdout.strip()
    inner = subprocess.run(["gpgconf", "--homedir", gh, "--list-dirs", "agent-socket"],
                           capture_output=True, text=True).stdout.strip()
    if not (extra and inner and Path(extra).exists()):
        err.print("[yellow]![/] gpg skipped: no running gpg-agent extra socket (gpgconf --launch gpg-agent)")
        return []
    return ["--bind", extra, inner, "--setenv", "GNUPGHOME", gh]


def ro_data(args, data: bytes, dest: Path, perms="0600"):
    """Bind a generated file read-only at dest (via an inherited pipe fd)."""
    r, w = os.pipe()
    os.write(w, data)
    os.close(w)
    os.set_inheritable(r, True)
    args += ["--perms", perms, "--ro-bind-data", str(r), str(dest)]


# ---- sandbox ----------------------------------------------------------------------------
IONICE = {"idle": ["-c", "3"], "low": ["-c", "2", "-n", "7"], "normal": []}


def limits(cfg):
    """prefix argv: memory cap via a systemd user scope (covers every child, background agents
    included), then nice + ionice.  Missing pieces degrade with a warning, never block the run."""
    pre = []
    mem, swap = str(cfg["memory_max"]).strip(), str(cfg["swap_max"]).strip()
    if mem or swap:
        if shutil.which("systemd-run") and subprocess.run(
                ["systemd-run", "--user", "--scope", "--quiet", "true"], capture_output=True).returncode == 0:
            pre += ["systemd-run", "--user", "--scope", "--quiet", "--collect"]
            pre += ["-p", f"MemoryMax={mem}"] if mem else []
            pre += ["-p", f"MemorySwapMax={swap}"] if swap else []
        else:
            err.print("[yellow]![/] memory limit skipped: no systemd user session (systemd-run --user)")
    if int(cfg["nice"] or 0):
        pre += ["nice", "-n", str(int(cfg["nice"]))]
    if IONICE.get(cfg["ionice"]) and shutil.which("ionice"):
        pre += ["ionice", *IONICE[cfg["ionice"]]]
    return pre


class Sandbox:
    """bwrap argv (without the command) for one profile under one login.  Home is an empty tmpfs:
    only the cwd, the profile, its login, `writable` (rw) and `readable`, PATH dirs, git config (ro) exist."""
    def __init__(self, profile, login, cfg=None):
        self.profile, self.login, self.h = profile.require(), login.require(), profile.h
        self.cfg = cfg or Config.load(self.h, profile.name)
        self.run = Run(profile, login)

    def mounts(self, wd):
        cfg, h = self.cfg, self.h
        rw = [wd, self.run.dir, self.profile.path, *(Path(p).expanduser().resolve() for p in cfg["writable"])]
        ro = [Path(p).expanduser() for p in cfg["readable"]]
        if cfg["path_dirs"]:
            ro += [Path(p) for p in os.environ.get("PATH", "").split(":")
                   if p and Path(p).is_dir() and HOME in Path(p).parents]
        if cfg["git_config"]:
            ro += [HOME / ".gitconfig", HOME / ".config/git"]
        ro += [h.home / f for f in h.link]                     # shared CLAUDE.md, AGENTS.md, skills
        exe = shutil.which(h.bin)
        if exe and HOME in Path(exe).parents:                  # tool installed under home
            real = Path(os.path.realpath(exe))
            ro.append(real)
            if not under(exe, ro):
                ro.append((real, Path(exe)))
        return rw, ro

    def masks(self, seen):
        """secrets inside anything mapped back: every tool's login files (all accounts) + `hidden`."""
        b = []
        for f in [*(x for h in HARNESSES.values() for x in h.secrets), *(Path(p).expanduser() for p in self.cfg["hidden"]),
                  HOME / ".ssh", CONFIG, LOGINS]:
            f = Path(f)
            if under(f, seen) and f.exists() and not under(self.run.dir, [f]):
                b += ["--tmpfs", f] if f.is_dir() else ["--ro-bind", "/dev/null", f]
        return b

    def brokers(self, rw):
        b, cfg, rt = [], self.cfg, self.run.rt
        roots = set(json_file(rt / "roots.json") or [])           # roots the broker accepts as cwd
        (rt / "roots.json").write_text(json.dumps(sorted(roots | {str(r) for r in rw})))
        shims = {c: x for c in cfg["brokered"] if (x := shutil.which(c))}
        if cfg["ssh_keys"] and Path("/usr/bin/ssh").exists():
            shims["ssh"] = "/usr/bin/ssh"
        if shims:
            sock = str(Broker(self.run).ensure(cfg))
            for c, x in shims.items():
                ro_data(b, SHIM.format(sock=sock, cmd=c).encode(), Path(x), "0755")
        if cfg["gpg"] and shutil.which("gpgconf"):
            b += gpg_binds(self.run.dir)
        return b

    def argv(self, wd=None):
        wd = Path(wd or Path.cwd()).resolve()
        if wd == HOME or wd in HOME.parents:                  # home itself, /home, /
            raise ValueError(f"run silo from a project directory: the working directory ({wd}) is mounted read-write")
        self.run.prepare()
        rw, ro = self.mounts(wd)
        b = ["bwrap", "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc",
             "--bind", self.run.dir / "tmp", "/tmp",   # persistent per-run /tmp: daemon sockets survive runs
             "--tmpfs", RUNTIME,            # hide host sockets: keyring ssh-agent, dbus, emacs, terminals
             "--unsetenv", "SSH_AUTH_SOCK", "--unsetenv", "DBUS_SESSION_BUS_ADDRESS",
             "--tmpfs", HOME]               # empty, scratch: everything below is mapped back explicitly
        for r in ro:
            src, dst = r if isinstance(r, tuple) else (r, r)
            if Path(src).exists() and not under(dst, rw):
                b += ["--ro-bind", src, dst]
        for r in rw:
            b += ["--bind-try", r, r]
        b += self.h.sandbox_args(self.profile.path)
        b += self.masks(rw + [r[1] if isinstance(r, tuple) else r for r in ro])
        b += self.h.login_args(self.profile.path, self.login.path)   # after the masks: only this login is visible
        b += self.brokers(rw)
        b += ["--setenv", self.h.config_env, self.profile.path]
        for k, v in self.h.env.items():
            b += ["--setenv", k, v]
        # keep pid + net namespaces: claude sessions check pid-namespace identity for peers
        b += ["--unshare-user", "--unshare-ipc", "--unshare-uts", "--unshare-cgroup-try",
              "--die-with-parent", "--chdir", wd]
        return [str(x) for x in b]


# ---- ops: every operation, shared by the CLI and the launcher ----------------------------
class ops:
    @staticmethod
    def pick(h, profile_name=None, login_name=None):
        """explicit names, else the profile's own login, else the saved defaults."""
        p = Profile(h, profile_name or Config.defaults(h)[0])
        return p, Login(h, login_name) if login_name else p.login

    @staticmethod
    def argv(h, profile_name=None, login_name=None, args=()):
        p, login = ops.pick(h, profile_name, login_name)
        sandbox = Sandbox(p, login)
        cmd = [os.environ.get("SHELL", "/bin/sh")] if list(args) == ["--shell"] else [h.bin, *args]
        return limits(sandbox.cfg) + sandbox.argv() + cmd

    @staticmethod
    def run(h, profile_name=None, login_name=None, args=()):
        # close_fds=False: bwrap reads the shims from inherited pipe fds
        return subprocess.run(ops.argv(h, profile_name, login_name, args), close_fds=False).returncode

    @staticmethod
    def new(h, name, current=False, login_name=None):
        p = Profile(h, name)
        login = Login(h, login_name) if login_name else None
        if login and not current:
            login.require()
        if p.exists():
            raise ValueError(f"{h.name} profile {name} already exists")
        if current and not (h.native_login_home() / h.cred).is_file():
            raise ValueError(f"{h.name} is not logged in on this machine")
        p.path.mkdir(parents=True, mode=0o700)
        h.seed_profile(p.path, state=current)
        if login_name:
            p.set_login(login)
        if current:
            login = login or Login(h, Config.defaults(h)[1])
            h.import_login(login.path)
            return f"created {h.name} profile [bold]{name}[/] with the current login as login [bold]{login.name}[/]"
        return f"created {h.name} profile [bold]{name}[/]"

    @staticmethod
    def import_history(h, name, source=None):
        return h.import_history(source, Profile(h, name).require().path)

    @staticmethod
    def stop_daemons(p):
        if not p.h.stop_daemon_cmd:
            return
        for run in p.runs():
            if run.login.exists() and p.h.daemon_alive(run.dir):
                subprocess.run(Sandbox(p, run.login).argv(wd=run.dir) + [p.h.bin, *p.h.stop_daemon_cmd],
                               stdin=subprocess.DEVNULL, close_fds=False)

    @staticmethod
    def rm(h, name):
        p = Profile(h, name).require()
        ops.stop_daemons(p)
        for run in p.runs():
            run.stop_brokers()
        login = p.login.name
        shutil.rmtree(p.path)
        shutil.rmtree(RUNS / h.name / name, ignore_errors=True)

        def apply(raw):
            for key in ("logins", "profile_settings"):
                raw[key] = {k: v for k, v in raw.get(key, {}).items() if k != p.key}
        Config.update(apply)
        return f"removed {h.name} profile [bold]{name}[/]  (login [bold]{login}[/] kept; see [cyan]login ls[/])"

    @staticmethod
    def rename(h, name, new_name):
        p, target = Profile(h, name).require(), Profile(h, new_name)
        if target.exists():
            raise ValueError(f"profile {new_name} already exists")
        if p.daemon_logins():
            raise ValueError("Stop this profile's background daemon before renaming it")
        for run in p.runs():
            run.stop_brokers()
        p.path.rename(target.path)
        try:
            def apply(raw):
                for key in ("logins", "profile_settings"):
                    m = dict(raw.get(key, {}))
                    if p.key in m:
                        m[target.key] = m.pop(p.key)
                    raw[key] = m
                if raw.get("default_profiles", {}).get(h.name) == name:
                    raw["default_profiles"] = {**raw["default_profiles"], h.name: new_name}
            Config.update(apply)
        except BaseException:
            target.path.rename(p.path)
            raise
        shutil.rmtree(RUNS / h.name / name, ignore_errors=True)
        return f"renamed {h.name} profile {name} to {new_name}"

    @staticmethod
    def login_add(h, name, current=False):
        login = Login(h, name)
        if login.exists() and not current:
            raise ValueError(f"{h.name} login {name} already exists")
        if current:
            h.import_login(login.path)
        else:
            login.path.mkdir(parents=True, mode=0o700)
        return f"created {h.name} login {name}"

    @staticmethod
    def login_use(h, profile_name, login_name):
        p, login = Profile(h, profile_name).require(), Login(h, login_name).require()
        p.set_login(login)
        return f"{h.name} profile [bold]{profile_name}[/] now runs as login [bold]{login_name}[/]"

    @staticmethod
    def login_rename(h, name, new_name):
        """open sessions keep working: their sandbox binds the login dir itself, not its name."""
        login, target = Login(h, name).require(), Login(h, new_name)
        if target.exists():
            raise ValueError(f"{h.name} login {new_name} already exists")
        login.path.rename(target.path)
        try:
            def apply(raw):
                raw["logins"] = {k: new_name if v == name and k.startswith(h.name + "/") else v
                                 for k, v in raw.get("logins", {}).items()}
                if raw.get("default_logins", {}).get(h.name) == name:
                    raw["default_logins"] = {**raw["default_logins"], h.name: new_name}
            Config.update(apply)
        except BaseException:
            target.path.rename(login.path)
            raise
        for runs in (RUNS / h.name).glob(f"*/{name}"):       # per-run /tmp etc. follow the login
            if not (runs.parent / new_name).exists():
                runs.rename(runs.parent / new_name)
        cache = STATE / "usage" / f"{h.name}-{name}.json"
        if cache.exists():
            cache.rename(cache.with_name(f"{h.name}-{new_name}.json"))
        return f"renamed {h.name} login {name} to {new_name}"

    @staticmethod
    def login_rm(h, name):
        login = Login(h, name).require()
        if Config.defaults(h)[1] == name:
            raise ValueError("This is the default login; select another and save defaults first")
        if users := login.users():
            raise ValueError(f"profiles default to this login: {', '.join(users)}; select another login first")
        shutil.rmtree(login.path)
        return f"removed {h.name} login {name}"

    @staticmethod
    def authenticate(h, name):
        """Log in to an account in a throwaway profile, without touching any history."""
        login = Login(h, name).require()
        parent = ROOT / h.name
        parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".auth-", dir=parent) as tmp:
            p = Profile(h, Path(tmp).name)
            try:
                h.seed_profile(p.path)       # carries the finished first-run setup, so login skips the theme
                rc = subprocess.run(limits(Config.load()) + Sandbox(p, login, Config.load()).argv()
                                    + [h.bin, *h.login_cmd], close_fds=False).returncode
                h.after_login(p.path, login.path)
                return rc
            finally:
                for run in p.runs():
                    run.stop_brokers()
                shutil.rmtree(RUNS / h.name / p.name, ignore_errors=True)

    @staticmethod
    def usage(h, name, force=False):
        return fetch_usage(h, name, force)


# ---- usage snapshots: cached a minute, fetched in threads by status and the launcher ------
@dataclass(frozen=True)
class UsageSnapshot:
    rows: tuple = ()
    plan: str = ""
    email: str = ""
    at: float = 0
    error: str = ""
    loading: bool = False


USAGE_TTL = 300        # a login's usage is fetched at most every 5 minutes (r: every 30s)
PLAN_TTL = 6 * 3600    # plans rarely change


def usage_cache(h, name):
    """(snapshot, raw file).  Only usage metadata is cached, never authentication material."""
    raw = json_file(STATE / "usage" / f"{h.name}-{name}.json")
    try:
        rows = tuple(Window(str(label), float(percent), float(reset) if reset else None, float(length) if length else None)
                     for label, percent, reset, length in raw["rows"])
        at = float(raw["at"])
        if not all(math.isfinite(n) for r in rows for n in (r.percent, r.reset, r.length) if n is not None) \
                or not math.isfinite(at):
            return UsageSnapshot(), raw
        return UsageSnapshot(rows, str(raw.get("plan") or ""), str(raw.get("email") or ""), at), raw
    except (KeyError, TypeError, ValueError):
        return UsageSnapshot(), raw


def save_usage(h, name, raw):
    parent, tmp = STATE / "usage", None
    try:
        parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", dir=parent, prefix=".usage-", delete=False) as f:
            tmp = Path(f.name)
            json.dump(raw, f)
        tmp.replace(parent / f"{h.name}-{name}.json")
    except OSError:
        pass  # Cache failures must not hide successfully loaded usage.
    finally:
        if tmp:
            tmp.unlink(missing_ok=True)


def usage_error(error):
    """Do not display arbitrary exception text, which may contain request data."""
    text = str(error)
    if text in ("not logged in", "usage unsupported"):
        return text
    if "token expired" in text:
        return "token expired; authenticate again"
    if match := re.search(r"HTTP (\d{3})", text):
        return "HTTP " + match[1] + (" · rate limited" if match[1] == "429" else "")
    return "usage unavailable"


def fetch_usage(h, name, force=False):
    """cached usage unless it is old; never asks again before a rate limit's Retry-After."""
    login = Login(h, name)
    cached, raw = usage_cache(h, name)
    if not login.logged_in():
        return UsageSnapshot(error="not logged in")
    now = time.time()
    if now < raw.get("retry_at", 0):
        return replace(cached, error=f"rate limited · next try in {_until(raw['retry_at'])}")
    if cached.at and now - cached.at < (30 if force else USAGE_TTL):
        return cached
    try:
        rows = tuple(h.usage(login.path))
    except Exception as error:
        if "429" in str(error):
            wait = re.search(r"in (\d+)s", str(error))
            raw["retry_at"] = now + max(60, int(wait[1]) if wait else USAGE_TTL)
            save_usage(h, name, raw)
        return replace(cached, error=usage_error(error))
    plan, email, plan_at = cached.plan, cached.email, raw.get("plan_at", 0)
    if not plan or now - plan_at > PLAN_TTL:
        try:
            plan, plan_at = h.plan(login.path) or plan, now
        except Exception:
            pass
    email = login.account() or email
    save_usage(h, name, {"at": now, "rows": [list(vars(r).values()) for r in rows],
                         "plan": plan, "plan_at": plan_at, "email": email})
    return UsageSnapshot(rows, plan, email, now)


class AsyncUsage:
    """Daemon workers publish immutable snapshots; launch/exit never join them."""
    def __init__(self):
        self.lock = threading.Lock()
        self.snapshots, self.pending, self.requested = {}, set(), {}
        self.closed = threading.Event()
        self.slots = threading.Semaphore(4)

    def snapshot(self, h, name):
        with self.lock:
            return self.snapshots.get((h.name, name), UsageSnapshot(loading=True))

    def request(self, h, name, force=False):
        key = (h.name, name)
        with self.lock:
            if self.closed.is_set() or key in self.pending:
                return
            if not force and key in self.requested and time.time() - self.requested[key] < USAGE_TTL:
                return
            cached = self.snapshots.get(key) or usage_cache(h, name)[0]
            self.requested[key] = time.time()
            self.snapshots[key] = UsageSnapshot(cached.rows, cached.plan, cached.email, cached.at, cached.error, True)
            self.pending.add(key)

        def worker():
            try:
                with self.slots:
                    result = None if self.closed.is_set() else fetch_usage(h, name, force)
            except Exception:
                result = UsageSnapshot(cached.rows, cached.plan, cached.email, cached.at, "usage unavailable")
            with self.lock:
                if result and not self.closed.is_set():
                    self.snapshots[key] = result
                self.pending.discard(key)
        threading.Thread(target=worker, name=f"silo-usage-{h.name}-{name}", daemon=True).start()

    def close(self):
        self.closed.set()


def _until(ts):
    if not ts:
        return "[dim]-[/]"
    s = max(0, int(ts - time.time()))
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return f"{d}d {h}h" if d else f"{h}h {m:02d}m" if h else f"{m}m"


def _elapsed(reset, length):
    """fraction of the window gone, or None when the window is unknown."""
    if not (reset and length):
        return None
    return min(1.0, max(0.0, 1 - (reset - time.time()) / length))


def _bar(p, el, w=14):
    """a solid usage bar; ┃ marks how much of the window's time is gone."""
    n = round(min(p, 100) / 100 * w)
    c = "red" if p >= 90 else "yellow" if p >= 70 else "green"
    cells = [f"[{c}]━[/]"] * n + ["[grey35]─[/]"] * (w - n)
    if el is not None and el < 1:
        cells[min(w - 1, round(el * w))] = "[bold cyan]┃[/]"
    return "".join(cells) + f" [bold {c}]{p:3.0f}%[/]"


def _pace(p, el, reset, length):
    """how usage compares with the time gone, and when it runs out at this rate."""
    if el is None:
        return "[dim]-[/]"
    if p >= 100:
        return "[red]used up[/]"
    if reset and reset < time.time():
        return "[dim]window over[/]"
    if el < 0.02:
        return "[dim]new window[/]"
    d = p - el * 100
    tag = f"[red]fast +{d:.0f}%[/]" if d > 10 else f"[green]slow {d:.0f}%[/]" if d < -10 else "[cyan]on pace[/]"
    if p > 0:
        out_at = time.time() + (100 - p) * el * length / p     # at the average rate so far
        if out_at < reset:
            tag += f" [red]· out in {_until(out_at)}[/]"
    return tag


# ---- updates (never silent: `ask` prints a hint, `always` installs, `never` skips) ----
def fetch_remote(quiet=False):
    try:
        with urllib.request.urlopen(RAW_SELF_URL, timeout=5) as r:
            text = r.read().decode()
    except OSError as e:
        if quiet:
            raise
        die(f"could not fetch {RAW_SELF_URL}: {e}")
    m = re.search(r'^VERSION = "([^"]+)"', text, re.M)
    if not m or not text.startswith("#!/usr/bin/env python3"):
        die("fetched script has no VERSION marker; refusing to trust it")
    return m[1], text


def install_update(text, remote):
    me = Path(os.path.realpath(sys.argv[0]))
    if (me.parent / ".git").exists():
        die(f"{me} is a git checkout; update it with [cyan]git -C {me.parent} pull[/]")
    try:
        compile(text, "silo", "exec")
    except SyntaxError:
        die("downloaded script does not compile; not installed")
    tmp = me.with_name(me.name + ".new")
    tmp.write_text(text)
    tmp.chmod(me.stat().st_mode)
    tmp.replace(me)                    # atomic rename over the old version
    ok(f"updated v{VERSION} → v{remote}  ({me})")


def auto_check():
    """at most daily, after a command; network failures are silent."""
    mode = Config.load()["check_updates"]
    stamp = STATE / "last-update-check"
    if mode == "never" or not sys.stderr.isatty():
        return
    try:
        if time.time() - stamp.stat().st_mtime < 86400:
            return
    except OSError:
        pass
    STATE.mkdir(parents=True, exist_ok=True)
    stamp.touch()
    try:
        remote, text = fetch_remote(quiet=True)
    except BaseException:
        return
    if _vtuple(remote) > _vtuple(VERSION):
        if mode == "always":
            install_update(text, remote)
        else:
            err.print(f"[yellow]↑[/] silo v{remote} is available (you have v{VERSION}) - run [cyan]silo update[/]")


# ---- CLI: thin wrappers over ops ----------------------------------------------------------
def call(fn, *args, **kwargs):
    """CLI error formatting around ops."""
    try:
        return fn(*args, **kwargs)
    except (ValueError, OSError) as e:
        raise click.ClickException(str(e)) from e


def default_tool():
    if Path(sys.argv[0]).name == "silo-codex":
        return "codex"
    return call(Config.effective, call(Config.read))["default_tool"]



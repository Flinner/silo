@cli.command()
def init():
    """Onboarding: logins, filesystem, brokered ssh/gpg/gh, limits, updates."""
    cfg = {**DEFAULTS, **{k: v for k, v in read_cfg().items() if k in DEFAULTS}}   # file only, no env
    out.print(Panel(f"Answers are saved to [cyan]{CONFIG}[/].  Re-run any time - Enter keeps the current\n"
                    "value, Tab completes.  Change one setting later with [cyan]silo config KEY VALUE[/].",
                    title="silo init", border_style="cyan"))

    out.rule("[bold]1. Logins[/]")
    for tool in TOOLS.values():
        if not (tool.home / tool.cred).exists():
            out.print(f"  [dim]{tool.bin}: not logged in on this machine[/]")
            continue
        have = sorted(p.name for p in (LOGINS / tool.bin).glob("*/"))
        out.print(f"  [bold]{tool.bin}[/]: logged in as [green]{tool.current_email() or '?'}[/]"
                  + (f"   [dim](logins: {', '.join(have)})[/]" if have else ""))
        if click.confirm(f"  import this {tool.bin} login?", default=not have):
